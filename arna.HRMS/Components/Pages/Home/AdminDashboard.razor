    private async Task ProcessDashboardData()
    {
        if (_dashboard != null)
        {
            TotalEmployees = _dashboard.TotalEmployees;
            PresentEmployees = _dashboard.PresentEmployee;

            EmployeePresent = _dashboard.Attendance ?? new();
            EmployeeLeave = _dashboard.LeaveEmployees ?? new();
            onLeaveToday = EmployeeLeave.Count;

            allLeaveRequests = _dashboard.Requests ?? new();
            allAttendanceRequest = _dashboard.AttendanceRequests ?? new();
        }

        // 1. Fetch fresh leave requests from LeaveService to get all pending requests
        try
        {
            var leaveRes = await LeaveService.GetLeaveRequestsAsync();
            if (leaveRes?.IsSuccess == true && leaveRes.Data != null && leaveRes.Data.Any())
            {
                allLeaveRequests = leaveRes.Data;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[AdminDashboard] Leave requests error: {ex.Message}");
        }

        // 2. Fetch fresh attendance requests from AttendanceRequestService to get all pending requests
        try
        {
            var attRes = await AttendanceRequestService.GetAllAsync();
            if (attRes?.IsSuccess == true && attRes.Data != null && attRes.Data.Any())
            {
                allAttendanceRequest = attRes.Data;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[AdminDashboard] Attendance requests error: {ex.Message}");
        }

        pendingCount = DisplayLeaveRequests.Count;
        AttendancePendingCount = DisplayAttendanceRequests.Count;

        // 3. Fetch all raw attendances from AttendanceService for flexible date range filtering
        try
        {
            var attAllRes = await AttendanceService.GetAttendanceByEmployeeOrStatusAsync(null, null);
            if (attAllRes?.IsSuccess == true && attAllRes.Data != null && attAllRes.Data.Any())
            {
                allAttendances = attAllRes.Data;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[AdminDashboard] All attendance load error: {ex.Message}");
        }

        // Ensure Top 4 cards strictly reflect today's real attendance and leaves
        var today = DateTime.Today;

        // Strictly filter EmployeePresent for today only
        var todayPresents = EmployeePresent
            .Where(e => e.Date.Date == today)
            .ToList();

        if (!todayPresents.Any() && allAttendances.Any())
        {
            var empDict = _dashboard?.Employees?.ToDictionary(e => e.Id) ?? new();
            todayPresents = allAttendances
                .Where(a => a.Date.Date == today && (a.StatusId == AttendanceStatus.Present || a.ClockInTime.HasValue))
                .GroupBy(a => a.EmployeeId)
                .Select(g =>
                {
                    var p = g.First();
                    empDict.TryGetValue(p.EmployeeId, out var emp);
                    var workHrs = p.WorkingHours.HasValue && p.WorkingHours.Value != TimeSpan.Zero ? p.WorkingHours.Value : TimeSpan.FromHours(8);
                    return new EmployeeDailyAttendanceViewModel
                    {
                        EmployeeId = p.EmployeeId,
                        EmployeeNumber = emp?.EmployeeNumber ?? $"EMP{p.EmployeeId:D3}",
                        EmployeeName = emp != null ? $"{emp.FirstName} {emp.LastName}".Trim() : $"Employee {p.EmployeeId}",
                        Date = p.Date,
                        ClockIn = p.ClockInTime,
                        ClockOut = p.ClockOutTime,
                        WorkingHours = workHrs,
                        TotalHours = workHrs,
                        Status = "Present"
                    };
                }).ToList();
        }

        EmployeePresent = todayPresents;
        PresentEmployees = EmployeePresent.Count;

        // Employees not present today:
        var presentEmpIds = EmployeePresent.Select(p => p.EmployeeId).ToHashSet();

        var todayLeaves = EmployeeLeave
            .Where(l => l.Date.Date == today && !presentEmpIds.Contains(l.EmployeeId))
            .ToList();

        if (!todayLeaves.Any() && allAttendances.Any())
        {
            var empDict = _dashboard?.Employees?.ToDictionary(e => e.Id) ?? new();
            todayLeaves = allAttendances
                .Where(a => a.Date.Date == today && !presentEmpIds.Contains(a.EmployeeId) && (a.StatusId == AttendanceStatus.OnLeave || a.StatusId == AttendanceStatus.Leave))
                .GroupBy(a => a.EmployeeId)
                .Select(g =>
                {
                    var l = g.First();
                    empDict.TryGetValue(l.EmployeeId, out var emp);
                    return new EmployeeDailyAttendanceViewModel
                    {
                        EmployeeId = l.EmployeeId,
                        EmployeeNumber = emp?.EmployeeNumber ?? $"EMP{l.EmployeeId:D3}",
                        EmployeeName = emp != null ? $"{emp.FirstName} {emp.LastName}".Trim() : $"Employee {l.EmployeeId}",
                        Date = l.Date,
                        ClockIn = null,
                        ClockOut = null,
                        WorkingHours = TimeSpan.Zero,
                        TotalHours = TimeSpan.Zero,
                        Status = "On Leave",
                        Note = string.IsNullOrWhiteSpace(l.Notes) ? "Approved Leave" : l.Notes
                    };
                }).ToList();
        }

        var leaveEmpIds = todayLeaves.Select(l => l.EmployeeId).ToHashSet();

        if (_dashboard?.Employees != null && _dashboard.Employees.Any())
        {
            foreach (var emp in _dashboard.Employees)
            {
                if (!presentEmpIds.Contains(emp.Id) && !leaveEmpIds.Contains(emp.Id))
                {
                    leaveEmpIds.Add(emp.Id);
                    todayLeaves.Add(new EmployeeDailyAttendanceViewModel
                    {
                        EmployeeId = emp.Id,
                        EmployeeNumber = !string.IsNullOrWhiteSpace(emp.EmployeeNumber) ? emp.EmployeeNumber : $"EMP{emp.Id:D3}",
                        EmployeeName = $"{emp.FirstName} {emp.LastName}".Trim(),
                        Date = today,
                        ClockIn = null,
                        ClockOut = null,
                        WorkingHours = TimeSpan.Zero,
                        TotalHours = TimeSpan.Zero,
                        Status = "Absent",
                        Note = "Not Clocked In"
                    });
                }
            }
        }

        // Fallback load employees if _dashboard?.Employees is empty
        if (_dashboard?.Employees == null || !_dashboard.Employees.Any())
        {
            try
            {
                var empRes = await EmployeeService.GetEmployeesAsync();
                if (empRes?.IsSuccess == true && empRes.Data != null)
                {
                    if (_dashboard == null) _dashboard = new DashboardViewModel();
                    _dashboard.Employees = empRes.Data;
                    TotalEmployees = _dashboard.Employees.Count;
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[AdminDashboard] Employee load error: {ex.Message}");
            }
        }

        EmployeeLeave = todayLeaves;
        onLeaveToday = EmployeeLeave.Count;

        await RebuildAttendanceChart();
        BuildDepartmentSummaries();
        await BuildAttendanceTrajectory();
    }

    private async Task RebuildAttendanceChart()
    {
        chartDataPoints.Clear();
        var spanDays = (selectedEndDate.Date - selectedStartDate.Date).Days + 1;
        if (spanDays <= 0) spanDays = 1;

        var dates = Enumerable.Range(0, spanDays)
            .Select(offset => selectedStartDate.Date.AddDays(offset))
            .ToList();

        var isSingleEmployee = selectedEmployeeId > 0;

        foreach (var dt in dates)
        {
            var point = new AttendanceChartDataPoint
            {
                Date = dt,
                FullDateLabel = dt.ToString("dddd, MMM dd, yyyy"),
                DayLabel = spanDays <= 7
                    ? dt.ToString("ddd dd")
                    : (spanDays <= 31 ? dt.ToString("dd") : dt.ToString("MMM dd")),
                IsWeekend = dt.DayOfWeek == DayOfWeek.Saturday || dt.DayOfWeek == DayOfWeek.Sunday
            };

            if (isSingleEmployee)
            {
                var records = allAttendances
                    .Where(a => a.EmployeeId == selectedEmployeeId && a.Date.Date == dt)
                    .ToList();

                var isLeave = records.Any(r => r.StatusId == AttendanceStatus.OnLeave || r.StatusId == AttendanceStatus.Leave);
                if (!isLeave && allLeaveRequests.Any())
                {
                    isLeave = allLeaveRequests.Any(l => l.EmployeeId == selectedEmployeeId &&
                                                        l.StatusId == Status.Approved &&
                                                        l.StartDate.Date <= dt && l.EndDate.Date >= dt);
                }

                point.IsLeave = isLeave;

                if (records.Any(r => r.ClockInTime.HasValue || r.WorkingHours.HasValue || r.StatusId == AttendanceStatus.Present))
                {
                    var (workSec, breakSec) = CalculateDayWorkAndBreak(records, dt);
                    point.WorkingHours = Math.Round(workSec / 3600.0, 2);
                    point.BreakHours = Math.Round(breakSec / 3600.0, 2);
                    point.ActiveEmployeesCount = 1;
                    point.StatusText = point.WorkingHours >= 7.5 ? "Present" : "Half Day / Partial";
                }
                else if (isLeave)
                {
                    point.StatusText = "On Leave";
                }
                else if (point.IsWeekend)
                {
                    point.StatusText = "Weekend";
                }
                else if (dt > DateTime.Today)
                {
                    point.StatusText = "Upcoming";
                }
                else
                {
                    point.IsAbsent = true;
                    point.StatusText = "Absent";
                }
            }
            else
            {
                var dayRecords = allAttendances
                    .Where(a => a.Date.Date == dt)
                    .ToList();

                var empGroups = dayRecords
                    .GroupBy(a => a.EmployeeId)
                    .ToList();

                var clockedInEmps = 0;
                double totalWorkSec = 0;
                double totalBreakSec = 0;

                foreach (var g in empGroups)
                {
                    var empRecs = g.ToList();
                    if (empRecs.Any(r => r.ClockInTime.HasValue || r.WorkingHours.HasValue || r.StatusId == AttendanceStatus.Present))
                    {
                        var (workSec, breakSec) = CalculateDayWorkAndBreak(empRecs, dt);
                        if (workSec > 0 || breakSec > 0 || empRecs.Any(r => r.ClockInTime.HasValue))
                        {
                            clockedInEmps++;
                            totalWorkSec += workSec;
                            totalBreakSec += breakSec;
                        }
                    }
                }

                point.ActiveEmployeesCount = clockedInEmps;

                if (clockedInEmps > 0)
                {
                    if (chartHoursMode == "avg")
                    {
                        point.WorkingHours = Math.Round((totalWorkSec / clockedInEmps) / 3600.0, 2);
                        point.BreakHours = Math.Round((totalBreakSec / clockedInEmps) / 3600.0, 2);
                        point.StatusText = $"{clockedInEmps} Present (Avg)";
                    }
                    else
                    {
                        point.WorkingHours = Math.Round(totalWorkSec / 3600.0, 2);
                        point.BreakHours = Math.Round(totalBreakSec / 3600.0, 2);
                        point.StatusText = $"{clockedInEmps} Present (Total)";
                    }
                }
                else
                {
                    point.StatusText = point.IsWeekend ? "Weekend" : (dt > DateTime.Today ? "Upcoming" : "No Attendance");
                }
            }

            chartDataPoints.Add(point);
        }

        var highestVal = chartDataPoints.Any()
            ? chartDataPoints.Max(p => Math.Max(p.WorkingHours, p.BreakHours))
            : 0;

        if (highestVal <= 0) highestVal = 8.0;
        if (highestVal <= 4) chartYMax = 4;
        else if (highestVal <= 8) chartYMax = 10;
        else if (highestVal <= 12) chartYMax = 14;
        else if (highestVal <= 16) chartYMax = 18;
        else if (highestVal <= 24) chartYMax = 24;
        else chartYMax = Math.Ceiling(highestVal * 1.15 / 5.0) * 5.0;

        // Auto-select Focus View when range is wide (> 7 days) and only a few recorded days exist (<= 7 days)
        var activeCount = chartDataPoints.Count(p => p.WorkingHours > 0 || p.BreakHours > 0 || p.IsLeave);
        if (chartDataPoints.Count > 7 && activeCount > 0 && activeCount <= 7)
        {
            chartViewFilter = "focus";
        }
        else if (chartDataPoints.Count <= 7)
        {
            chartViewFilter = "all";
        }

        StateHasChanged();
        await Task.CompletedTask;
    }

    private static (double workSec, double breakSec) CalculateDayWorkAndBreak(List<AttendanceViewModel> records, DateTime date)
    {
        var clockIns = records
            .Where(r => r.ClockInTime.HasValue)
            .Select(r => date.Date + r.ClockInTime!.Value)
            .OrderBy(x => x)
            .ToList();

        var clockOuts = records
            .Where(r => r.ClockOutTime.HasValue)
            .Select(r => date.Date + r.ClockOutTime!.Value)
            .OrderBy(x => x)
            .ToList();

        // 1. Working Seconds
        double workSec = records
            .Where(r => r.WorkingHours.HasValue)
            .Sum(r => r.WorkingHours!.Value.TotalSeconds);

        if (workSec <= 0 && clockIns.Any() && clockOuts.Any())
        {
            workSec = Math.Max(0, (clockOuts.Last() - clockIns.First()).TotalSeconds);
        }
        else if (workSec <= 0 && clockIns.Any() && !clockOuts.Any() && date.Date == DateTime.Today)
        {
            workSec = Math.Max(0, (DateTime.Now - clockIns.First()).TotalSeconds);
        }

        // 2. Break Seconds from session gaps
        double sessionBreakSec = clockOuts
            .Zip(clockIns.Skip(1), (sessionEnd, nextStart) => nextStart > sessionEnd ? (nextStart - sessionEnd).TotalSeconds : 0)
            .Sum();

        // 3. Span difference (e.g. 9h span, 8h work -> 1h break)
        double totalSpanSec = (clockIns.Any() && clockOuts.Any())
            ? Math.Max(0, (clockOuts.Last() - clockIns.First()).TotalSeconds)
            : 0;

        double spanBreakSec = Math.Max(0, totalSpanSec - workSec);
        double breakSec = Math.Max(sessionBreakSec, spanBreakSec);

        return (workSec, breakSec);
    }

    private async Task ApproveLeave(LeaveRequestViewModel req)
    {
        if (!await JsRuntime.InvokeAsync<bool>("confirm", $"Approve leave for {req.EmployeeName}?"))
            return;

        var empId = GetEmployeeId() > 0 ? GetEmployeeId() : (GetUserId() > 0 ? GetUserId() : 1);

        if (req.Id > 0)
        {
            var res = await LeaveService.UpdateLeaveStatusAsync(req.Id, Status.Approved, empId);
            if (res?.IsSuccess == true)
            {
                await NotificationService.Success("Leave approved successfully.");
                req.StatusId = Status.Approved;
                pendingLeaveRequests.Remove(req);
                pendingCount = DisplayLeaveRequests.Count;
                await RebuildAttendanceChart();
                BuildDepartmentSummaries();
                await BuildAttendanceTrajectory();
                StateHasChanged();
            }
            else
            {
                await NotificationService.Error(res?.Message ?? "Failed to approve leave.");
            }
        }
    }

