@using arna.HRMS.Components.lib.components.ui.CommonComponent
@using arna.HRMS.Components.lib.components.ui.Forms
@using arna.HRMS.Models.Common.Table
@using arna.HRMS.Models.ViewModels
@using arna.HRMS.Models.Enums
@using arna.HRMS.Models.ViewModels.Attendance
@using arna.HRMS.Models.ViewModels.Leave
@using arna.HRMS.Services
@using arna.HRMS.Services.Auth
@using arna.HRMS.Services.Dashboard
@using arna.HRMS.Services.Common

@inject NavigationManager Nav
@inject ILeaveService LeaveService
@inject IAttendanceRequestService AttendanceRequestService
@inject IDashboardService DashboardService
@inject IAttendanceService AttendanceService
@inject IEmployeeService EmployeeService
@inject NotificationService NotificationService
@inject IJSRuntime JsRuntime
@inherits AuthenticatedLayoutBase 

<div class="container-fluid p-0 dash-fade-in">

    <!-- ══════════ 1. DASHBOARD GREETING & EXECUTIVE ACTION BAR ══════════ -->
    <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3 mb-4">
        <div>
            <h3 class="dash-greeting-title mb-1">
                @greeting, @DisplayAdminName
            </h3>
            <p class="dash-greeting-subtitle mb-0">
                Here's an overview of your organization's HR activities and workforce attendance.
            </p>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <div class="d-inline-flex align-items-center gap-2 px-3 py-1.5 bg-white border rounded-3 shadow-xs text-muted small fw-medium">
                <i class="bi bi-calendar3 text-primary"></i>
                <span>@TodayDisplayDate</span>
            </div>
            <button type="button" class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1.5 px-3 py-1.5 rounded-3 shadow-xs fw-medium"
                    @onclick="RefreshDashboard" disabled="@isRefreshing" title="Refresh dashboard data">
                <i class="bi bi-arrow-clockwise @(isRefreshing ? "spin-animation" : "")"></i>
                <span>@(isRefreshing ? "Refreshing..." : "Refresh")</span>
            </button>
        </div>
    </div>

    <!-- ══════════ 2. TOP 4 KPI METRIC CARDS (TODAY'S WORKFORCE PULSE) ══════════ -->
    <div class="row g-3 g-xl-4 mb-4">

        <AppStatCard Icon="bi-people-fill"
                     BgClass="bg-primary bg-opacity-10"
                     TextClass="text-primary"
                     Label="Present Today"
                     Count="@PresentEmployees"
                     Subtext="@($"out of {TotalEmployees} total staff")"
                     TrendText="@(TotalEmployees > 0 && PresentEmployees > 0 ? $"{Math.Round((double)PresentEmployees / TotalEmployees * 100)}% active" : (TotalEmployees > 0 ? "0% active" : ""))"
                     TrendClass="trend-green"
                     OnClick="() => showPresentModal = true"
                     CardClass="cursor-pointer" />

        <AppStatCard Icon="bi-calendar-check-fill"
                     BgClass="bg-success bg-opacity-10"
                     TextClass="text-success"
                     Label="On Leave Today"
                     Count="@onLeaveToday" 
                     Subtext="Approved or scheduled leaves"
                     TrendText="@(onLeaveToday > 0 ? $"{onLeaveToday} absent" : "No leaves")"
                     TrendClass="@(onLeaveToday > 0 ? "trend-amber" : "trend-green")"
                     OnClick="() => showLeaveModal = true"
                     CardClass="cursor-pointer" />

        <AppStatCard Icon="bi-hourglass-split"
                     BgClass="bg-warning bg-opacity-25"
                     TextClass="text-warning"
                     Label="Leave Pending Requests"
                     Count="@pendingCount"
                     Subtext="@(pendingCount > 0 ? "Requires admin review" : "All requests reviewed")"
                     TrendText="@(pendingCount > 0 ? $"{pendingCount} awaiting" : "All clear")"
                     TrendClass="@(pendingCount > 0 ? "trend-amber" : "trend-green")" />

        <AppStatCard Icon="bi-clock-history"
                     BgClass="bg-info bg-opacity-25"
                     TextClass="text-info"
                     Label="Attendance Pending Requests"
                     Count="@AttendancePendingCount"
                     Subtext="@(AttendancePendingCount > 0 ? "Punch regularization" : "No pending punch requests")"
                     TrendText="@(AttendancePendingCount > 0 ? $"{AttendancePendingCount} awaiting" : "All clear")"
                     TrendClass="@(AttendancePendingCount > 0 ? "trend-amber" : "trend-green")" />

    </div>

    <!-- ══════════ 3. EXECUTIVE ATTENDANCE PULSE & SILK WAVE TRAJECTORY ══════════ -->
    <div class="row g-3 g-xl-4 mb-4">

        <!-- 3A. Today's Workforce Health (Executive Donut Gauge & Department Breakdown) -->
        <div class="col-12 col-xl-5">
            <div class="dash-card h-100 d-flex flex-column">
                
                <!-- Card Header -->
                <div class="dash-card-header">
                    <div class="d-flex align-items-center gap-2.5">
                        <div class="dash-card-icon-box" style="background: rgba(16, 185, 129, 0.12); color: #10b981;">
                            <i class="bi bi-shield-check"></i>
                        </div>
                        <div>
                            <h6 class="dash-card-title mb-0 d-flex align-items-center gap-2">
                                <span>Today's Workforce Health</span>
                            </h6>
                            <p class="dash-card-subtitle mt-0.5">
                                Real-time presence across @TodayTotalStaff employees
                            </p>
                        </div>
                    </div>

                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1 small d-inline-flex align-items-center gap-1.5" style="font-size: 0.72rem;">
                        <span class="dash-pulse-dot"></span>
                        Live Status
                    </span>
                </div>

                <!-- Card Body -->
                <div class="card-body p-3 p-md-4 flex-grow-1 d-flex flex-column justify-content-between">
                    
                    <!-- Gauge + Metrics Row -->
                    <div class="d-flex align-items-center justify-content-around py-2 gap-3 flex-wrap">
                        
                        <!-- Donut Gauge -->
                        <div class="dash-gauge-container" title="Today's Attendance Rate: @TodayAttendanceRate%">
                            <svg class="dash-gauge-svg" viewBox="0 0 140 140">
                                <defs>
                                    <linearGradient id="dashEmeraldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                                        <stop offset="0%" stop-color="#10b981" />
                                        <stop offset="100%" stop-color="#059669" />
                                    </linearGradient>
                                </defs>
                                <circle class="dash-gauge-bg" cx="70" cy="70" r="54"></circle>
                                <circle class="dash-gauge-val" cx="70" cy="70" r="54"
                                        stroke="url(#dashEmeraldGrad)"
                                        stroke-dasharray="339.29"
                                        stroke-dashoffset="@GaugeDashOffset"></circle>
                            </svg>
                            <div class="position-absolute text-center" style="pointer-events: none;">
                                <div class="fw-bold text-dark mb-0" style="font-size: 1.85rem; line-height: 1; letter-spacing: -0.03em;">
                                    @TodayAttendanceRate%
                                </div>
                                <small class="text-muted text-uppercase fw-semibold" style="font-size: 0.65rem; letter-spacing: 0.05em;">
                                    Present
                                </small>
                            </div>
                        </div>

                        <!-- Micro Metrics Legend -->
                        <div class="d-flex flex-column gap-2 flex-grow-1" style="min-width: 170px;">
                            <div class="d-flex align-items-center justify-content-between p-2 rounded-3 bg-light border cursor-pointer"
                                 @onclick="() => showPresentModal = true" title="Click to view clocked-in employees">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="d-inline-block rounded-circle" style="width: 10px; height: 10px; background-color: #10b981;"></span>
                                    <span class="small fw-semibold text-dark">Present</span>
                                </div>
                                <div class="text-end">
                                    <span class="fw-bold text-success small">@PresentEmployees</span>
                                    <span class="text-muted small ms-1" style="font-size: 0.72rem;">(@TodayAttendanceRate%)</span>
                                </div>
                            </div>

                            <div class="d-flex align-items-center justify-content-between p-2 rounded-3 bg-light border cursor-pointer"
                                 @onclick="() => showLeaveModal = true" title="Click to view employees on leave">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="d-inline-block rounded-circle" style="width: 10px; height: 10px; background-color: #f59e0b;"></span>
                                    <span class="small fw-semibold text-dark">On Leave</span>
                                </div>
                                <div class="text-end">
                                    <span class="fw-bold text-warning small">@onLeaveToday</span>
                                    <span class="text-muted small ms-1" style="font-size: 0.72rem;">(@TodayLeaveRate%)</span>
                                </div>
                            </div>

                            <div class="d-flex align-items-center justify-content-between p-2 rounded-3 bg-light border">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="d-inline-block rounded-circle" style="width: 10px; height: 10px; background-color: #ef4444;"></span>
                                    <span class="small fw-semibold text-dark">Not Clocked In</span>
                                </div>
                                <div class="text-end">
                                    <span class="fw-bold text-danger small">@TodayAbsentEmployees</span>
                                    <span class="text-muted small ms-1" style="font-size: 0.72rem;">(@TodayAbsentRate%)</span>
                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- Department Attendance Breakdown -->
                    <div class="pt-3 border-top mt-2">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted small fw-bold text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.05em;">
                                Attendance By Department
                            </span>
                            <span class="text-muted small" style="font-size: 0.7rem;">
                                @departmentSummaries.Count Departments
                            </span>
                        </div>

                        <div class="d-flex flex-column gap-2.5">
                            @if (departmentSummaries.Any())
                            {
                                @foreach (var dept in departmentSummaries)
                                {
                                    <div>
                                        <div class="d-flex justify-content-between small fw-medium mb-1">
                                            <span class="text-dark">@dept.DepartmentName</span>
                                            <span class="fw-semibold @(dept.AttendanceRate >= 90 ? "text-success" : (dept.AttendanceRate >= 75 ? "text-primary" : "text-warning"))">
                                                @dept.AttendanceRate% (@dept.PresentCount/@dept.TotalStaff)
                                            </span>
                                        </div>
                                        <div class="dash-dept-prog-track">
                                            <div class="dash-dept-prog-bar @dept.ProgressColorClass" style="width: @dept.AttendanceRate%;"></div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="text-muted small text-center py-2">
                                    No departmental data recorded yet.
                                </div>
                            }
                        </div>
                    </div>

                </div>

            </div>
        </div>

        <!-- 3B. 30-Day Workforce Attendance Trajectory (Silk Wave Curve) -->
        <div class="col-12 col-xl-7">
            <div class="dash-card h-100 d-flex flex-column">

                <!-- Card Header -->
                <div class="dash-card-header flex-wrap gap-3">
                    <div class="d-flex align-items-center gap-2.5">
                        <div class="dash-card-icon-box" style="background: rgba(37, 99, 235, 0.12); color: #2563eb;">
                            <i class="bi bi-graph-up-arrow"></i>
                        </div>
                        <div>
                            <h6 class="dash-card-title mb-0 d-flex align-items-center gap-2">
                                <span>Attendance Trajectory</span>
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill small fw-normal" style="font-size: 0.72rem;">
                                    Silk Wave
                                </span>
                            </h6>
                            <p class="dash-card-subtitle mt-0.5">
                                Punctuality & consistency trajectory across workdays
                            </p>
                        </div>
                    </div>

                    <!-- Range Selector Pills -->
                    <div class="btn-group btn-group-sm" role="group">
                        <button type="button" class="btn @(selectedTrajectoryRange == "this_month" ? "btn-primary shadow-xs" : "btn-light border")"
                                @onclick='() => SetTrajectoryRange("this_month")'>
                            This Month
                        </button>
                        <button type="button" class="btn @(selectedTrajectoryRange == "last_30_days" ? "btn-primary shadow-xs" : "btn-light border")"
                                @onclick='() => SetTrajectoryRange("last_30_days")'>
                            Last 30 Days
                        </button>
                        <button type="button" class="btn @(selectedTrajectoryRange == "last_14_days" ? "btn-primary shadow-xs" : "btn-light border")"
                                @onclick='() => SetTrajectoryRange("last_14_days")'>
                            Last 14 Days
                        </button>
                    </div>
                </div>

                <!-- Card Body -->
                <div class="card-body p-3 p-md-4 flex-grow-1 d-flex flex-column justify-content-between">
                    
                    <!-- Top Summary Metric Tiles -->
                    <div class="row g-2 mb-3">
                        <div class="col-4">
                            <div class="p-2.5 bg-light rounded-3 text-center border">
                                <span class="text-muted d-block small" style="font-size: 0.72rem;">Period Avg Rate</span>
                                <span class="fw-bold text-success fs-5">@TrajectoryAvgAttendanceRate%</span>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-2.5 bg-light rounded-3 text-center border">
                                <span class="text-muted d-block small" style="font-size: 0.72rem;">Peak Day</span>
                                <span class="fw-bold text-primary fs-5">@TrajectoryPeakPercent% (@TrajectoryPeakDay)</span>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-2.5 bg-light rounded-3 text-center border">
                                <span class="text-muted d-block small" style="font-size: 0.72rem;">Approved Leaves</span>
                                <span class="fw-bold text-warning fs-5">@TrajectoryTotalApprovedLeaves Days</span>
                            </div>
                        </div>
                    </div>

                    <!-- Silk Wave Chart Graphic -->
                    <div class="position-relative pt-1 px-1">
                        <svg class="dash-trend-wave-svg" viewBox="0 0 600 140" preserveAspectRatio="none">
                            <defs>
                                <linearGradient id="dashWaveGradient" x1="0%" y1="0%" x2="0%" y2="100%">
                                    <stop offset="0%" stop-color="#2563eb" stop-opacity="0.28" />
                                    <stop offset="60%" stop-color="#2563eb" stop-opacity="0.08" />
                                    <stop offset="100%" stop-color="#2563eb" stop-opacity="0.0" />
                                </linearGradient>
                            </defs>
                            
                            <!-- Subtle Horizontal Reference Grids -->
                            <line x1="10" y1="20" x2="590" y2="20" stroke="#f1f5f9" stroke-width="1.5" stroke-dasharray="3,3" />
                            <line x1="10" y1="65" x2="590" y2="65" stroke="#f1f5f9" stroke-width="1.5" stroke-dasharray="3,3" />
                            <line x1="10" y1="110" x2="590" y2="110" stroke="#f1f5f9" stroke-width="1.5" stroke-dasharray="3,3" />

                            @if (!string.IsNullOrEmpty(SvgAreaPath))
                            {
                                <!-- Gradient Fill Area -->
                                <path d="@SvgAreaPath" fill="url(#dashWaveGradient)" />
                                
                                <!-- Smooth Curve Stroke -->
                                <path d="@SvgStrokePath" fill="none" stroke="#2563eb" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" />

                                @if (TrajectoryPeakPoint != null)
                                {
                                    <!-- Peak Highlight Marker -->
                                    <circle cx="@TrajectoryPeakPoint.SvgX.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)"
                                            cy="@TrajectoryPeakPoint.SvgY.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)"
                                            r="5" fill="#ffffff" stroke="#2563eb" stroke-width="3" />
                                }

                                @if (TrajectoryTodayPoint != null)
                                {
                                    <!-- Today Highlight Marker -->
                                    <circle cx="@TrajectoryTodayPoint.SvgX.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)"
                                            cy="@TrajectoryTodayPoint.SvgY.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)"
                                            r="5" fill="#ffffff" stroke="#10b981" stroke-width="3" />
                                }
                            }
                            else
                            {
                                <line x1="20" y1="70" x2="580" y2="70" stroke="#cbd5e1" stroke-width="2" stroke-dasharray="4,4" />
                            }
                        </svg>

                        <!-- Milestone Date Labels -->
                        <div class="d-flex justify-content-between text-muted small px-1 pt-1.5" style="font-size: 0.72rem;">
                            @foreach (var milestone in MilestoneDateLabels)
                            {
                                <span>@milestone</span>
                            }
                        </div>
                    </div>

                    <!-- Footer Insight Note -->
                    <div class="d-flex align-items-center justify-content-between pt-3 border-top mt-3 small text-muted">
                        <span>
                            <i class="bi bi-shield-check text-success me-1"></i>
                            Workforce attendance stability remains @(TrajectoryAvgAttendanceRate >= 90 ? "optimal" : "moderate") across active workdays
                        </span>
                        <a href="/report" class="text-primary text-decoration-none fw-semibold d-inline-flex align-items-center gap-1">
                            <span>Detailed Log</span>
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>

                </div>

            </div>
        </div>

    </div>

    <!-- ══════════ 4. PENDING REQUESTS TABLES ══════════ -->
    <div class="row g-3 g-xl-4 mb-4">

        <!-- 1. Pending Leave Requests -->
        <div class="col-12 col-xl-6">
            <div class="dash-card h-100 d-flex flex-column">

                <div class="dash-card-header">
                    <div class="d-flex align-items-center gap-2.5">
                        <div class="dash-card-icon-box">
                            <i class="bi bi-file-earmark-text"></i>
                        </div>
                        <h6 class="dash-card-title mb-0 d-flex align-items-center gap-2">
                            <span>Pending Leave Requests</span>
                            @if (DisplayLeaveRequests.Any())
                            {
                                <span class="badge bg-warning bg-opacity-25 text-warning fw-bold rounded-pill px-2" style="font-size: 0.72rem;">@DisplayLeaveRequests.Count</span>
                            }
                        </h6>
                    </div>

                    <a href="/admin-leave-requests" class="dash-view-all-link">
                        View All
                    </a>
                </div>

                <div class="card-body p-0 flex-grow-1">
                    <div class="dash-table-wrapper">
                        <table class="dash-table">
                            <thead>
                                <tr>
                                    <th>EMP ID</th>
                                    <th>EMPLOYEE</th>
                                    <th>LEAVE TYPE</th>
                                    <th>DURATION</th>
                                    <th>STATUS</th>
                                    <th class="text-center">ACTION</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (DisplayLeaveRequests.Any())
                                {
                                    @foreach (var req in DisplayLeaveRequests)
                                    {
                                        <tr>
                                            <td class="font-monospace text-secondary small">@(string.IsNullOrWhiteSpace(req.EmployeeNumber) ? $"EMP{req.EmployeeId:D3}" : req.EmployeeNumber)</td>
                                            <td class="fw-medium text-dark">@(string.IsNullOrWhiteSpace(req.EmployeeName) ? "Employee" : req.EmployeeName)</td>
                                            <td>
                                                <span class="@GetLeaveTypeBadgeClass(req.LeaveTypeName)">
                                                    @(string.IsNullOrWhiteSpace(req.LeaveTypeName) ? "Leave" : FormatLeaveName(req.LeaveTypeName))
                                                </span>
                                            </td>
                                            <td class="text-secondary small">@FormatDuration(req.StartDate, req.EndDate)</td>
                                            <td>
                                                <span class="@GetStatusBadgeClass(req.StatusId)">
                                                    @req.StatusId
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                @if (req.StatusId == Status.Pending)
                                                {
                                                    <div class="d-inline-flex align-items-center gap-1.5">
                                                        <button type="button" class="dash-action-btn dash-action-approve"
                                                                title="Approve"
                                                                @onclick="() => ApproveLeave(req)">
                                                            <i class="bi bi-check-lg"></i>
                                                        </button>
                                                        <button type="button" class="dash-action-btn dash-action-reject"
                                                                title="Reject"
                                                                @onclick="() => RejectLeave(req)">
                                                            <i class="bi bi-x-lg"></i>
                                                        </button>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted small">&mdash;</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="text-center py-4 text-muted small">
                                            <i class="bi bi-check2-circle text-success me-1"></i> No pending leave requests
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>

        <!-- 2. Pending Attendance Requests -->
        <div class="col-12 col-xl-6">
            <div class="dash-card h-100 d-flex flex-column">

                <div class="dash-card-header">
                    <div class="d-flex align-items-center gap-2.5">
                        <div class="dash-card-icon-box">
                            <i class="bi bi-file-earmark-text"></i>
                        </div>
                        <h6 class="dash-card-title mb-0 d-flex align-items-center gap-2">
                            <span>Pending Attendance Requests</span>
                            @if (DisplayAttendanceRequests.Any())
                            {
                                <span class="badge bg-warning bg-opacity-25 text-warning fw-bold rounded-pill px-2" style="font-size: 0.72rem;">@DisplayAttendanceRequests.Count</span>
                            }
                        </h6>
                    </div>

                    <a href="/admin-attendance-requests" class="dash-view-all-link">
                        View All
                    </a>
                </div>

                <div class="card-body p-0 flex-grow-1">
                    <div class="dash-table-wrapper">
                        <table class="dash-table">
                            <thead>
                                <tr>
                                    <th>EMP ID</th>
                                    <th>EMPLOYEE</th>
                                    <th>DATE</th>
                                    <th>REQUEST TYPE</th>
                                    <th>STATUS</th>
                                    <th class="text-center">ACTION</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (DisplayAttendanceRequests.Any())
                                {
                                    @foreach (var req in DisplayAttendanceRequests)
                                    {
                                        <tr>
                                            <td class="font-monospace text-secondary small">@GetAttendanceEmpId(req)</td>
                                            <td class="fw-medium text-dark">@(string.IsNullOrWhiteSpace(req.EmployeeName) ? "Employee" : req.EmployeeName)</td>
                                            <td class="text-secondary small">@(req.FromDate?.ToString("MMM dd, yyyy") ?? "-")</td>
                                            <td>
                                                <span class="dash-badge-req-type">
                                                    @FormatReasonType(req.ReasonTypeId)
                                                </span>
                                            </td>
                                            <td>
                                                <span class="@GetStatusBadgeClass(req.StatusId)">
                                                    @req.StatusId
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                @if (req.StatusId == Status.Pending)
                                                {
                                                    <div class="d-inline-flex align-items-center gap-1.5">
                                                        <button type="button" class="dash-action-btn dash-action-approve"
                                                                title="Approve"
                                                                @onclick="() => ApproveAttendance(req)">
                                                            <i class="bi bi-check-lg"></i>
                                                        </button>
                                                        <button type="button" class="dash-action-btn dash-action-reject"
                                                                title="Reject"
                                                                @onclick="() => RejectAttendance(req)">
                                                            <i class="bi bi-x-lg"></i>
                                                        </button>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted small">&mdash;</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="text-center py-4 text-muted small">
                                            <i class="bi bi-check2-circle text-success me-1"></i> No pending attendance requests
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>

    </div>

</div>

