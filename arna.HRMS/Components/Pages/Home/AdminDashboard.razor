    private async Task SelectEmployee(int employeeId)
    {
        selectedEmployeeId = employeeId;
        showEmployeeDropdown = false;
        employeeSearchText = string.Empty;

        // User requirement: When selecting a specific employee, default to weekly data; when All Employees, default to monthly data
        if (selectedEmployeeId > 0)
        {
            if (selectedRangeOption == "this_month")
            {
                await SelectRangePreset("this_week");
                return;
            }
        }
        else
        {
