    }

    private async Task SelectRangePreset(string preset)
    {
        selectedRangeOption = preset;
        var now = DateTime.Today;

        switch (preset)
        {
            case "this_week":
                int diff = (7 + (int)now.DayOfWeek - (int)DayOfWeek.Monday) % 7;
                selectedStartDate = now.AddDays(-diff);
                selectedEndDate = selectedStartDate.AddDays(6);
                break;
            case "last_7_days":
                selectedStartDate = now.AddDays(-6);
                selectedEndDate = now;
                break;
            case "this_month":
                selectedStartDate = new DateTime(now.Year, now.Month, 1);
                selectedEndDate = selectedStartDate.AddMonths(1).AddDays(-1);
                break;
            case "last_month":
                var lastM = new DateTime(now.Year, now.Month, 1).AddMonths(-1);
                selectedStartDate = lastM;
                selectedEndDate = lastM.AddMonths(1).AddDays(-1);
                break;
            case "last_30_days":
                selectedStartDate = now.AddDays(-29);
                selectedEndDate = now;
                break;
            case "year_2026":
                selectedStartDate = new DateTime(2026, 1, 1);
                selectedEndDate = new DateTime(2026, 12, 31);
                break;
        }

        customStartDate = selectedStartDate;
        customEndDate = selectedEndDate;
        SelectedDateRangeLabel = $"{selectedStartDate:MMM dd, yyyy} - {selectedEndDate:MMM dd, yyyy}";
        showDateRangeDropdown = false;

        await RebuildAttendanceChart();
    }

    private async Task ApplyCustomDateRange()
    {
        if (customStartDate > customEndDate)
        {
            var temp = customStartDate;
            customStartDate = customEndDate;
            customEndDate = temp;
        }

        selectedStartDate = customStartDate;
        selectedEndDate = customEndDate;
        selectedRangeOption = "custom";
        SelectedDateRangeLabel = $"{selectedStartDate:MMM dd, yyyy} - {selectedEndDate:MMM dd, yyyy}";
        showDateRangeDropdown = false;

        await RebuildAttendanceChart();
    }

