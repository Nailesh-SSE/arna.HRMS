        if (!await JsRuntime.InvokeAsync<bool>("confirm", $"Reject attendance request for {req.EmployeeName}?"))
            return;

        var empId = GetEmployeeId() > 0 ? GetEmployeeId() : (GetUserId() > 0 ? GetUserId() : 1);

        if (req.Id > 0)
        {
            var res = await AttendanceRequestService.UpdateRequestStatusAsync(req.Id, Status.Rejected, empId);
            if (res?.IsSuccess == true)
            {
                await NotificationService.Success("Attendance request rejected.");
                req.StatusId = Status.Rejected;
                pendingAttendanceRequests.Remove(req);
                AttendancePendingCount = DisplayAttendanceRequests.Count;
                await RebuildAttendanceChart();
                BuildDepartmentSummaries();
                await BuildAttendanceTrajectory();
                StateHasChanged();
            }
            else
            {
                await NotificationService.Error(res?.Message ?? "Failed to reject attendance.");
            }
        }
    }

    private static string FormatDuration(DateTime start, DateTime end)
    {
        if (start.Date == end.Date)
            return start.ToString("MMM dd");

        return $"{start:MMM dd} - {end:MMM dd}";
    }

    private static string FormatLeaveName(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "Leave";
        return System.Text.RegularExpressions.Regex.Replace(name, "(\\B[A-Z])", " $1").Trim();
    }

    private static string GetLeaveTypeBadgeClass(string? type)
    {
        var clean = (type ?? "").Replace(" ", "").ToLowerInvariant();
        return clean switch
        {
            "sickleave" or "sick" => "dash-badge-leave-sick",
            "casualleave" or "casual" => "dash-badge-leave-casual",
            _ => "dash-badge-leave-paid"
        };
    }

    private static string GetStatusBadgeClass(Status status) => status switch
    {
        Status.Approved => "dash-badge-status-approved",
        Status.Rejected => "dash-badge-status-rejected",
        Status.Cancelled => "dash-badge-status-cancelled",
        _ => "dash-badge-status-pending"
    };

    private static string GetAttendanceEmpId(AttendanceRequestViewModel req) =>
        !string.IsNullOrWhiteSpace(req.EmployeeNumber) ? req.EmployeeNumber : $"EMP{req.EmployeeId:D3}";

    private static string FormatReasonType(AttendanceReasonType? reason) => reason switch
    {
        AttendanceReasonType.CompOffRequest => "Regularization",
        AttendanceReasonType.TechnicalIssue => "Missed Punch",
        AttendanceReasonType.EarlyClockOut => "Half Day",
        AttendanceReasonType.ForgotToClockIn => "In Time",
        AttendanceReasonType.ForgotToClockOut => "Out Time",
        AttendanceReasonType.ClientVisit => "Client Visit",
        AttendanceReasonType.WorkFromHome => "Work From Home",
        AttendanceReasonType.LateClockIn => "Late In",
        _ => "Regularization"
    };
}
