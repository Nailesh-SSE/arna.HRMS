    private async Task LoadCombinedRecentRequestsAsync()
    {
        var list = new List<CombinedRequestItem>();

        try
        {
            // 1. Process Leave Requests from Backend Dashboard
            var leaveList = dashboard.Requests ?? myRequests ?? new List<LeaveRequestViewModel>();
            foreach (var req in leaveList)
            {
                var rawName = !string.IsNullOrWhiteSpace(req.LeaveTypeName)
                    ? req.LeaveTypeName
                    : GetLeaveTypeName(req.LeaveTypeId);
                var typeName = FormatName(rawName);

                var dateRange = FormatLeaveDateRange(req.StartDate, req.EndDate);
                var createdOn = req.CreatedOn != default 
                    ? req.CreatedOn.ToString("MMM dd, yyyy") 
                    : req.StartDate.ToString("MMM dd, yyyy");

                list.Add(new CombinedRequestItem
                {
                    Id = req.Id,
                    RequestType = "Leave Request",
                    RequestName = typeName,
                    DateRangeDisplay = dateRange,
                    CreatedOnDisplay = createdOn,
                    StatusId = req.StatusId,
                    SortDate = req.CreatedOn != default ? req.CreatedOn : req.StartDate,
                    LinkUrl = "/emp-leave-management"
                });
            }

            // 2. Process Attendance Requests from Backend Dashboard
            var attendanceList = dashboard.AttendanceRequests;
            if ((attendanceList == null || !attendanceList.Any()) && EmployeeId > 0)
            {
                var attResult = await AttendanceRequestService.GetAllAsync(EmployeeId);
                if (attResult?.IsSuccess == true && attResult.Data != null)
                {
                    attendanceList = attResult.Data;
                }
            }

            if (attendanceList != null && attendanceList.Any())
            {
                foreach (var req in attendanceList)
                {
                    var reasonName = GetAttendanceReasonTitle(req.ReasonTypeId);
                    var attDate = req.FromDate ?? (req.CreatedOn != default ? req.CreatedOn : DateTime.Today);
                    var dateDisplay = attDate.ToString("MMM dd, yyyy");
                    var createdOn = req.CreatedOn != default 
                        ? req.CreatedOn.ToString("MMM dd, yyyy") 
                        : attDate.ToString("MMM dd, yyyy");

                    list.Add(new CombinedRequestItem
                    {
                        Id = req.Id,
                        RequestType = "Attendance Request",
                        RequestName = reasonName,
                        DateRangeDisplay = dateDisplay,
                        CreatedOnDisplay = createdOn,
                        StatusId = req.StatusId,
                        SortDate = req.CreatedOn != default ? req.CreatedOn : attDate,
                        LinkUrl = "/emp-attendance-management"
                    });
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[CombinedRequests] Error: {ex.Message}");
        }

        if (list.Any())
        {
            combinedRecentRequests = list
                .OrderByDescending(r => r.SortDate)
                .Take(5)
                .ToList();

            pendingCount = list.Count(r => r.StatusId == Status.Pending);
        }
        else
        {
            combinedRecentRequests = new();
            pendingCount = 0;
        }
    }

    private static string FormatLeaveDateRange(DateTime start, DateTime end)
    {
        if (start.Date == end.Date)
        {
            return start.ToString("MMM dd, yyyy");
        }
        if (start.Year == end.Year)
        {
            return $"{start:MMM dd} - {end:MMM dd, yyyy}";
        }
        return $"{start:MMM dd, yyyy} - {end:MMM dd, yyyy}";
    }

    private static string GetAttendanceReasonTitle(AttendanceReasonType? reasonType) => reasonType switch
    {
        AttendanceReasonType.WorkFromHome => "Work From Home",
        AttendanceReasonType.ForgotToClockIn => "Missed Clock-In",
        AttendanceReasonType.ForgotToClockOut => "Missed Clock-Out",
        AttendanceReasonType.LateClockIn => "Late Arrival Regularize",
        AttendanceReasonType.EarlyClockOut => "Early Departure Regularize",
        AttendanceReasonType.ClientVisit => "Client Site Visit",
        AttendanceReasonType.TechnicalIssue => "Technical Punch Issue",
        AttendanceReasonType.CompOffRequest => "Comp-Off Request",
        _ => "Attendance Regularization"
    };

