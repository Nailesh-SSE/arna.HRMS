    private void BuildBalances()
    {
        var (start, end) = GetFinancialYear();

        var approved = myRequests
            .Where(r => r.StatusId == Status.Approved &&
                        r.StartDate >= start &&
                        r.StartDate <= end)
            .ToList();

        var usedByType = approved
            .GroupBy(x => x.LeaveTypeId)
            .ToDictionary(g => g.Key, g => g.Sum(x => x.LeaveDays));

        leaveBalances = leaveTypes
            .Where(t => t.IsActive)
            .Select(t =>
            {
                usedByType.TryGetValue(t.Id, out var used);
                return new LeaveBalanceViewModel
                {
                    LeaveTypeId = t.Id,
                    LeaveTypeName = t.LeaveNameId.ToString(),
                    TotalDays = t.MaxPerYear,
                    UsedDays = used
                };
            }).ToList();

        totalBalance = leaveBalances.Sum(b => b.RemainingDays);
    }

    private (DateTime start, DateTime end) GetFinancialYear()
    {
        var today = DateTime.Today;
        int year = today.Month >= 4 ? today.Year : today.Year - 1;
        var start = new DateTime(year, 4, 1);
        var end = new DateTime(year + 1, 3, 31);
        return (start, end);
    }

    private async Task LoadMonthlyMetricsAsync()
    {
        try
        {
            var now = DateTime.Today;
            var monthlyAttResult = await ClockService.GetAttendanceByMonthAsync(now.Year, now.Month, EmployeeId, null, null);
            var monthlyList = monthlyAttResult?.Data ?? new List<MonthlyAttendanceViewModel>();

            if (monthlyList.Any())
            {
                var allDays = monthlyList
                    .SelectMany(m => m.Employees.Where(e => e.EmployeeId == EmployeeId))
                    .ToList();

                if (allDays.Any())
                {
                    var pDays = allDays.Count(d => d.Status == "Present" || d.Status == "Late");
                    var aDays = allDays.Count(d => d.Status == "Absent");
                    var hDays = allDays.Count(d => d.Status == "HalfDay");
                    var lDays = allDays.Count(d => d.Status == "Leave");

                    presentDaysCount = pDays;
                    absentDaysCount = aDays;
                    halfDaysCount = hDays;
                    leaveDaysCount = lDays;

                    var workingTotal = presentDaysCount + absentDaysCount + halfDaysCount + leaveDaysCount;
                    attendancePercentage = workingTotal > 0
                        ? (int)Math.Round((presentDaysCount + (halfDaysCount * 0.5)) * 100.0 / workingTotal)
                        : 0;

                    var monthSecs = allDays.Sum(d => d.WorkingHours.TotalSeconds);
                    var monthSpan = TimeSpan.FromSeconds(monthSecs);
                    monthlyHoursDisplay = $"{((int)monthSpan.TotalHours):D2}h {monthSpan.Minutes:D2}m";
                    monthlyProgressPercent = Math.Min(100, (int)Math.Round((monthSpan.TotalHours / 160.0) * 100));

                    var weeklySecs = allDays
                        .Where(d => d.Date >= now.AddDays(-(int)now.DayOfWeek) && d.Date <= now)
                        .Sum(d => d.WorkingHours.TotalSeconds);

                    var weekSpan = TimeSpan.FromSeconds(weeklySecs);
                    weeklyHoursDisplay = $"{((int)weekSpan.TotalHours):D2}h {weekSpan.Minutes:D2}m";
                    weeklyProgressPercent = Math.Min(100, (int)Math.Round((weekSpan.TotalHours / 40.0) * 100));

                    BuildCurrentWeekAttendance(allDays);
                }
                else
                {
                    BuildCurrentWeekAttendance(null);
                }
            }
            else
            {
                BuildCurrentWeekAttendance(null);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[MonthlyMetrics] Error: {ex.Message}");
            BuildCurrentWeekAttendance(null);
        }
    }

    private void BuildCurrentWeekAttendance(List<EmployeeDailyAttendanceViewModel>? attendanceRecords = null)
    {
        var today = DateTime.Today;
        int diff = (7 + (today.DayOfWeek - DayOfWeek.Monday)) % 7;
        var monday = today.AddDays(-1 * diff).Date;

        var days = new List<WeeklyDayAttendanceItem>();
        var totalSecs = 0.0;
        var workDaysCount = 0;

        var allLeaves = dashboard.Requests ?? myRequests ?? new List<LeaveRequestViewModel>();

        for (int i = 0; i < 7; i++)
        {
            var date = monday.AddDays(i);
            var isToday = date.Date == today;
            var isWeekend = date.DayOfWeek == DayOfWeek.Saturday || date.DayOfWeek == DayOfWeek.Sunday;
            var dayName = date.ToString("ddd");
            var dateFmt = date.ToString("dd MMM");

            var leaveMatch = allLeaves.FirstOrDefault(l =>
                (l.StatusId == Status.Approved || l.StatusId == Status.Pending) &&
                date.Date >= l.StartDate.Date &&
                date.Date <= l.EndDate.Date);

            var item = new WeeklyDayAttendanceItem
            {
                DayOfWeek = date.DayOfWeek,
                DayName = dayName,
                DateFormatted = dateFmt,
                Date = date,
                IsToday = isToday,
                IsWeekend = isWeekend,
                IsLeave = leaveMatch != null,
                LeaveType = leaveMatch != null
                    ? (!string.IsNullOrWhiteSpace(leaveMatch.LeaveTypeName) ? leaveMatch.LeaveTypeName : "Leave")
                    : ""
            };

            if (isWeekend)
            {
                item.DurationDisplay = "--";
                item.StatusLabel = "Weekend";
                item.StatusClass = "day-off";
            }
            else if (leaveMatch != null)
            {
                item.DurationDisplay = "Leave";
                item.StatusLabel = "On Leave";
                item.StatusClass = "day-leave";
            }
            else if (isToday)
            {
                var record = attendanceRecords?.FirstOrDefault(d => d.Date.Date == today);
                if (record != null && record.WorkingHours > TimeSpan.Zero)
                {
                    var hrs = record.WorkingHours;
                    item.DurationDisplay = $"{((int)hrs.TotalHours):D2}h {hrs.Minutes:D2}m";
                    item.StatusLabel = "Active";
                    item.StatusClass = "day-today";
                    totalSecs += hrs.TotalSeconds;
                    workDaysCount++;
                }
                else
                {
                    item.DurationDisplay = "Today";
                    item.StatusLabel = "Today";
                    item.StatusClass = "day-today";
                }
            }
            else if (date < today)
            {
                var record = attendanceRecords?.FirstOrDefault(d => d.Date.Date == date);
                if (record != null && (record.Status == "Leave" || record.Status == "Holiday"))
                {
                    item.IsLeave = true;
                    item.DurationDisplay = "Leave";
                    item.StatusLabel = record.Status;
                    item.StatusClass = "day-leave";
                }
                else if (record != null && record.WorkingHours > TimeSpan.Zero)
                {
                    var hrs = record.WorkingHours;
                    item.DurationDisplay = $"{((int)hrs.TotalHours):D2}h {hrs.Minutes:D2}m";
                    item.StatusLabel = "Present";
                    item.StatusClass = "day-present";
                    totalSecs += hrs.TotalSeconds;
                    workDaysCount++;
                }
                else
                {
                    item.DurationDisplay = "--";
                    item.StatusLabel = "Absent";
                    item.StatusClass = "day-absent";
                }
            }
            else
            {
                item.DurationDisplay = "--:--";
                item.StatusLabel = "Upcoming";
                item.StatusClass = "day-upcoming";
            }

            days.Add(item);
        }

        currentWeekDays = days;

        var weekSpan = TimeSpan.FromSeconds(totalSecs);
        totalWeekHoursDisplay = $"{((int)weekSpan.TotalHours):D2}h {weekSpan.Minutes:D2}m";

        if (workDaysCount > 0 && weekSpan.TotalSeconds > 0)
        {
            var avgSpan = TimeSpan.FromSeconds(weekSpan.TotalSeconds / workDaysCount);
            avgDailyHoursDisplay = $"{((int)avgSpan.TotalHours):D2}h {avgSpan.Minutes:D2}m";
        }
        else
        {
            avgDailyHoursDisplay = "00h 00m";
        }
    }

