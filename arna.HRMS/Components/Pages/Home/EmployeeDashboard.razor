@using arna.HRMS.Components.Loader
@using arna.HRMS.Components.Pages.Attendance
@using arna.HRMS.Components.Pages.Client.ClockInAndOut
@using arna.HRMS.Models.Enums
@using arna.HRMS.Models.ViewModels
@using arna.HRMS.Models.ViewModels.Attendance
@using arna.HRMS.Models.ViewModels.Leave
@using arna.HRMS.Services
@using arna.HRMS.Services.Dashboard
@using arna.HRMS.Services.Common

@inject NavigationManager Nav
@inject IDashboardService dashboardService
@inject IAttendanceService ClockService
@inject IAttendanceRequestService AttendanceRequestService
@inject IFestivalHolidayService HolidayService
@inject IJSRuntime JS
@inject NotificationService NotificationService

<Loader Visible="@isLoading" Message="@loaderMessage" />

<div class="dash-fade-in employee-dashboard-root pb-4">

    <!-- ═════════════════════════════════════════════════════════════════════ -->
    <!-- 1. GREETING HEADER & CLOCK IN/OUT COMPONENT                           -->
    <!-- ═════════════════════════════════════════════════════════════════════ -->
    @* <div class="d-flex align-items-center justify-content-between pb-3 mb-3 border-bottom hero-top-bar">
        <h5 class="fw-bold mb-0 text-dark hero-greeting">
            @GetGreeting(), @GetDisplayName() 👋
        </h5>
    </div> *@

    <!-- Isolated, Reusable ClockInAndOut Component -->
    <ClockInAndOut EmployeeId="@EmployeeId" OnClockStatusChanged="OnClockStatusChanged" />

    <!-- ═════════════════════════════════════════════════════════════════════ -->
    <!-- 2. SECOND ROW: 4 KPI CARDS (MODERN COMPACT WITH SUBTLE TRENDS) -->
    <!-- ═════════════════════════════════════════════════════════════════════ -->
    <div class="row g-3 mb-4">
        
        <!-- 1. Attendance Rate -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 kpi-card h-100">
                <div class="card-body p-3 p-xl-4 d-flex flex-column justify-content-between">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="kpi-label">Attendance Rate</span>
                        <div class="kpi-icon-wrap kpi-icon-primary">
                            <i class="bi bi-calendar-check"></i>
                        </div>
                    </div>
                    <div class="kpi-val text-dark">@attendancePercentage%</div>
                    <div class="d-flex align-items-center justify-content-between mt-2 pt-1">
                        <small class="text-muted">This Month</small>
                        <span class="badge-trend badge-trend-success">
                            <i class="bi bi-person-check me-1"></i> @presentDaysCount Present
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. Leave Balance -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 kpi-card h-100">
                <div class="card-body p-3 p-xl-4 d-flex flex-column justify-content-between">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="kpi-label">Leave Balance</span>
                        <div class="kpi-icon-wrap @(totalBalance < 0 ? "kpi-icon-danger text-danger bg-danger bg-opacity-10" : "kpi-icon-success")">
                            <i class="bi bi-briefcase"></i>
                        </div>
                    </div>
                    <div class="kpi-val @(totalBalance < 0 ? "text-danger" : "text-dark")">@totalBalance <span class="fs-6 fw-normal text-muted">Days</span></div>
                    <div class="d-flex align-items-center justify-content-between mt-2 pt-1">
                        <small class="text-muted">@(totalBalance < 0 ? "Quota Exceeded" : "Available Balance")</small>
                        @if (totalBalance < 0)
                        {
                            <span class="badge-trend badge-trend-rose">
                                <i class="bi bi-exclamation-triangle me-1"></i> Exceeded
                            </span>
                        }
                        else
                        {
                            <span class="badge-trend badge-trend-emerald">
                                <i class="bi bi-shield-check me-1"></i> Available
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. Pending Requests -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 kpi-card h-100">
                <div class="card-body p-3 p-xl-4 d-flex flex-column justify-content-between">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="kpi-label">Pending Requests</span>
                        <div class="kpi-icon-wrap kpi-icon-warning">
                            <i class="bi bi-hourglass-split"></i>
                        </div>
                    </div>
                    <div class="kpi-val text-dark">@pendingCount <span class="fs-6 fw-normal text-muted">@(pendingCount == 1 ? "Request" : "Requests")</span></div>
                    <div class="d-flex align-items-center justify-content-between mt-2 pt-1">
                        <small class="text-muted">Leave & Attendance</small>
                        <span class="badge-trend @(pendingCount > 0 ? "badge-trend-amber" : "badge-trend-neutral")">
                            <i class="bi @(pendingCount > 0 ? "bi-clock" : "bi-check2") me-1"></i> @(pendingCount > 0 ? "Awaiting Action" : "All Clear")
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 4. Timesheet Hours -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 kpi-card h-100">
                <div class="card-body p-3 p-xl-4 d-flex flex-column justify-content-between">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="kpi-label">Timesheet Hours</span>
                        <div class="kpi-icon-wrap kpi-icon-info">
                            <i class="bi bi-clock-history"></i>
                        </div>
                    </div>
                    <div class="kpi-val text-dark">@monthlyHoursDisplay</div>
                    <div class="d-flex align-items-center justify-content-between mt-2 pt-1">
                        <small class="text-muted">Monthly Logged</small>
                        <span class="badge-trend badge-trend-neutral">
                            <i class="bi bi-check2-circle me-1"></i> @monthlyProgressPercent% of Target
                        </span>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- ═════════════════════════════════════════════════════════════════════ -->
    <!-- 3. THIRD ROW: WORK SCHEDULE & HOURS + COMBINED RECENT REQUESTS -->
    <!-- ═════════════════════════════════════════════════════════════════════ -->
    <div class="row g-4 mb-4">

        <!-- Column 1: Weekly Attendance & Shifts (7-Day Visual Activity Strip) -->
        <div class="col-12 col-lg-6">
            <div class="card border-0 shadow-sm rounded-3 h-100 content-card">
                <div class="card-header bg-transparent border-0 pt-3 px-3 px-lg-4 pb-2">
                    <h6 class="fw-semibold mb-0 d-flex align-items-center text-dark">
                        <i class="bi bi-calendar2-week-fill text-primary me-2"></i> Weekly Attendance & Shifts
                    </h6>
                    <small class="text-muted">Monday to Sunday schedule & logged activity</small>
                </div>
                
                <div class="card-body px-3 px-lg-4 py-3 d-flex flex-column justify-content-between">
                    <div class="d-flex flex-column gap-3">
                        
                        <!-- Shift & Mode Badges Strip -->
                        <div class="d-flex flex-wrap align-items-center gap-2 pb-1">
                            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-20 px-3 py-1.5 rounded-pill small fw-medium d-inline-flex align-items-center">
                                <i class="bi bi-briefcase-fill me-1.5"></i> General Shift: 09:30 AM - 06:30 PM
                            </span>
                            <span class="badge bg-light text-secondary border px-3 py-1.5 rounded-pill small fw-medium d-inline-flex align-items-center">
                                <i class="bi bi-building me-1.5"></i> Hybrid (5 Days)
                            </span>
                            <span class="badge bg-light text-secondary border px-3 py-1.5 rounded-pill small fw-medium d-inline-flex align-items-center">
                                <i class="bi bi-clock me-1.5"></i> 8h Policy
                            </span>
                        </div>

                        <!-- 7-Day Visual Activity Strip -->
                        <div class="week-strip-container">
                            <div class="row g-2 text-center">
                                @foreach (var day in currentWeekDays)
                                {
                                    <div class="col">
                                        <div class="week-day-card @(day.IsToday ? "week-day-today" : day.IsLeave ? "week-day-leave" : day.IsWeekend ? "week-day-weekend" : "week-day-normal") rounded-3 h-100 d-flex flex-column justify-content-between">
                                            <div class="week-day-header mb-1">
                                                <span class="week-day-name fw-semibold d-block">@day.DayName</span>
                                                <span class="week-day-date text-muted" style="font-size: 0.70rem;">@day.DateFormatted</span>
                                            </div>
                                            
                                            <div class="week-day-hours py-1">
                                                @if (day.IsLeave)
                                                {
                                                    <span class="fw-semibold text-warning-emphasis small d-block">Leave</span>
                                                }
                                                else if (day.IsWeekend)
                                                {
                                                    <span class="text-muted small d-block">--</span>
                                                }
                                                else
                                                {
                                                    <span class="fw-semibold @(day.IsToday ? "text-primary fw-bold" : "text-dark") small d-block" style="font-size: 0.82rem;">@day.DurationDisplay</span>
                                                }
                                            </div>

                                            <div class="week-day-status mt-1">
                                                @if (day.IsLeave)
                                                {
                                                    <span class="day-badge day-badge-leave">
                                                        <i class="bi bi-umbrella-fill me-1"></i> Leave
                                                    </span>
                                                }
                                                else if (day.IsWeekend)
                                                {
                                                    <span class="day-badge day-badge-off">
                                                        <i class="bi bi-calendar-x me-1"></i> Off
                                                    </span>
                                                }
                                                else if (day.IsToday)
                                                {
                                                    <span class="day-badge day-badge-live">
                                                        <span class="day-badge-dot me-1"></span> @day.StatusLabel
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="day-badge @(day.StatusClass == "day-present" ? "day-badge-present" : "day-badge-absent")">
                                                        @if (day.StatusClass == "day-present")
                                                        {
                                                            <i class="bi bi-check-circle me-1"></i>
                                                        }
                                                        else
                                                        {
                                                            <i class="bi bi-x-circle me-1"></i>
                                                        }
                                                        @day.StatusLabel
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- 2 Summary Metrics Highlight Tiles (Week Total & Daily Avg only) -->
                        <div class="row g-3 pt-1">
                            <div class="col-6">
                                <div class="p-2.5 rounded-3 bg-light border text-center">
                                    <span class="text-muted d-block" style="font-size: 0.75rem; font-weight: 500;">Week Total</span>
                                    <span class="fw-bold text-dark fs-6">@totalWeekHoursDisplay</span>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-2.5 rounded-3 bg-light border text-center">
                                    <span class="text-muted d-block" style="font-size: 0.75rem; font-weight: 500;">Daily Avg</span>
                                    <span class="fw-bold text-dark fs-6">@avgDailyHoursDisplay</span>
                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- Footer Details -->
                    <div class="pt-3 border-top mt-3 d-flex align-items-center justify-content-between text-muted small">
                        <span><i class="bi bi-shield-check text-success me-1.5"></i> Standard 8h work + 1h break policy</span>
                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-20 rounded-pill px-2.5 py-1">In Good Standing</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Column 2: Recent Requests Card (Sleek Mini-Grid Table Layout) -->
        <div class="col-12 col-lg-6">
            <div class="card border-0 shadow-sm rounded-3 h-100 content-card">
                <div class="card-header bg-transparent border-0 pt-3 px-3 px-lg-4 pb-2 d-flex align-items-center justify-content-between">
                    <div>
                        <h6 class="fw-semibold mb-0 d-flex align-items-center text-dark">
                            <i class="bi bi-inboxes-fill text-primary me-2"></i> Recent Requests
                        </h6>
                        <small class="text-muted">Track status of your submitted requests</small>
                    </div>
                    <a href="/emp-leave-management" class="text-primary text-decoration-none small fw-semibold d-inline-flex align-items-center">
                        View All <i class="bi bi-chevron-right ms-1"></i>
                    </a>
                </div>

                <div class="card-body px-3 px-lg-4 py-2 d-flex flex-column justify-content-between">
                    @if (combinedRecentRequests.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0 recent-requests-table">
                                <thead>
                                    <tr>
                                        <th style="width: 35%;">Type</th>
                                        <th style="width: 27%;">Date</th>
                                        <th style="width: 22%;">Created On</th>
                                        <th class="text-end" style="width: 16%;">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var req in combinedRecentRequests.Take(5))
                                    {
                                        <tr role="button" @onclick="@(() => Nav.NavigateTo(req.LinkUrl))">
                                            <td>
                                                <div class="d-flex flex-column">
                                                    <span class="fw-semibold text-dark small">@req.RequestName</span>
                                                    <span class="text-muted" style="font-size: 0.72rem;">@req.RequestType</span>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="text-dark small fw-medium">@req.DateRangeDisplay</span>
                                            </td>
                                            <td>
                                                <span class="text-muted small">@req.CreatedOnDisplay</span>
                                            </td>
                                            <td class="text-end">
                                                <span class="badge-status-dot @GetStatusDotClass(req.StatusId)">
                                                    <span class="dot me-1"></span> @req.StatusId
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary opacity-50"></i>
                            <p class="small mb-0">No recent requests found</p>
                        </div>
                    }

                    <!-- Footer Link -->
                    <div class="pt-3 border-top mt-2 d-flex align-items-center justify-content-between text-muted small">
                        <span><i class="bi bi-clock-history me-1.5 text-primary"></i> Showing latest @Math.Min(5, combinedRecentRequests.Count) submissions</span>
                        <a href="/emp-leave-management" class="text-muted text-decoration-none fw-medium">View History</a>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- ═════════════════════════════════════════════════════════════════════ -->
    <!-- 4. FOURTH ROW: UPCOMING HOLIDAYS & COMPANY ANNOUNCEMENTS -->
    <!-- ═════════════════════════════════════════════════════════════════════ -->
    <div class="row g-4 mb-4">

        <!-- Column 1: Upcoming Holidays -->
        <div class="col-12 col-lg-6">
            <div class="card border-0 shadow-sm rounded-3 h-100 content-card">
                <div class="card-header bg-transparent border-0 pt-3 px-3 px-lg-4 pb-2 d-flex align-items-center justify-content-between">
                    <div>
                        <h6 class="fw-semibold mb-0 d-flex align-items-center text-dark">
                            <i class="bi bi-stars text-warning me-2"></i> Upcoming Holidays
                        </h6>
                        <small class="text-muted">Official company holiday calendar & time-off</small>
                    </div>
                    <span class="badge bg-light text-secondary border rounded-pill px-2.5 py-1 small">
                        2026 Calendar
                    </span>
                </div>

                <div class="card-body px-3 px-lg-4 py-3 d-flex flex-column justify-content-between">
                    @if (upcomingHolidays.Any())
                    {
                        <div class="d-flex flex-column gap-2">
                            @foreach (var hol in upcomingHolidays.Take(3))
                            {
                                <div class="holiday-row-card p-2.5 rounded-3 d-flex align-items-center justify-content-between gap-3">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="holiday-date-badge text-center">
                                            <span class="holiday-month">@hol.Date.ToString("MMM").ToUpper()</span>
                                            <span class="holiday-day">@hol.Date.ToString("dd")</span>
                                        </div>
                                        <div>
                                            <div class="fw-semibold text-dark small">@hol.FestivalName</div>
                                            <small class="text-muted" style="font-size: 0.74rem;">
                                                @hol.Date.DayOfWeek &bull; @(string.IsNullOrEmpty(hol.Description) ? "Holiday" : hol.Description)
                                            </small>
                                        </div>
                                    </div>
                                    <span class="badge holiday-countdown-badge rounded-pill px-2.5 py-1 small">
                                        @GetHolidayCountdown(hol.Date)
                                    </span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="bi bi-calendar-x fs-2 d-block mb-2 text-secondary opacity-50"></i>
                            <p class="small mb-0">No upcoming holidays scheduled</p>
                        </div>
                    }

                    <div class="pt-3 border-top mt-3 text-center">
                        <a href="/emp-leave-management" class="text-primary text-decoration-none small fw-semibold d-inline-flex align-items-center">
                            Explore Full Annual Holiday Schedule <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Column 2: Quick Actions (Replaces Company Announcements) -->
        <div class="col-12 col-lg-6">
            <div class="card border-0 shadow-sm rounded-3 h-100 content-card">
                <div class="card-header bg-transparent border-0 pt-3 px-3 px-lg-4 pb-2 d-flex align-items-center justify-content-between">
                    <div>
                        <h6 class="fw-semibold mb-0 d-flex align-items-center text-dark">
                            <i class="bi bi-lightning-charge-fill text-warning me-2"></i> Quick Actions
                        </h6>
                        <small class="text-muted">Shortcuts to frequent self-service workflows</small>
                    </div>
                </div>

                <div class="card-body px-3 px-lg-4 py-3 d-flex flex-column justify-content-center">
                    <div class="row g-3">

                        <!-- 1. Apply Leave -->
                        <div class="col-12 col-sm-6">
                            <div class="quick-action-tile p-3 rounded-3 h-100"
                                 role="button"
                                 @onclick="@(() => Nav.NavigateTo("/emp-leave-management"))">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <div class="qa-icon-box bg-primary bg-opacity-10 text-primary">
                                        <i class="bi bi-calendar3"></i>
                                    </div>
                                    <i class="bi bi-chevron-right text-muted qa-arrow"></i>
                                </div>
                                <div class="fw-semibold text-dark qa-title">Apply Leave</div>
                                <small class="text-muted qa-subtitle">Submit a leave request</small>
                            </div>
                        </div>

                        <!-- 2. My Attendance -->
                        <div class="col-12 col-sm-6">
                            <div class="quick-action-tile p-3 rounded-3 h-100"
                                 role="button"
                                 @onclick="@(() => Nav.NavigateTo("/emp-attendance-management"))">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <div class="qa-icon-box bg-primary bg-opacity-10 text-primary">
                                        <i class="bi bi-clock"></i>
                                    </div>
                                    <i class="bi bi-chevron-right text-muted qa-arrow"></i>
                                </div>
                                <div class="fw-semibold text-dark qa-title">My Attendance</div>
                                <small class="text-muted qa-subtitle">View attendance history</small>
                            </div>
                        </div>

                        <!-- 3. My Requests -->
                        <div class="col-12 col-sm-6">
                            <div class="quick-action-tile p-3 rounded-3 h-100"
                                 role="button"
                                 @onclick="@(() => Nav.NavigateTo("/emp-leave-management"))">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <div class="qa-icon-box bg-purple-soft text-purple">
                                        <i class="bi bi-file-earmark-text"></i>
                                    </div>
                                    <i class="bi bi-chevron-right text-muted qa-arrow"></i>
                                </div>
                                <div class="fw-semibold text-dark qa-title">My Requests</div>
                                <small class="text-muted qa-subtitle">Track your requests</small>
                            </div>
                        </div>

                        <!-- 4. My Profile -->
                        <div class="col-12 col-sm-6">
                            <div class="quick-action-tile p-3 rounded-3 h-100"
                                 role="button"
                                 @onclick="@(() => Nav.NavigateTo("/profile"))">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <div class="qa-icon-box bg-success bg-opacity-10 text-success">
                                        <i class="bi bi-person-fill"></i>
                                    </div>
                                    <i class="bi bi-chevron-right text-muted qa-arrow"></i>
                                </div>
                                <div class="fw-semibold text-dark qa-title">My Profile</div>
                                <small class="text-muted qa-subtitle">View and update profile</small>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

    </div>

</div>

@code {
    [Parameter] public string UserFullName { get; set; } = "";
    [Parameter] public int EmployeeId { get; set; }

    // State & Flags
    private bool isLoading = true;
    private string loaderMessage = "Loading Employee Dashboard...";

    // Summary Metric values
    private string weeklyHoursDisplay = "00h 00m";
    private string monthlyHoursDisplay = "00h 00m";
    private int weeklyProgressPercent = 0;
    private int monthlyProgressPercent = 0;

    // Weekly Attendance Strip
    private List<WeeklyDayAttendanceItem> currentWeekDays = new();
    private string totalWeekHoursDisplay = "00h 00m";
    private string avgDailyHoursDisplay = "00h 00m";

    // Attendance stats
    private int attendancePercentage = 0;
    private int presentDaysCount = 0;
    private int absentDaysCount = 0;
    private int halfDaysCount = 0;
    private int leaveDaysCount = 0;

    // Leave & Request stats
    private DashboardViewModel dashboard = new();
    private List<LeaveTypeViewModel> leaveTypes = new();
    private List<LeaveRequestViewModel> myRequests = new();
    private List<LeaveRequestViewModel> recentRequests = new();
    private List<CombinedRequestItem> combinedRecentRequests = new();
    private List<LeaveBalanceViewModel> leaveBalances = new();
    private Dictionary<int, string> leaveTypeNames = new();

    private int totalBalance = 0;
    private int pendingCount = 0;
    private int totalRequestsCount = 0;

    // Holidays
    private List<FestivalHolidayViewModel> upcomingHolidays = new();

    // ═════════════════════════════════════
    // LIFECYCLE
    // ═════════════════════════════════════

    protected override async Task OnInitializedAsync()
    {
        await LoadAllDashboardDataAsync();
    }

    private async Task OnClockStatusChanged()
    {
        await LoadAllDashboardDataAsync();
        StateHasChanged();
    }

    // ═════════════════════════════════════
    // DATA LOADING
    // ═════════════════════════════════════

    private async Task LoadAllDashboardDataAsync()
    {
        try
        {
            isLoading = true;

            var dashboardTask = LoadDashboardStatsAsync();
            var attendanceTask = LoadMonthlyMetricsAsync();
            var holidayTask = LoadUpcomingHolidaysAsync();

            await Task.WhenAll(dashboardTask, attendanceTask, holidayTask);
            await LoadCombinedRecentRequestsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Dashboard] Error loading data: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadUpcomingHolidaysAsync()
    {
        try
        {
            var res = await HolidayService.GetFestivalHolidayAsync();
            if (res?.IsSuccess == true && res.Data != null && res.Data.Any())
            {
                var now = DateTime.Today;
                upcomingHolidays = res.Data
                    .Where(h => h.Date.Date >= now)
                    .OrderBy(h => h.Date)
                    .Take(4)
                    .ToList();
            }
            else
            {
                upcomingHolidays = new();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Holidays] Error: {ex.Message}");
            upcomingHolidays = new();
        }
    }

    private static string GetHolidayCountdown(DateTime date)
    {
        var days = (date.Date - DateTime.Today).Days;
        if (days == 0) return "Today";
        if (days == 1) return "Tomorrow";
        if (days < 7) return $"In {days} days";
        if (days < 30) return $"In {days / 7} {(days / 7 == 1 ? "week" : "weeks")}";
        return $"In {days / 30} {(days / 30 == 1 ? "month" : "months")}";
    }

    private string GetGreeting()
    {
        var hour = DateTime.Now.Hour;
        if (hour < 12) return "Good Morning";
        if (hour < 17) return "Good Afternoon";
        return "Good Evening";
    }

