@using arna.HRMS.Models.ViewModels.Dashboard

<div class="col-12 col-xl-7">
    <div class="dash-card h-100 d-flex flex-column">

        <!-- Card Header -->
        <div class="dash-card-header flex-wrap gap-2 justify-content-between">
            <div class="d-flex align-items-center gap-2.5">
                <div class="dash-card-icon-box" style="background: rgba(37, 99, 235, 0.12); color: #2563eb;">
                    <i class="bi bi-graph-up-arrow"></i>
                </div>
                <div>
                    <h6 class="dash-card-title mb-0 d-flex align-items-center gap-2">
                        <span>Attendance Trend</span>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill small fw-normal" style="font-size: 0.72rem;">
                            @(SelectedGranularity == "daily" ? "Daily View" : "Monthly View")
                        </span>
                    </h6>
                    <p class="dash-card-subtitle mt-0.5">
                        @(SelectedGranularity == "daily" ? "Daily attendance rate across workdays" : $"Month-by-month attendance rate for {DateTime.Today.Year}")
                    </p>
                </div>
            </div>

            <!-- Granularity & Range Selector Buttons -->
            <div class="d-flex flex-wrap align-items-center gap-2">
                <!-- Daily / Monthly Granularity Toggle -->
                <div class="btn-group btn-group-sm" role="group">
                    <button type="button" class="btn @(SelectedGranularity == "daily" ? "btn-primary shadow-xs" : "btn-light border")"
                            @onclick='() => OnGranularityChanged.InvokeAsync("daily")'>
                        <i class="bi bi-calendar-day me-1"></i> Daily
                    </button>
                    <button type="button" class="btn @(SelectedGranularity == "monthly" ? "btn-primary shadow-xs" : "btn-light border")"
                            @onclick='() => OnGranularityChanged.InvokeAsync("monthly")'>
                        <i class="bi bi-calendar-month me-1"></i> Monthly
                    </button>
                </div>

                <!-- Daily Range Sub-Pills (Visible only in Daily Mode) -->
                @if (SelectedGranularity == "daily")
                {
                    <div class="btn-group btn-group-sm" role="group">
                        <button type="button" class="btn @(SelectedRange == "this_month" ? "btn-secondary text-white" : "btn-light border text-secondary")"
                                @onclick='() => OnRangeChanged.InvokeAsync("this_month")'>
                            This Month
                        </button>
                        <button type="button" class="btn @(SelectedRange == "last_30_days" ? "btn-secondary text-white" : "btn-light border text-secondary")"
                                @onclick='() => OnRangeChanged.InvokeAsync("last_30_days")'>
                            30 Days
                        </button>
                        <button type="button" class="btn @(SelectedRange == "last_14_days" ? "btn-secondary text-white" : "btn-light border text-secondary")"
                                @onclick='() => OnRangeChanged.InvokeAsync("last_14_days")'>
                            14 Days
                        </button>
                    </div>
                }
            </div>
        </div>

        <!-- Card Body -->
        <div class="card-body p-3 p-md-4 flex-grow-1 d-flex flex-column justify-content-between">
            
            <!-- Top Summary Metric Tiles -->
            <div class="row g-2 mb-3">
                <div class="col-4">
                    <div class="p-2.5 bg-light rounded-3 text-center border h-100 d-flex flex-column justify-content-center">
                        <span class="text-muted d-block small" style="font-size: 0.72rem;">Period Avg Rate</span>
                        <span class="fw-bold text-success fs-5 my-0.5">@AvgRate%</span>
                        <span class="text-muted small" style="font-size: 0.7rem;">@(SelectedGranularity == "daily" ? "Active workdays" : "Year-to-date average")</span>
                    </div>
                </div>
                <div class="col-4">
                    <div class="p-2.5 bg-light rounded-3 text-center border h-100 d-flex flex-column justify-content-center">
                        <span class="text-muted d-block small" style="font-size: 0.72rem;">@(SelectedGranularity == "daily" ? "Peak Day" : "Peak Month")</span>
                        <span class="fw-bold text-primary fs-5 my-0.5">@PeakPercent%</span>
                        <span class="text-muted small text-truncate d-block" style="font-size: 0.7rem;" title="@PeakDay">@PeakDay</span>
                    </div>
                </div>
                <div class="col-4">
                    <div class="p-2.5 bg-light rounded-3 text-center border h-100 d-flex flex-column justify-content-center">
                        <span class="text-muted d-block small" style="font-size: 0.72rem;">Approved Leaves</span>
                        <span class="fw-bold text-warning fs-5 my-0.5">@ApprovedLeaves Days</span>
                        <span class="text-muted small" style="font-size: 0.7rem;">In selected period</span>
                    </div>
                </div>
            </div>

            <!-- Trend Wave Chart Graphic with Y-Axis Scale -->
            <div class="position-relative pt-1 px-1">
                <svg class="dash-trend-wave-svg" viewBox="0 0 600 140" preserveAspectRatio="none">
                    <defs>
                        <linearGradient id="dashWaveGradient" x1="0%" y1="0%" x2="0%" y2="100%">
                            <stop offset="0%" stop-color="#2563eb" stop-opacity="0.25" />
                            <stop offset="70%" stop-color="#2563eb" stop-opacity="0.06" />
                            <stop offset="100%" stop-color="#2563eb" stop-opacity="0.0" />
                        </linearGradient>
                    </defs>
                    
                    <!-- Horizontal Reference Grid Lines -->
                    <line x1="45" y1="22" x2="585" y2="22" stroke="#e2e8f0" stroke-width="1.2" stroke-dasharray="3,3" />
                    <line x1="45" y1="70" x2="585" y2="70" stroke="#e2e8f0" stroke-width="1.2" stroke-dasharray="3,3" />
                    <line x1="45" y1="118" x2="585" y2="118" stroke="#cbd5e1" stroke-width="1.5" />

                    <!-- Y-Axis Scale Percentage Text -->
                    <text x="38" y="26" text-anchor="end" fill="#94a3b8" font-size="11" font-weight="600">100%</text>
                    <text x="38" y="74" text-anchor="end" fill="#94a3b8" font-size="11" font-weight="600">50%</text>
                    <text x="38" y="122" text-anchor="end" fill="#94a3b8" font-size="11" font-weight="600">0%</text>

                    @if (!string.IsNullOrEmpty(SvgAreaPath))
                    {
                        <!-- Gradient Fill Area -->
                        <path d="@SvgAreaPath" fill="url(#dashWaveGradient)" />
                        
                        <!-- Smooth Curve Stroke -->
                        <path d="@SvgStrokePath" fill="none" stroke="#2563eb" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />

                        <!-- Interactive Data Point Circles with Tooltips -->
                        @foreach (var pt in TrajectoryPoints)
                        {
                            var isPeak = pt == PeakPoint;
                            var isToday = pt == TodayPoint;
                            var radius = isPeak || isToday ? 5.5 : 3.5;
                            var fill = isToday ? "#10b981" : (isPeak ? "#2563eb" : "#3b82f6");

                            <circle cx="@pt.SvgX.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)"
                                    cy="@pt.SvgY.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)"
                                    r="@radius.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)"
                                    fill="@fill"
                                    stroke="#ffffff"
                                    stroke-width="@(isPeak || isToday ? "2.5" : "1.5")"
                                    style="cursor: pointer;">
                                <title>@pt.FullTooltip</title>
                            </circle>
                        }
                    }
                    else
                    {
                        <line x1="45" y1="70" x2="585" y2="70" stroke="#cbd5e1" stroke-width="2" stroke-dasharray="4,4" />
                    }
                </svg>

                <!-- Milestone Date / Month Labels (Aligned under plot area) -->
                <div class="d-flex justify-content-between text-muted small pt-1.5" style="font-size: 0.74rem; padding-left: 42px; padding-right: 18px;">
                    @foreach (var milestone in MilestoneLabels)
                    {
                        <span>@milestone</span>
                    }
                </div>
            </div>

            <!-- Footer Insight Note -->
            <div class="d-flex align-items-center justify-content-between pt-3 border-top mt-3 small text-muted">
                <span>
                    <i class="bi bi-shield-check text-success me-1"></i>
                    Workforce attendance stability remains @(AvgRate >= 90 ? "optimal" : "moderate") across @(SelectedGranularity == "daily" ? "active workdays" : "months")
                </span>
                <a href="/report" class="text-primary text-decoration-none fw-semibold d-inline-flex align-items-center gap-1">
                    <span>Detailed Log</span>
                    <i class="bi bi-arrow-right"></i>
                </a>
            </div>

        </div>

    </div>
</div>

@code {
    [Parameter] public string SelectedGranularity { get; set; } = "daily";
    [Parameter] public string SelectedRange { get; set; } = "this_month";
    [Parameter] public double AvgRate { get; set; }
    [Parameter] public double PeakPercent { get; set; }
    [Parameter] public string PeakDay { get; set; } = string.Empty;
    [Parameter] public int ApprovedLeaves { get; set; }
    [Parameter] public string SvgAreaPath { get; set; } = string.Empty;
    [Parameter] public string SvgStrokePath { get; set; } = string.Empty;
    [Parameter] public IReadOnlyList<DailyAttendanceTrendPoint> TrajectoryPoints { get; set; } = new List<DailyAttendanceTrendPoint>();
    [Parameter] public DailyAttendanceTrendPoint? PeakPoint { get; set; }
    [Parameter] public DailyAttendanceTrendPoint? TodayPoint { get; set; }
    [Parameter] public IReadOnlyList<string> MilestoneLabels { get; set; } = new List<string>();
    [Parameter] public EventCallback<string> OnGranularityChanged { get; set; }
    [Parameter] public EventCallback<string> OnRangeChanged { get; set; }
}
