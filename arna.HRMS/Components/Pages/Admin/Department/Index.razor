@page "/department"

@using arna.HRMS.Components.Loader
@using arna.HRMS.Models.ViewModels
@using arna.HRMS.Services
@using arna.HRMS.Services.Auth
@using arna.HRMS.Services.Common

@inject NavigationManager NavigationManager
@inject IDepartmentService DepartmentService
@inject NotificationService NotificationService
@inject IJSRuntime JsRuntime
@inherits AuthenticatedLayoutBase

<Loader Visible="_isLoading" Message="@_loadingMessage" />

<div class="dept-page-container">

    <!-- ═══════════ 1. PAGE HEADER & PRIMARY ACTION ═══════════ -->
    <div class="d-flex flex-column flex-sm-row align-items-start align-items-sm-center justify-content-between gap-3 mb-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <h3 class="dept-title mb-0">Departments</h3>
                @if (!_isLoading)
                {
                    <span class="header-count-pill">
                        @_departments.Count Total
                    </span>
                }
            </div>
            <p class="dept-subtitle mb-0">Manage organization structure, operational divisions, and department hierarchy.</p>
        </div>

        <div class="d-flex align-items-center gap-2 flex-wrap">
            <button type="button" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1.5 px-3 py-2 rounded-3 shadow-xs fw-medium bg-white"
                    @onclick="LoadDepartmentsAsync" disabled="@_isLoading" title="Refresh departments">
                <i class="bi bi-arrow-clockwise @(_isLoading ? "spin-animation" : "")"></i>
                <span>Refresh</span>
            </button>

            @if (IsAdmin() || IsSuperAdmin())
            {
                <button class="btn btn-add-primary"
                        @onclick="@(() => NavigateTo("/department/create"))">
                    <i class="bi bi-plus-lg"></i>
                    <span>Add Department</span>
                </button>
            }
        </div>
    </div>

    <!-- ═══════════ 2. SEARCH & ADVANCED FILTER BAR ═══════════ -->
    <div class="dept-filter-card mb-3">
        <div class="d-flex flex-wrap align-items-center gap-3">

            <!-- Search Box -->
            <div class="filter-search-box flex-grow-1">
                <i class="bi bi-search filter-search-icon"></i>
                <input type="text"
                       class="filter-search-input"
                       placeholder="Search by department name, code, description, or parent..."
                       value="@_searchTerm"
                       @oninput="OnSearchInput" />
                @if (!string.IsNullOrWhiteSpace(_searchTerm))
                {
                    <button type="button" class="filter-clear-btn" @onclick="ClearSearch" title="Clear search">
                        <i class="bi bi-x-circle-fill"></i>
                    </button>
                }
            </div>

            <!-- Hierarchy Level Filter -->
            <div class="filter-select-wrap">
                <select class="filter-dropdown-select" value="@_selectedLevel" @onchange="OnLevelChange">
                    <option value="All">All Levels</option>
                    <option value="Root">Primary Divisions (Root)</option>
                    <option value="Sub">Sub-Departments</option>
                </select>
            </div>

            <!-- Parent Department Filter -->
            @if (ParentDepartmentOptions.Any())
            {
                <div class="filter-select-wrap">
                    <select class="filter-dropdown-select" value="@_selectedParentName" @onchange="OnParentChange">
                        <option value="">All Parent Departments</option>
                        @foreach (var parent in ParentDepartmentOptions)
                        {
                            <option value="@parent">@parent</option>
                        }
                    </select>
                </div>
            }

            <!-- Reset Filters Trigger -->
            @if (HasActiveFilters)
            {
                <div>
                    <button class="btn-filter-trigger active-filter" @onclick="ClearAllFilters" title="Reset all filters">
                        <i class="bi bi-x-lg"></i>
                        <span>Reset Filters</span>
                    </button>
                </div>
            }

        </div>
    </div>

    <!-- ═══════════ 3. DEPARTMENT DIRECTORY TABLE ═══════════ -->
    <div class="dept-grid-card">

        <!-- Context Header Banner -->
        <div class="dept-context-banner d-flex align-items-center justify-content-between px-3 py-2 bg-light border-bottom">
            <div class="d-flex align-items-center gap-2">
                <span class="status-dot-sm bg-primary"></span>
                <span class="fw-semibold text-dark small">Department Directory</span>
                <span class="text-muted small">• Organizational Structure</span>
            </div>
            <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-2.5 py-1 small fw-medium">
                @FilteredDepartments.Count department(s)
            </span>
        </div>

        <div class="dept-table-wrapper">
            @if (_isLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary mb-3" role="status"></div>
                    <p class="text-muted mb-0 small">Loading departments...</p>
                </div>
            }
            else if (!FilteredDepartments.Any())
            {
                <div class="text-center py-5 px-3">
                    <div class="d-inline-flex align-items-center justify-content-center bg-light rounded-circle p-3 mb-3 text-secondary opacity-75" style="width:64px; height:64px;">
                        <i class="bi bi-building fs-2"></i>
                    </div>
                    <h6 class="fw-bold text-dark mb-1">No Departments Found</h6>
                    <p class="text-muted small mb-3">
                        @if (HasActiveFilters)
                        {
                            <span>No departments match your active search or filter criteria.</span>
                        }
                        else
                        {
                            <span>No departments have been added to the organization yet.</span>
                        }
                    </p>
                    @if (HasActiveFilters)
                    {
                        <button class="btn btn-sm btn-outline-primary rounded-pill px-3" @onclick="ClearAllFilters">
                            <i class="bi bi-arrow-counterclockwise me-1"></i> Clear Filters
                        </button>
                    }
                    else if (IsAdmin() || IsSuperAdmin())
                    {
                        <button class="btn btn-sm btn-primary rounded-pill px-3" @onclick="@(() => NavigateTo("/department/create"))">
                            <i class="bi bi-plus-lg me-1"></i> Add First Department
                        </button>
                    }
                </div>
            }
            else
            {
                <table class="dept-modern-table">
                    <thead>
                        <tr>
                            <th style="min-width: 200px;">NAME</th>
                            <th style="width: 120px;">CODE</th>
                            <th style="min-width: 260px;">DESCRIPTION</th>
                            <th style="min-width: 180px;">PARENT DEPARTMENT</th>
                            @if (IsAdmin() || IsSuperAdmin())
                            {
                                <th style="width: 100px; text-align: center;">ACTION</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var dept in PagedDepartments)
                        {
                            <tr>
                                <!-- NAME (Icon Circle + Name) -->
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="dept-icon-circle">
                                            <i class="bi bi-building"></i>
                                        </div>
                                        <span class="dept-name text-truncate" title="@dept.Name">
                                            @dept.Name
                                        </span>
                                    </div>
                                </td>

                                <!-- CODE (Monospace badge) -->
                                <td>
                                    <span class="dept-code-badge" title="Department Code: @dept.Code">
                                        @dept.Code
                                    </span>
                                </td>

                                <!-- DESCRIPTION -->
                                <td>
                                    <span class="dept-desc-text" title="@dept.Description">
                                        @(string.IsNullOrWhiteSpace(dept.Description) ? "—" : dept.Description)
                                    </span>
                                </td>

                                <!-- PARENT DEPARTMENT -->
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(dept.ParentDepartMentName))
                                    {
                                        <span class="dept-parent-pill" title="Reports to: @dept.ParentDepartMentName">
                                            <i class="bi bi-diagram-3"></i>
                                            <span>@dept.ParentDepartMentName</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="dept-root-pill" title="Top-level primary organization division">
                                            <i class="bi bi-shield-check"></i>
                                            <span>Primary Division</span>
                                        </span>
                                    }
                                </td>

                                <!-- ACTIONS -->
                                @if (IsAdmin() || IsSuperAdmin())
                                {
                                    <td class="text-center">
                                        <div class="d-inline-flex align-items-center gap-1.5 justify-content-center">
                                            <button type="button"
                                                    class="btn-action-icon-edit"
                                                    title="Edit department"
                                                    @onclick="() => EditDepartment(dept)">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>
                                            <button type="button"
                                                    class="btn-action-icon-delete"
                                                    title="Delete department"
                                                    @onclick="() => DeleteDepartment(dept)">
                                                <i class="bi bi-trash3"></i>
                                            </button>
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <!-- ═══════════ 4. PAGINATION & SUMMARY FOOTER ═══════════ -->
        @if (!_isLoading && FilteredDepartments.Any())
        {
            <div class="dept-pagination-bar d-flex flex-column flex-sm-row align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-2 text-muted small flex-wrap">
                    <span>Showing <strong>@StartIndex</strong> to <strong>@EndIndex</strong> of <strong>@TotalCount</strong> departments</span>
                    <span class="text-black-50">•</span>
                    <div class="d-flex align-items-center gap-1.5">
                        <span>Show</span>
                        <select class="page-size-select" value="@_pageSize" @onchange="OnPageSizeChange">
                            <option value="10">10</option>
                            <option value="25">25</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                        </select>
                        <span>per page</span>
                    </div>
                </div>

                @if (TotalPages > 1)
                {
                    <div class="d-flex align-items-center gap-1">
                        <button type="button" class="page-btn" disabled="@(_currentPage <= 1)" @onclick="() => GoToPage(_currentPage - 1)" title="Previous page">
                            <i class="bi bi-chevron-left"></i>
                        </button>

                        @for (int p = 1; p <= TotalPages; p++)
                        {
                            var pageNum = p;
                            <button type="button" class="page-btn @(pageNum == _currentPage ? "active" : "")" @onclick="() => GoToPage(pageNum)">
                                @pageNum
                            </button>
                        }

                        <button type="button" class="page-btn" disabled="@(_currentPage >= TotalPages)" @onclick="() => GoToPage(_currentPage + 1)" title="Next page">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                }
            </div>
        }

    </div>

</div>

@code {

    // ═══════════ STATE ═══════════
    private List<DepartmentViewModel> _departments = new();
    private bool _isLoading = true;
    private string _loadingMessage = "Loading departments...";

    // Filters
    private string? _searchTerm;
    private string _selectedLevel = "All";
    private string _selectedParentName = "";

    // Pagination
    private int _currentPage = 1;
    private int _pageSize = 10;

    // ═══════════ COMPUTED ═══════════
    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(_searchTerm) ||
        _selectedLevel != "All" ||
        !string.IsNullOrWhiteSpace(_selectedParentName);

    private List<string> ParentDepartmentOptions =>
        _departments
            .Where(d => !string.IsNullOrWhiteSpace(d.ParentDepartMentName))
            .Select(d => d.ParentDepartMentName!.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(n => n)
            .ToList();

    private List<DepartmentViewModel> FilteredDepartments
    {
        get
        {
            var query = _departments.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                var term = _searchTerm.Trim();
                query = query.Where(d =>
                    MatchesSearch(d.Name, term) ||
                    MatchesSearch(d.Code, term) ||
                    MatchesSearch(d.Description, term) ||
                    MatchesSearch(d.ParentDepartMentName, term));
            }

            if (_selectedLevel == "Root")
            {
                query = query.Where(d => string.IsNullOrWhiteSpace(d.ParentDepartMentName));
            }
            else if (_selectedLevel == "Sub")
            {
                query = query.Where(d => !string.IsNullOrWhiteSpace(d.ParentDepartMentName));
            }

            if (!string.IsNullOrWhiteSpace(_selectedParentName))
            {
                query = query.Where(d => string.Equals(d.ParentDepartMentName, _selectedParentName, StringComparison.OrdinalIgnoreCase));
            }

            return query.ToList();
        }
    }

    private int TotalCount => FilteredDepartments.Count;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling((double)TotalCount / _pageSize));
    private int StartIndex => TotalCount == 0 ? 0 : (_currentPage - 1) * _pageSize + 1;
    private int EndIndex => Math.Min(_currentPage * _pageSize, TotalCount);

    private List<DepartmentViewModel> PagedDepartments =>
        FilteredDepartments.Skip((_currentPage - 1) * _pageSize).Take(_pageSize).ToList();

    // ═══════════ LIFECYCLE ═══════════
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await LoadDepartmentsAsync();
    }

    // ═══════════ DATA LOADING ═══════════
    private async Task LoadDepartmentsAsync()
    {
        _isLoading = true;

        var result = await DepartmentService.GetDepartmentsAsync();

        if (result?.IsSuccess == true && result.Data != null)
        {
            _departments = result.Data;
        }
        else if (result != null && !result.IsSuccess)
        {
            await NotificationService.Error(result.Message ?? "Failed to load departments");
            _departments = new List<DepartmentViewModel>();
        }
        else
        {
            _departments = new List<DepartmentViewModel>();
        }

        _isLoading = false;
    }

    // ═══════════ FILTER & PAGINATION HANDLERS ═══════════
    private void OnSearchInput(ChangeEventArgs e)
    {
        _searchTerm = e.Value?.ToString();
        _currentPage = 1;
    }

    private void ClearSearch()
    {
        _searchTerm = null;
        _currentPage = 1;
    }

    private void OnLevelChange(ChangeEventArgs e)
    {
        _selectedLevel = e.Value?.ToString() ?? "All";
        _currentPage = 1;
    }

    private void OnParentChange(ChangeEventArgs e)
    {
        _selectedParentName = e.Value?.ToString() ?? "";
        _currentPage = 1;
    }

    private void ClearAllFilters()
    {
        _searchTerm = null;
        _selectedLevel = "All";
        _selectedParentName = "";
        _currentPage = 1;
    }

    private void OnPageSizeChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var size) && size > 0)
        {
            _pageSize = size;
            _currentPage = 1;
        }
    }

    private void GoToPage(int page)
    {
        _currentPage = Math.Clamp(page, 1, TotalPages);
    }

    // ═══════════ NAVIGATION & ACTIONS ═══════════
    private void NavigateTo(string route)
        => NavigationManager.NavigateTo(route);

    private void EditDepartment(DepartmentViewModel model)
        => NavigationManager.NavigateTo($"/department/edit/{model.Id}");

    private async Task DeleteDepartment(DepartmentViewModel model)
    {
        var confirmed = await JsRuntime.InvokeAsync<bool>(
            "confirm", $"Are you sure you want to delete the '{model.Name}' department?");

        if (!confirmed) return;

        var result = await DepartmentService.DeleteDepartmentAsync(model.Id);

        if (result?.IsSuccess != true)
        {
            await NotificationService.Error(result?.Message ?? "Unable to delete department.");
            return;
        }

        await NotificationService.Success("Department deleted successfully.");
        await LoadDepartmentsAsync();
    }

    private static bool MatchesSearch(string? value, string term)
        => !string.IsNullOrWhiteSpace(value) &&
           value.Contains(term, StringComparison.OrdinalIgnoreCase);
}
