@page "/employee/create"
@page "/employee/edit/{Id:int}"

@using arna.HRMS.Components.Loader
@using arna.HRMS.Components.lib.components.ui.Forms
@using arna.HRMS.Components.lib.components.ui.Model
@using arna.HRMS.Models.Enums
@using arna.HRMS.Models.ViewModels
@using arna.HRMS.Services
@using arna.HRMS.Services.Common

@inject IEmployeeService EmployeeService
@inject IDepartmentService DepartmentService
@inject NavigationManager NavigationManager
@inject NotificationService NotificationService

<AppFormLayout>
    <!-- ═══════════ 1. HEADER CARD ═══════════ -->
    <AppFormHeader Title="@(IsEditMode ? "Edit Employee" : "Add New Employee")"
                   Subtitle="@(IsEditMode ? $"Update employee records, compensation, and departmental placement for {_employee.FullName}." : "Register a new employee record and configure employment terms.")"
                   Icon="@(IsEditMode ? "bi-pencil-square" : "bi-person-vcard")"
                   OnBack="GoBack" />

    @if (_isLoading)
    {
        <div class="card border-0 shadow-sm rounded-3 text-center py-5">
            <div class="spinner-border text-primary mb-3" role="status"></div>
            <p class="text-muted mb-0 small">Loading employee data…</p>
        </div>
    }
    else
    {
        <EditForm Model="_employee" OnValidSubmit="HandleValidSubmit" class="erp-form-flex-container">
            <DataAnnotationsValidator />

            <!-- ═══════════ 2. FORM BODY ═══════════ -->
            <div class="erp-form-scrollable-body">

                <!-- 1. Personal Details Section -->
                <AppFormSection Title="Personal Details"
                                Subtitle="Legal name, contact information, and personal email"
                                Icon="bi-person">
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <AppInput Label="First Name"
                                      Icon="bi-person"
                                      IsRequired="true"
                                      Placeholder="e.g. John"
                                      @bind-Value="_employee.FirstName"
                                      ValidationExpression="() => _employee.FirstName" />
                        </div>

                        <div class="col-12 col-md-6">
                            <AppInput Label="Last Name"
                                      Icon="bi-person"
                                      IsRequired="true"
                                      Placeholder="e.g. Doe"
                                      @bind-Value="_employee.LastName"
                                      ValidationExpression="() => _employee.LastName" />
                        </div>

                        <div class="col-12 col-md-6">
                            <AppInput Label="Personal Email"
                                      Icon="bi-envelope"
                                      Type="email"
                                      IsRequired="true"
                                      Placeholder="e.g. john.doe@personal.com"
                                      @bind-Value="_employee.Email"
                                      ValidationExpression="() => _employee.Email" />
                        </div>

                        <div class="col-12 col-md-6">
                            <AppInput Label="Phone Number"
                                      Icon="bi-telephone"
                                      IsRequired="true"
                                      Placeholder="e.g. 9876543210"
                                      @bind-Value="_employee.PhoneNumber"
                                      ValidationExpression="() => _employee.PhoneNumber" />
                        </div>

                        <div class="col-12 col-md-6">
                            <AppDatePicker Label="Date of Birth"
                                           Icon="bi-calendar-date"
                                           IsRequired="true"
                                           Value="_employee.DateOfBirth"
                                           ValueChanged="d => _employee.DateOfBirth = d ?? default"
                                           ValidationExpression="() => _employee.DateOfBirth" />
                        </div>
                    </div>
                </AppFormSection>

                <!-- 2. Employment & Placement Section -->
                <AppFormSection Title="Employment & Placement"
                                Subtitle="Designation, department, reporting manager, work email, and compensation"
                                Icon="bi-briefcase">
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <AppSelect Label="Designation"
                                       Icon="bi-briefcase"
                                       IsRequired="true"
                                       Placeholder="Select Designation"
                                       Options="_designationOptions"
                                       Value="@(_employee.Designation?.ToString() ?? "")"
                                       ValueChanged="OnPositionChanged"
                                       ValidationExpression="() => _employee.Designation" />
                        </div>

                        <div class="col-12 col-md-6">
                            <AppInput Label="Office Email"
                                      Icon="bi-envelope-at"
                                      Type="email"
                                      IsRequired="true"
                                      Placeholder="e.g. john.doe@company.com"
                                      @bind-Value="_employee.OfficeEmail"
                                      ValidationExpression="() => _employee.OfficeEmail" />
                        </div>

                        <div class="col-12 col-md-6">
                            <AppSelect Label="Department"
                                       Icon="bi-building"
                                       IsRequired="true"
                                       Placeholder="Select Department"
                                       Options="_departmentOptions"
                                       Value="@(_employee.DepartmentId?.ToString() ?? "")"
                                       ValueChanged="v => _employee.DepartmentId = ParseNullableInt(v)"
                                       ValidationExpression="() => _employee.DepartmentId" />
                        </div>

                        <div class="col-12 col-md-6">
                            <AppSelect Label="Manager (Reporting To)"
                                       Icon="bi-person-gear"
                                       Placeholder="No Manager (Direct Report)"
                                       Options="_managerOptions"
                                       Value="@(_employee.ManagerId?.ToString() ?? "")"
                                       ValueChanged="v => _employee.ManagerId = ParseNullableInt(v)"
                                       ValidationExpression="() => _employee.ManagerId" />
                        </div>

                        <div class="col-12 col-md-6">
                            <AppDatePicker Label="Hire Date"
                                           Icon="bi-calendar-check"
                                           IsRequired="true"
                                           Value="_employee.HireDate"
                                           ValueChanged="d => _employee.HireDate = d ?? default"
                                           ValidationExpression="() => _employee.HireDate" />
                        </div>

                        <div class="col-12 col-md-6">
                            <AppNumberInput TValue="decimal"
                                            Label="Salary"
                                            Icon="bi-currency-dollar"
                                            IsRequired="true"
                                            Placeholder="0.00"
                                            Step="0.01"
                                            @bind-Value="_employee.Salary"
                                            ValidationExpression="() => _employee.Salary" />
                        </div>
                    </div>
                </AppFormSection>

                <!-- 3. Status Settings Section -->
                <AppFormSection Title="Status Settings" Icon="bi-toggle-on">
                    <AppSwitch @bind-Value="_employee.IsActive"
                               Label="Active Employee"
                               HelpText="Active employees are eligible for payroll, shift scheduling, and attendance logging." />
                </AppFormSection>

            </div>

            <!-- ═══════════ 3. FIXED FOOTER ACTIONS ═══════════ -->
            <AppFormFooter IsSubmitting="_isSubmitting"
                           SubmitText="@(IsEditMode ? "Save Changes" : "Save Employee")"
                           OnCancel="GoBack" />
        </EditForm>
    }
</AppFormLayout>

@code {

    // ═══════════ PARAMETERS ═══════════

    [Parameter] public int? Id { get; set; }

    // ═══════════ STATE ═══════════

    private EmployeeViewModel _employee = new();
    private bool _isLoading = true;
    private bool _isSubmitting;
    private bool IsEditMode => Id.HasValue;

    private List<SelectOption> _departmentOptions = new();
    private List<SelectOption> _managerOptions = new();
    private List<SelectOption> _designationOptions = new();

    // ═══════════ LIFECYCLE ═══════════

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;

        await Task.WhenAll(
            LoadDepartments(),
            LoadManagers(),
            LoadEmployeeIfEditing()
        );

        LoadPositionOptions();

        if (!IsEditMode && _employee.DateOfBirth == default)
        {
            _employee.DateOfBirth = DateTime.Today.AddYears(-22);
            _employee.HireDate = DateTime.Today;
            _employee.IsActive = true;
        }

        _isLoading = false;
    }

    // ═══════════ DATA LOADING ═══════════

    private async Task LoadDepartments()
    {
        var result = await DepartmentService.GetDepartmentsAsync();

        _departmentOptions = result is { IsSuccess: true, Data: not null }
            ? result.Data
                .Where(d => d.IsActive || d.Id == _employee.DepartmentId)
                .Select(d => new SelectOption { Value = d.Id.ToString(), Text = d.Name })
                .ToList()
            : new();
    }

    private async Task LoadManagers()
    {
        var result = await EmployeeService.GetEmployeesAsync();

        _managerOptions = result is { IsSuccess: true, Data: not null }
            ? result.Data
                .Where(e => (!Id.HasValue || e.Id != Id.Value) && (e.IsActive || e.Id == _employee.ManagerId))
                .Select(e => new SelectOption { Value = e.Id.ToString(), Text = e.FullName })
                .ToList()
            : new();
    }

    private async Task LoadEmployeeIfEditing()
    {
        if (!IsEditMode)
        {
            _employee = new EmployeeViewModel
            {
                IsActive = true,
                DateOfBirth = DateTime.Today.AddYears(-22),
                HireDate = DateTime.Today
            };
            return;
        }

        var result = await EmployeeService.GetEmployeeByIdAsync(Id!.Value);

        if (result is not { IsSuccess: true, Data: not null })
        {
            await NotificationService.Error(result?.Message ?? "Employee not found.");
            NavigationManager.NavigateTo("/employee");
            return;
        }

        _employee = result.Data;

        if (!string.IsNullOrWhiteSpace(_employee.Position) &&
            Enum.TryParse<EmployeePosition>(_employee.Position, out var position))
        {
            _employee.Designation = position;
        }
    }

    private void LoadPositionOptions()
    {
        _designationOptions = Enum.GetValues<EmployeePosition>()
            .Select(p => new SelectOption { Value = p.ToString(), Text = p.ToString() })
            .ToList();
    }

    // ═══════════ FORM SUBMIT ═══════════

    private async Task HandleValidSubmit()
    {
        _isSubmitting = true;
        StateHasChanged();

        try
        {
            _employee.Position = _employee.Designation?.ToString() ?? string.Empty;

            bool isSuccess;
            string? errorMessage;

            if (IsEditMode)
            {
                var result = await EmployeeService.UpdateEmployeeAsync(Id!.Value, _employee);
                isSuccess = result.IsSuccess;
                errorMessage = result.Message;
            }
            else
            {
                var result = await EmployeeService.CreateEmployeeAsync(_employee);
                isSuccess = result.IsSuccess;
                errorMessage = result.Message;
            }

            if (!isSuccess)
            {
                await NotificationService.Error(errorMessage ?? (IsEditMode ? "Unable to update employee." : "Unable to create employee."));
                return;
            }

            await NotificationService.Success(IsEditMode ? "Employee updated successfully." : "Employee created successfully.");
            NavigationManager.NavigateTo("/employee");
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    // ═══════════ EVENT HANDLERS ═══════════

    private void OnPositionChanged(string? value)
    {
        if (!string.IsNullOrEmpty(value) && Enum.TryParse<EmployeePosition>(value, out var position))
        {
            _employee.Designation = position;
            _employee.Position = position.ToString();
        }
    }

    private void GoBack() => NavigationManager.NavigateTo("/employee");

    // ═══════════ HELPERS ═══════════

    private static int? ParseNullableInt(string? value)
        => int.TryParse(value, out var result) ? result : null;
}