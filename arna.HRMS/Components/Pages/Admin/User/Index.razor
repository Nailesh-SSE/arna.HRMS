@page "/user"

@using arna.HRMS.Components.Loader
@using arna.HRMS.Components.lib.components.ui.Forms
@using arna.HRMS.Models.Common.Table
@using arna.HRMS.Models.ViewModels
@using arna.HRMS.Services
@using arna.HRMS.Services.Auth
@using arna.HRMS.Services.Common

@inject IUserService UsersService
@inject IRoleService RoleService
@inject NavigationManager NavigationManager
@inject IJSRuntime JsRuntime
@inject NotificationService NotificationService
@inherits AuthenticatedLayoutBase

<Loader Visible="_isLoading" Message="@_loadingMessage" />

<div class="user-page-container">

    <!-- ═══════════ 1. PAGE HEADER ═══════════ -->
    <div class="d-flex flex-column flex-sm-row align-items-start align-items-sm-center justify-content-between gap-3 mb-4">
        <div>
            <h3 class="user-title mb-1">Users</h3>
            <p class="user-subtitle mb-0">Manage system users, access credentials, and assigned roles.</p>
        </div>

        @if (IsAdmin() || IsSuperAdmin())
        {
            <button class="btn btn-add-primary"
                    @onclick="@(() => NavigateTo("/user/create"))">
                <i class="bi bi-plus-lg"></i>
                <span>Add User</span>
            </button>
        }
    </div>

    <!-- ═══════════ 2. FILTER & SEARCH BAR ═══════════ -->
    <div class="user-filter-card mb-4">
        <div class="d-flex flex-wrap align-items-center gap-3">
            
            <!-- Search Box -->
            <div class="filter-search-box">
                <i class="bi bi-search filter-search-icon"></i>
                <input type="text"
                       class="filter-search-input"
                       placeholder="Search by name, email, or username..."
                       @bind="_searchTerm"
                       @bind:event="oninput" />
            </div>

            <!-- Role Filter -->
            <div>
                <select class="filter-dropdown-select" @bind="_selectedRole">
                    <option value="">All Roles</option>
                    @foreach (var role in _roles)
                    {
                        <option value="@role.Name">@role.Name</option>
                    }
                </select>
            </div>

            <!-- Status Filter -->
            <div>
                <select class="filter-dropdown-select" @bind="_selectedStatus">
                    <option value="All">All Status</option>
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                </select>
            </div>

            <!-- Reset / Clear Filters -->
            @if (HasActiveFilters)
            {
                <div>
                    <button class="btn-filter-trigger active-filter" @onclick="ClearAllFilters" title="Reset all filters">
                        <i class="bi bi-x-circle"></i>
                        <span>Reset</span>
                    </button>
                </div>
            }
            else
            {
                <div>
                    <button class="btn-filter-trigger" @onclick="() => {}">
                        <i class="bi bi-funnel"></i>
                        <span>Filters</span>
                    </button>
                </div>
            }

        </div>
    </div>

    <!-- ═══════════ 3. USERS GRID CARD ═══════════ -->
    <div class="user-grid-card">
        <div class="user-table-wrapper">
            @if (_isLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary mb-3" role="status"></div>
                    <p class="text-muted mb-0 small">Loading users...</p>
                </div>
            }
            else if (!FilteredUsers.Any())
            {
                <div class="text-center py-5 px-3">
                    <div class="d-inline-flex align-items-center justify-content-center bg-light rounded-circle p-3 mb-3 text-secondary opacity-75" style="width:64px; height:64px;">
                        <i class="bi bi-person-gear fs-2"></i>
                    </div>
                    <h6 class="fw-bold text-dark mb-1">No Users Found</h6>
                    <p class="text-muted small mb-3">
                        @if (HasActiveFilters)
                        {
                            <span>No user records match the selected filters.</span>
                        }
                        else
                        {
                            <span>No system user accounts have been added yet.</span>
                        }
                    </p>
                    @if (HasActiveFilters)
                    {
                        <button class="btn btn-sm btn-outline-primary rounded-pill px-3" @onclick="ClearAllFilters">
                            <i class="bi bi-arrow-counterclockwise me-1"></i> Clear Filters
                        </button>
                    }
                    else if (IsAdmin() || IsSuperAdmin())
                    {
                        <button class="btn btn-sm btn-primary rounded-pill px-3" @onclick="@(() => NavigateTo("/user/create"))">
                            <i class="bi bi-plus-lg me-1"></i> Add First User
                        </button>
                    }
                </div>
            }
            else
            {
                <AppTable TItem="UserViewModel"
                          Items="FilteredUsers"
                          Columns="TableSchemas.Users"
                          EnablePagination="true"
                          PageSize="_pageSize"
                          ShowActions="@(IsAdmin() || IsSuperAdmin())"
                          OnEdit="EditUser"
                          OnDelete="DeleteUser" />
            }
        </div>
    </div>

</div>

@code {
    // ═══════════ STATE ═══════════
    private List<UserViewModel> _users = new();
    private List<RoleViewModel> _roles = new();

    private bool _isLoading = true;
    private string _loadingMessage = "Loading users...";

    // Filters
    private string? _searchTerm;
    private string _selectedRole = "";
    private string _selectedStatus = "All";

    // Pagination
    private int _pageSize = 10;

    // ═══════════ COMPUTED ═══════════
    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(_searchTerm) ||
        !string.IsNullOrWhiteSpace(_selectedRole) ||
        _selectedStatus != "All";

    private List<UserViewModel> FilteredUsers
    {
        get
        {
            var query = _users.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                query = query.Where(u =>
                    MatchesSearch(u.Username) ||
                    MatchesSearch(u.Email) ||
                    MatchesSearch(u.FirstName) ||
                    MatchesSearch(u.LastName) ||
                    MatchesSearch(u.FullName) ||
                    MatchesSearch(u.EmployeeName));
            }

            if (!string.IsNullOrWhiteSpace(_selectedRole))
            {
                query = query.Where(u => string.Equals(u.Role, _selectedRole, StringComparison.OrdinalIgnoreCase));
            }

            if (_selectedStatus == "Active")
            {
                query = query.Where(u => u.IsActive);
            }
            else if (_selectedStatus == "Inactive")
            {
                query = query.Where(u => !u.IsActive);
            }

            return query.ToList();
        }
    }

    // ═══════════ LIFECYCLE ═══════════
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await LoadDataAsync();
    }

    // ═══════════ DATA LOADING ═══════════
    private async Task LoadDataAsync()
    {
        _isLoading = true;

        try
        {
            var userTask = UsersService.GetUsersAsync();
            var roleTask = RoleService.GetRolesAsync();

            await Task.WhenAll(userTask, roleTask);

            var userResult = await userTask;
            var roleResult = await roleTask;

            if (userResult.IsSuccess && userResult.Data != null)
            {
                _users = userResult.Data;
            }
            else
            {
                _users = new();
                await NotificationService.Error(userResult.Message ?? "Failed to load users");
            }

            if (roleResult.IsSuccess && roleResult.Data != null)
            {
                _roles = roleResult.Data.Where(r => r.IsActive).OrderBy(r => r.Name).ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[UserGrid] Error loading: {ex.Message}");
            await NotificationService.Error("An error occurred while loading users.");
            _users = new();
        }
        finally
        {
            _isLoading = false;
        }
    }

    // ═══════════ EVENTS & HELPERS ═══════════
    private void NavigateTo(string route) => NavigationManager.NavigateTo(route);

    private void EditUser(UserViewModel model)
        => NavigationManager.NavigateTo($"/user/edit/{model.Id}");

    private async Task DeleteUser(UserViewModel model)
    {
        var confirmed = await JsRuntime.InvokeAsync<bool>(
            "confirm", $"Are you sure you want to delete user {model.Username}?");

        if (!confirmed) return;

        var result = await UsersService.DeleteUserAsync(model.Id);

        if (!result.IsSuccess)
        {
            await NotificationService.Error(result.Message ?? "Unable to delete user.");
            return;
        }

        await NotificationService.Success("User deleted successfully.");
        await LoadDataAsync();
    }

    private void ClearAllFilters()
    {
        _searchTerm = null;
        _selectedRole = "";
        _selectedStatus = "All";
    }

    private bool MatchesSearch(string? value)
        => !string.IsNullOrWhiteSpace(value) &&
           value.Contains(_searchTerm!, StringComparison.OrdinalIgnoreCase);
}