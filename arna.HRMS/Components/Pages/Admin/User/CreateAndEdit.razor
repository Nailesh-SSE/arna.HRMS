@page "/user/create"
@page "/user/edit/{Id:int}"

@using arna.HRMS.Components.Loader
@using arna.HRMS.Components.lib.components.ui.Forms
@using arna.HRMS.Components.lib.components.ui.Model
@using arna.HRMS.Models.Enums
@using arna.HRMS.Models.ViewModels
@using arna.HRMS.Services
@using arna.HRMS.Services.Common

@inject IUserService UsersService
@inject IEmployeeService EmployeeService
@inject NavigationManager NavigationManager
@inject NotificationService NotificationService
@inject IRoleService RoleService

<AppFormLayout>
    <!-- ═══════════ 1. HEADER CARD ═══════════ -->
    <AppFormHeader Title="@(IsEditMode ? "Edit User" : "Add New User")"
                   Subtitle="@(IsEditMode ? $"Update credentials and role permissions for {user.Username}." : "Create a new user account, assign roles, and configure system permissions.")"
                   Icon="@(IsEditMode ? "bi-pencil-square" : "bi-person-badge")"
                   OnBack="GoBack" />

    @if (_isLoading)
    {
        <div class="card border-0 shadow-sm rounded-3 text-center py-5">
            <div class="spinner-border text-primary mb-3" role="status"></div>
            <p class="text-muted mb-0 small">Loading user data…</p>
        </div>
    }
    else
    {
        <EditForm Model="user" OnValidSubmit="HandleValidSubmit" class="erp-form-flex-container">
            <DataAnnotationsValidator />

            <!-- ═══════════ 2. FORM BODY ═══════════ -->
            <div class="erp-form-scrollable-body">

                <!-- 1. Personal Details Section -->
                <AppFormSection Title="Personal Details"
                                Subtitle="Basic user identification and contact information"
                                Icon="bi-person">
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <AppInput Label="First Name"
                                      Icon="bi-person"
                                      IsRequired="true"
                                      Placeholder="Enter first name"
                                      @bind-Value="user.FirstName"
                                      ValidationExpression="() => user.FirstName" />
                        </div>

                        <div class="col-12 col-md-6">
                            <AppInput Label="Last Name"
                                      Icon="bi-person"
                                      IsRequired="true"
                                      Placeholder="Enter last name"
                                      @bind-Value="user.LastName"
                                      ValidationExpression="() => user.LastName" />
                        </div>

                        <div class="col-12 col-md-6">
                            <AppInput Label="Phone Number"
                                      Icon="bi-telephone"
                                      IsRequired="true"
                                      Placeholder="e.g. 9876543210"
                                      @bind-Value="user.PhoneNumber"
                                      ValidationExpression="() => user.PhoneNumber" />
                        </div>
                    </div>
                </AppFormSection>

                <!-- 2. Account & Credentials Section -->
                <AppFormSection Title="Account & Credentials"
                                Subtitle="System login credentials, role assignment, and employee linkage"
                                Icon="bi-shield-lock">
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <AppInput Label="Username"
                                      Icon="bi-person-badge"
                                      IsRequired="true"
                                      Placeholder="e.g. john.doe"
                                      @bind-Value="user.Username"
                                      ValidationExpression="() => user.Username" />
                        </div>

                        <div class="col-12 col-md-6">
                            <AppInput Label="Email Address"
                                      Icon="bi-envelope"
                                      Type="email"
                                      IsRequired="true"
                                      Placeholder="admin@company.com"
                                      @bind-Value="user.Email"
                                      ValidationExpression="() => user.Email" />
                        </div>

                        <div class="col-12 col-md-6">
                            <AppSelect Label="Role"
                                       Icon="bi-shield-check"
                                       IsRequired="true"
                                       Placeholder="Select Role"
                                       Options="roles"
                                       Value="@(user.RoleId?.ToString() ?? "")"
                                       ValueChanged="v => user.RoleId = int.TryParse(v, out var r) ? r : null"
                                       ValidationExpression="() => user.RoleId" />
                        </div>

                        <div class="col-12 col-md-6">
                            <AppSelect Label="Linked Employee"
                                       Icon="bi-person-vcard"
                                       Placeholder="No Employee Linked"
                                       Options="_employeeOption"
                                       Value="@(user.EmployeeId?.ToString() ?? "")"
                                       ValueChanged="v => user.EmployeeId = int.TryParse(v, out var emp) ? emp : null"
                                       ValidationExpression="() => user.EmployeeId" />
                        </div>

                        <div class="col-12 col-md-6">
                            <AppPasswordInput Label="Password"
                                              Icon="bi-lock"
                                              IsRequired="@(!IsEditMode)"
                                              Placeholder="@(IsEditMode ? "Leave blank to keep existing password" : "Enter password")"
                                              @bind-Value="user.Password"
                                              ValidationExpression="() => user.Password" />
                        </div>
                    </div>
                </AppFormSection>

                <!-- 3. Status Settings Section -->
                <AppFormSection Title="Status Settings" Icon="bi-toggle-on">
                    <AppSwitch @bind-Value="user.IsActive"
                               Label="Active Account"
                               HelpText="Enable this account to allow system login." />
                </AppFormSection>


            </div>

            <!-- ═══════════ 3. FIXED FOOTER ACTIONS ═══════════ -->
            <AppFormFooter IsSubmitting="_isSubmitting"
                           SubmitText="@(IsEditMode ? "Save Changes" : "Save User")"
                           OnCancel="GoBack" />
        </EditForm>
    }
</AppFormLayout>

@code {

    // ═══════════ PARAMETERS ═══════════

    [Parameter] public int? Id { get; set; }

    // ═══════════ STATE ═══════════

    private UserViewModel user = new();
    private bool _isLoading = true;
    private bool _isSubmitting;
    private bool IsEditMode => Id.HasValue;
    private List<EmployeeViewModel> employees = new();
    private List<SelectOption> roles = new();
    private List<SelectOption> _employeeOption = new();

    // ═══════════ LIFECYCLE ═══════════

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;

        await Task.WhenAll(
            LoadEmployees(),
            LoadRoles(),
            LoadUserIfEditing()
        );

        _isLoading = false;
    }

    // ═══════════ DATA LOADING ═══════════

    private async Task LoadEmployees()
    {
        var result = await EmployeeService.GetEmployeesAsync();

        employees = result is { IsSuccess: true, Data: not null }
            ? result.Data
            : new();

        _employeeOption = result is { IsSuccess: true, Data: not null }
            ? result.Data
                .Where(e => e.IsActive || e.Id == user.EmployeeId)
                .Select(e => new SelectOption { Value = e.Id.ToString(), Text = e.FullName })
                .ToList()
            : new();
    }

    private async Task LoadRoles()
    {
        var result = await RoleService.GetRolesAsync();

        roles = result is { IsSuccess: true, Data: not null }
            ? result.Data
                .Where(r => r.IsActive || r.Id == user.RoleId)
                .Select(r => new SelectOption { Value = r.Id.ToString(), Text = r.Name })
                .ToList()
            : new();
    }

    private async Task LoadUserIfEditing()
    {
        if (!IsEditMode)
        {
            user = new UserViewModel { IsActive = true };
            return;
        }

        var result = await UsersService.GetUserByIdAsync(Id!.Value);

        if (result is not { IsSuccess: true, Data: not null })
        {
            await NotificationService.Error(result?.Message ?? "User not found.");
            NavigationManager.NavigateTo("/user");
            return;
        }

        user = result.Data;
    }

    // ═══════════ FORM SUBMIT ═══════════

    private async Task HandleValidSubmit()
    {
        _isSubmitting = true;
        StateHasChanged();

        try
        {
            if (!IsEditMode && string.IsNullOrWhiteSpace(user.Password))
            {
                await NotificationService.Error("Password is required for new user accounts.");
                return;
            }

            if (!string.IsNullOrWhiteSpace(user.Password) && user.Password.Length < 6)
            {
                await NotificationService.Error("Password must be at least 6 characters.");
                return;
            }

            bool isSuccess;
            string? errorMessage;

            if (IsEditMode)
            {
                var result = await UsersService.UpdateUserAsync(Id!.Value, user);
                isSuccess = result.IsSuccess;
                errorMessage = result.Message;
            }
            else
            {
                var result = await UsersService.CreateUserAsync(user);
                isSuccess = result.IsSuccess;
                errorMessage = result.Message;
            }

            if (!isSuccess)
            {
                await NotificationService.Error(errorMessage ??
                (IsEditMode ? "Unable to update user." : "Unable to create user."));
                return;
            }

            await NotificationService.Success(IsEditMode ? "User updated successfully." : "User created successfully.");
            NavigationManager.NavigateTo("/user");
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    // ═══════════ NAVIGATION ═══════════

    private void GoBack() => NavigationManager.NavigateTo("/user");
}