@using arna.HRMS.Components.lib.components.ui.Forms
@using arna.HRMS.Components.lib.components.ui.CommonComponent
@using arna.HRMS.Models.Common.Table
@using arna.HRMS.Models.ViewModels.Leave
@using arna.HRMS.Services
@using arna.HRMS.Services.Auth
@using arna.HRMS.Services.Common

@inject ILeaveService LeaveService
@inject NotificationService NotificationService
@inject NavigationManager NavigationManager
@inject IJSRuntime JsRuntime
@inherits AuthenticatedLayoutBase

<!-- TOOLBAR -->
<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <div>
        <h5 class="fw-bold mb-1 d-flex align-items-center gap-2">
            <span class="p-2 rounded-2 bg-primary bg-opacity-10 text-primary d-inline-flex align-items-center justify-content-center" style="width: 34px; height: 34px;">
                <i class="bi bi-bookmark-check-fill"></i>
            </span>
            Leave Types
        </h5>
        <small class="text-muted">Configure corporate leave policies, annual allowances, and entitlements</small>
    </div>
    @if (IsAdmin() || IsSuperAdmin())
    {
        <button class="btn btn-primary rounded-pill px-3 shadow-sm d-inline-flex align-items-center gap-2"
                @onclick="CreateLeaveType">
            <i class="bi bi-plus-lg"></i>
            <span>Add Leave Type</span>
        </button>
    }
</div>

<!-- LEAVE TYPE CARDS -->
@if (leaveTypes.Any())
{
    <div class="row g-3 mb-4">
        @foreach (var (lt, idx) in leaveTypes.Select((l, i) => (l, i)))
        {
            var color = GetColor(idx);

            <div class="col-sm-6 col-lg-4 col-xl-3">
                <div class="card border-0 shadow-sm rounded-3 h-100 leave-type-card-hover" style="border: 1px solid #f1f5f9 !important;">
                    <div class="card-body d-flex flex-column p-3">

                        <!-- Header -->
                        <div class="d-flex align-items-start justify-content-between mb-3">
                            <div class="leave-type-icon bg-@color bg-opacity-10 rounded-2 p-2 d-inline-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                <i class="bi bi-calendar-check text-@color fs-5"></i>
                            </div>
                            @if (IsAdmin() || IsSuperAdmin())
                            {
                                <div class="d-flex align-items-center gap-1">
                                    <button class="btn btn-sm btn-light rounded-circle text-primary"
                                            title="Edit"
                                            style="width: 32px; height: 32px; padding: 0; display: inline-flex; align-items: center; justify-content: center;"
                                            @onclick="() => EditLeaveType(lt.Id)">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-sm btn-light rounded-circle text-danger"
                                            title="Delete"
                                            style="width: 32px; height: 32px; padding: 0; display: inline-flex; align-items: center; justify-content: center;"
                                            @onclick="() => DeleteLeaveType(lt)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            }
                        </div>

                        <!-- Name -->
                        <h6 class="fw-bold mb-2 text-dark">@FormatName(lt.LeaveNameId.ToString())</h6>

                        <!-- Info Badges -->
                        <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
                            <span class="badge bg-@color bg-opacity-10 text-@color fw-semibold">
                                @lt.MaxPerYear days/year
                            </span>
                            @if (lt.IsPaid)
                            {
                                <span class="badge bg-success bg-opacity-10 text-success">
                                    <i class="bi bi-cash me-1"></i>Paid
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary bg-opacity-10 text-secondary">
                                    Unpaid
                                </span>
                            }
                        </div>

                        <!-- Description -->
                        @if (!string.IsNullOrWhiteSpace(lt.Description))
                        {
                            <p class="text-muted small mb-3 leave-desc flex-grow-1" style="font-size: 0.8rem; line-height: 1.4;">
                                @lt.Description
                            </p>
                        }
                        else
                        {
                            <div class="flex-grow-1"></div>
                        }

                        <!-- Status -->
                        <div class="mt-auto pt-2 border-top d-flex align-items-center justify-content-between">
                            <span class="text-muted" style="font-size: 0.75rem;">Status</span>
                            @if (lt.IsActive)
                            {
                                <span class="badge bg-success bg-opacity-10 text-success">
                                    <i class="bi bi-check-circle me-1"></i>Active
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger bg-opacity-10 text-danger">
                                    <i class="bi bi-x-circle me-1"></i>Inactive
                                </span>
                            }
                        </div>

                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body text-center py-5">
            <i class="bi bi-bookmark-x fs-1 text-muted opacity-50 d-block mb-2"></i>
            <p class="text-muted mb-0">No leave types configured yet</p>
            @if (IsAdmin() || IsSuperAdmin())
            {
                <button class="btn btn-primary mt-3 rounded-pill px-4"
                        @onclick="CreateLeaveType">
                    <i class="bi bi-plus me-1"></i> Create First Leave Type
                </button>
            }
        </div>
    </div>
}

@code {

    [Parameter] public EventCallback<int> OnCountChanged { get; set; }

    private List<LeaveTypeViewModel> leaveTypes = new();

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await LoadLeaveTypes();
    }


    private async Task LoadLeaveTypes()
    {
        try
        {
            var result = await LeaveService.GetLeaveTypesAsync();
            leaveTypes = result?.IsSuccess == true && result.Data != null
                ? result.Data : new();

            await OnCountChanged.InvokeAsync(leaveTypes.Count);
        }
        catch
        {
            leaveTypes = new();
        }
    }

    private void CreateLeaveType() => NavigationManager.NavigateTo("/leave-type/create");

    private void EditLeaveType(int id) => NavigationManager.NavigateTo($"/leave-type/edit/{id}");

    private async Task DeleteLeaveType(LeaveTypeViewModel model)
    {
        bool ok = await JsRuntime.InvokeAsync<bool>(
            "confirm", $"Are you sure you want to delete '{FormatName(model.LeaveNameId.ToString())}'?");
        if (!ok) return;

        var res = await LeaveService.DeleteLeaveTypeAsync(model.Id);
        if (res?.IsSuccess == true)
        {
            await NotificationService.Success("Leave type deleted successfully.");
            await LoadLeaveTypes();
        }
        else
        {
            await NotificationService.Error(res?.Message ?? "Unable to delete leave type.");
        }
    }

    private static string FormatName(string name) =>
        System.Text.RegularExpressions.Regex.Replace(name ?? "", "([A-Z])", " $1").Trim();

    private static string GetColor(int idx) => (idx % 5) switch
    {
        0 => "primary",
        1 => "success",
        2 => "warning",
        3 => "info",
        4 => "danger",
        _ => "secondary"
    };
}