@page "/festival-holidays"

@using arna.HRMS.Components.lib.components.ui.Forms
@using arna.HRMS.Components.lib.components.ui.CommonComponent
@using arna.HRMS.Components.Pages.Client.Attendance.MonthYearAndToggle
@using arna.HRMS.Models.Common.Table
@using arna.HRMS.Models.ViewModels
@using arna.HRMS.Services
@using arna.HRMS.Services.Auth
@using arna.HRMS.Services.Common

@inject IFestivalHolidayService FestivalHolidayService
@inject NotificationService NotificationService
@inject NavigationManager NavigationManager
@inject IJSRuntime JsRuntime
@inherits AuthenticatedLayoutBase

<!-- ══════════ TOOLBAR ══════════ -->
<div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
    <div>
        <h5 class="fw-bold mb-1 d-flex align-items-center gap-2">
            <span class="p-2 rounded-2 bg-danger bg-opacity-10 text-danger d-inline-flex align-items-center justify-content-center" style="width: 34px; height: 34px;">
                <i class="bi bi-calendar-heart-fill"></i>
            </span>
            Festival Holidays
        </h5>
        <small class="text-muted">Manage corporate and statutory festival holidays across the calendar year</small>
    </div>

    @if (IsAdmin() || IsSuperAdmin())
    {
        <button class="btn btn-primary rounded-pill px-3 shadow-sm d-inline-flex align-items-center gap-2"
                @onclick="CreateFestivalHoliday">
            <i class="bi bi-plus-lg"></i>
            <span>Add Holiday</span>
        </button>
    }
</div>

<!-- ══════════ UNIFIED CONTAINER CARD ══════════ -->
<div class="card border shadow-sm rounded-3 mb-4 bg-white">
    <div class="card-body p-2 p-md-3">

        <!-- Card Header / Toolbar -->
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 pb-2 mb-3 border-bottom">
            <div class="d-flex align-items-center flex-wrap gap-2">
                <SelectMonthAndYear Year="@selectedYear"
                                    Month="@(selectedMonth == 0 ? DateTime.Now.Month : selectedMonth)"
                                    OnChange="OnMonthYearSelected" />

                @if (upcomingHoliday != null)
                {
                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-2.5 py-1.5 rounded-pill d-inline-flex align-items-center gap-1.5 fw-medium" style="font-size: 0.8rem;">
                        <i class="bi bi-balloon-heart-fill text-primary"></i>
                        <span>Next: <strong>@upcomingHoliday.FestivalName</strong> (@upcomingHoliday.Date.ToString("MMM dd"))</span>
                    </span>
                }
            </div>

            <div class="d-flex align-items-center gap-2">
                <AttendanceViewToggle ActiveView="@activeView"
                                      OnChange="v => activeView = v" />
            </div>
        </div>

        <!-- Card Content: Table or Calendar -->
        <div>
            @if (activeView == "table")
            {
                <div class="d-flex align-items-center justify-content-between mb-2 px-1">
                    <span class="small fw-semibold text-muted">
                        @(selectedMonth > 0 ? $"{GetMonthName(selectedMonth)} {selectedYear}" : $"All {selectedYear}") Holidays
                    </span>
                    <div class="d-flex align-items-center gap-2">
                        @if (selectedMonth > 0)
                        {
                            <button type="button" class="btn btn-sm btn-link text-decoration-none p-0 small" style="font-size: 0.78rem;" @onclick="ShowAllYear">
                                <i class="bi bi-calendar-range me-1"></i>View All @selectedYear
                            </button>
                        }
                        <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill small">
                            @filteredFestivals.Count holiday(s)
                        </span>
                    </div>
                </div>

                @if (filteredFestivals.Any())
                {
                    <AppTable TItem="FestivalHolidayViewModel"
                              Items="filteredFestivals"
                              Columns="TableSchemas.FestivalHolidays"
                              EnablePagination="true"
                              PageSize="10"
                              ShowActions="@(IsAdmin() || IsSuperAdmin())"
                              OnEdit="EditFestival"
                              OnDelete="DeleteFestival" />
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="bi bi-calendar-x fs-1 text-muted opacity-50 d-block mb-2"></i>
                        <p class="text-muted mb-2">
                            No festival holidays for @(selectedMonth > 0 ? $"{GetMonthName(selectedMonth)} {selectedYear}" : selectedYear.ToString())
                        </p>
                        @if (selectedMonth > 0)
                        {
                            <button class="btn btn-sm btn-outline-primary rounded-pill mt-1" @onclick="ShowAllYear">
                                <i class="bi bi-calendar-range me-1"></i> View All @selectedYear Holidays
                            </button>
                        }
                        @if (IsAdmin() || IsSuperAdmin())
                        {
                            <div class="mt-2">
                                <button class="btn btn-sm btn-primary rounded-pill px-3"
                                        @onclick="CreateFestivalHoliday">
                                    <i class="bi bi-plus-lg me-1"></i> Add Holiday
                                </button>
                            </div>
                        }
                    </div>
                }
            }
            else if (activeView == "calendar")
            {
                <HolidayCalender TItem="FestivalHolidayViewModel"
                                 Year="@selectedYear"
                                 Month="@(selectedMonth == 0 ? DateTime.Now.Month : selectedMonth)"
                                 Items="allFestivals"
                                 DateSelector="f => f.Date"
                                 TitleSelector="f => f.FestivalName"
                                 EventClass="cal-event-danger"
                                 EventIcon="bi bi-star-fill"
                                 EventLegendLabel="Holiday"
                                 EventLegendDotClass="bg-danger"
                                 OnMonthChanged="OnCalendarMonthChanged" />
            }
        </div>

    </div>
</div>

@code {

    [Parameter] public EventCallback<int> OnCountChanged { get; set; }

    // ── Data ──
    private List<FestivalHolidayViewModel> allFestivals = new();
    private List<FestivalHolidayViewModel> filteredFestivals = new();
    private FestivalHolidayViewModel? upcomingHoliday;

    // ── Selection ──
    private int selectedYear = DateTime.Now.Year;
    private int selectedMonth = DateTime.Now.Month;

    // ── View Mode ──
    private string activeView = "calendar";

    // ═══════════ LIFECYCLE ═══════════

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await LoadFestivals();
    }

    // ═══════════ DATA LOADING ═══════════

    private async Task LoadFestivals()
    {
        try
        {
            var result = await FestivalHolidayService.GetFestivalHolidayAsync();

            allFestivals = result?.IsSuccess == true && result.Data != null
                ? result.Data.OrderBy(f => f.Date).ToList()
                : new();

            upcomingHoliday = allFestivals
                .Where(f => f.Date >= DateTime.Today)
                .OrderBy(f => f.Date)
                .FirstOrDefault();

            ApplyFilters();

            await OnCountChanged.InvokeAsync(allFestivals.Count);
        }
        catch
        {
            allFestivals = new();
            filteredFestivals = new();
        }
    }

    private void ApplyFilters()
    {
        filteredFestivals = allFestivals
            .Where(f => f.Date.Year == selectedYear)
            .Where(f => selectedMonth == 0 || f.Date.Month == selectedMonth)
            .OrderBy(f => f.Date)
            .ToList();
    }

    // ═══════════ NAVIGATION ═══════════

    private void CreateFestivalHoliday() => NavigationManager.NavigateTo("/festival-holiday/create");

    private void EditFestival(FestivalHolidayViewModel item) => NavigationManager.NavigateTo($"/festival-holiday/edit/{item.Id}");

    // ═══════════ TOOLBAR / FILTER HANDLERS ═══════════

    private void OnMonthYearSelected((int year, int month) val)
    {
        selectedYear = val.year;
        selectedMonth = val.month;
        ApplyFilters();
    }

    private void OnCalendarMonthChanged((int Year, int Month) value)
    {
        selectedYear = value.Year;
        selectedMonth = value.Month;
        ApplyFilters();
    }

    private void ShowAllYear()
    {
        selectedMonth = 0;
        ApplyFilters();
    }

    private async Task DeleteFestival(FestivalHolidayViewModel model)
    {
        bool ok = await JsRuntime.InvokeAsync<bool>(
            "confirm", $"Are you sure you want to delete '{model.FestivalName}'?");
        if (!ok) return;

        try
        {
            var result = await FestivalHolidayService.DeleteFestivalHolidayAsync(model.Id);
            if (result?.IsSuccess == true)
            {
                await NotificationService.Success("Holiday deleted successfully.");
                await LoadFestivals();
            }
            else
            {
                await NotificationService.Error(result?.Message ?? "Failed to delete.");
            }
        }
        catch (Exception ex)
        {
            await NotificationService.Error(ex.Message ?? "Error deleting holiday.");
        }
    }

    // ═══════════ HELPERS ═══════════

    private static string GetMonthName(int month) =>
        month is >= 1 and <= 12
            ? new DateTime(2000, month, 1).ToString("MMMM")
            : "All Months";
}