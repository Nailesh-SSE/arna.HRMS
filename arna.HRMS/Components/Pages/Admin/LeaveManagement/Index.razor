@page "/admin-leave-management"
@page "/admin-leave-types"
@page "/admin-leave-requests"
@page "/admin-festival-holidays"

@using arna.HRMS.Components.Loader
@using arna.HRMS.Components.Pages.Admin.LeaveManagement
@using arna.HRMS.Core.Entities
@using arna.HRMS.Services.Auth

@inject NavigationManager NavigationManager
@inherits AuthenticatedLayoutBase

<Loader Visible="isLoading" Message="@loadingMessage" />

@if (!isLoading)
{
    <div class="container-fluid p-0 leave-fade-in h-100 d-flex flex-column min-h-0">

        <!-- ══════════ 1. EXECUTIVE HEADER (No Icon, Unified Enterprise Style) ══════════ -->
        <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap gap-2 flex-shrink-0">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <h3 class="enterprise-page-title mb-0">@GetHeaderTitle()</h3>
                    <span class="header-count-pill">@GetHeaderBadgeCount()</span>
                </div>
                <div class="enterprise-page-subtitle">@GetHeaderSubtitle()</div>
            </div>

            <div class="d-flex align-items-center gap-2">
                @if (activeTab == Tab.LeaveTypes && (IsAdmin() || IsSuperAdmin()))
                {
                    <button class="btn btn-add-primary" @onclick="CreateLeaveType">
                        <i class="bi bi-plus-lg"></i>
                        <span>Add Leave Type</span>
                    </button>
                }
                else if (activeTab == Tab.Festivals && (IsAdmin() || IsSuperAdmin()))
                {
                    <button class="btn btn-add-primary" @onclick="CreateFestivalHoliday">
                        <i class="bi bi-plus-lg"></i>
                        <span>Add Holiday</span>
                    </button>
                }
            </div>
        </div>

        <!-- ══════════ CONTENT ══════════ -->
        <div class="tab-content flex-grow-1 min-h-0 d-flex flex-column">

            @if (activeTab == Tab.LeaveTypes)
            {
                <LeaveTypes @ref="leaveType"
                            OnCountChanged="c => { leaveTypeCount = c; StateHasChanged(); }" />
            }

            @if (activeTab == Tab.Requests)
            {
                <LeaveRequest @ref="leaveRequest"
                              OnPendingCountChanged="c => { pendingRequestCount = c; StateHasChanged(); }" />
            }

            @if (activeTab == Tab.Festivals)
            {
                <FestivalHolidayType @ref="festivalHoliday"
                                    OnCountChanged="c => { festivalCount = c; StateHasChanged(); }" />
            }

        </div>

    </div>
}

@code {

    [SupplyParameterFromQuery(Name = "tab")]
    public string? TabQuery { get; set; }

    private bool isLoading = true;
    private string loadingMessage = "Loading leave management...";
    private enum Tab { LeaveTypes, Requests, Festivals }
    private Tab activeTab = Tab.LeaveTypes;

    // ── Badge counts ──
    private int leaveTypeCount;
    private int pendingRequestCount;
    private int festivalCount;

    // ── Tab refs ──
    private LeaveTypes? leaveType;
    private LeaveRequest? leaveRequest;
    private FestivalHolidayType? festivalHoliday;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        NavigationManager.LocationChanged += HandleLocationChanged;
        SyncTabFromUri(NavigationManager.Uri);
        isLoading = false;
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        SyncTabFromUri(e.Location);
        InvokeAsync(StateHasChanged);
    }

    private void SyncTabFromUri(string uri)
    {
        if (uri.Contains("/admin-festival-holidays", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(TabQuery, "festivals", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(TabQuery, "festival", StringComparison.OrdinalIgnoreCase))
        {
            activeTab = Tab.Festivals;
        }
        else if (uri.Contains("/admin-leave-requests", StringComparison.OrdinalIgnoreCase) ||
                 string.Equals(TabQuery, "requests", StringComparison.OrdinalIgnoreCase) ||
                 string.Equals(TabQuery, "request", StringComparison.OrdinalIgnoreCase))
        {
            activeTab = Tab.Requests;
        }
        else
        {
            activeTab = Tab.LeaveTypes;
        }
    }

    private void CreateLeaveType() => NavigationManager.NavigateTo("/leave-type/create");
    private void CreateFestivalHoliday() => NavigationManager.NavigateTo("/festival-holiday/create");

    private string GetHeaderTitle() => activeTab switch
    {
        Tab.LeaveTypes => "Leave Types",
        Tab.Requests => "Leave Requests",
        Tab.Festivals => "Festival Holidays",
        _ => "Leave Management"
    };

    private string GetHeaderSubtitle() => activeTab switch
    {
        Tab.LeaveTypes => "Configure employee leave categories, quotas, and corporate entitlement rules.",
        Tab.Requests => "Review, approve, or reject employee leave applications across the organization.",
        Tab.Festivals => "Manage company holidays, gazetted days, and festival calendar.",
        _ => "Manage organizational leave policies and employee requests."
    };

    private string GetHeaderBadgeCount() => activeTab switch
    {
        Tab.LeaveTypes => $"{leaveTypeCount} Categories",
        Tab.Requests => $"{pendingRequestCount} Pending",
        Tab.Festivals => $"{festivalCount} Holidays",
        _ => ""
    };

    public new void Dispose()
    {
        NavigationManager.LocationChanged -= HandleLocationChanged;
        base.Dispose();
    }
}
