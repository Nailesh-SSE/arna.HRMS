@typeparam TItem

<!-- ══════════ CALENDAR GRID & LEGEND ══════════ -->
<div class="w-100">

    <!-- Weekday Headers -->
    <div class="cal-grid mb-1 text-center">
        @foreach (var (dayName, isWeekend) in weekDayHeaders)
        {
            <div class="fw-semibold small py-1 user-select-none @(isWeekend ? "text-danger" : "text-secondary")" style="font-size: 0.75rem;">
                @dayName
            </div>
        }
    </div>

    <!-- 7-Column Days Grid -->
    <div class="cal-grid">
        <!-- Leading Prev-Month Days (Faded) -->
        @foreach (var prevDay in leadingDays)
        {
            <div class="cal-cell-other-month d-flex flex-column align-items-center justify-content-start cal-cell-min p-1.5 user-select-none">
                <span class="cal-day-num text-muted opacity-50 fw-medium">@prevDay.Day</span>
            </div>
        }

        <!-- Current Month Days -->
        @foreach (var day in monthDays)
        {
            var isToday = day.Date == DateTime.Today;
            var isWeekend = day.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday;
            var matchedItem = GetItemForDate(day);
            var hasItem = matchedItem != null;

            var cellBgClass = isToday 
                ? "cal-today-cell" 
                : hasItem 
                    ? "cal-holiday-cell" 
                    : isWeekend 
                        ? "cal-weekend-cell" 
                        : "bg-white";

            <div class="card border rounded-2 p-1.5 d-flex flex-column align-items-center justify-content-between user-select-none cal-cell-min cal-day-item @cellBgClass"
                 title="@(hasItem ? GetTitle(matchedItem!) : "")"
                 @onclick="() => OnDateClicked(day, matchedItem)">

                <!-- Day Number Header -->
                <div class="w-100 text-center d-flex align-items-center justify-content-center" style="min-height: 20px;">
                    @if (isToday)
                    {
                        <span class="cal-today-badge">@day.Day</span>
                    }
                    else
                    {
                        <span class="cal-day-num fw-semibold @(hasItem ? "text-danger fw-bold" : isWeekend ? "text-danger-emphasis opacity-75" : "text-dark")">
                            @day.Day
                        </span>
                    }
                </div>

                <!-- Event / Holiday Tag -->
                <div class="w-100 mt-1 d-flex flex-column align-items-center justify-content-center" style="min-height: 22px;">
                    @if (hasItem)
                    {
                        <div class="cal-event-pill @EventClass w-100 text-truncate text-center"
                             title="@GetTitle(matchedItem!)">
                            <i class="@EventIcon me-1"></i>
                            <span class="cal-event-text">
                                @Truncate(GetTitle(matchedItem!), 14)
                            </span>
                        </div>
                    }
                </div>

            </div>
        }

        <!-- Trailing Next-Month Days (Faded) -->
        @foreach (var nextDay in trailingDays)
        {
            <div class="cal-cell-other-month d-flex flex-column align-items-center justify-content-start cal-cell-min p-1.5 user-select-none">
                <span class="cal-day-num text-muted opacity-50 fw-medium">@nextDay.Day</span>
            </div>
        }
    </div>

    <!-- Legend -->
    <div class="d-flex align-items-center flex-wrap gap-3 mt-3 pt-2 border-top small text-muted">
        <div class="d-flex align-items-center gap-1.5">
            <span class="cal-legend-dot bg-primary"></span>
            <span style="font-size: 0.75rem;">Today</span>
        </div>
        @if (!string.IsNullOrWhiteSpace(EventLegendLabel))
        {
            <div class="d-flex align-items-center gap-1.5">
                <span class="cal-legend-dot @EventLegendDotClass"></span>
                <span style="font-size: 0.75rem;">@EventLegendLabel</span>
            </div>
        }
        <div class="d-flex align-items-center gap-1.5">
            <span class="cal-legend-dot bg-secondary bg-opacity-25"></span>
            <span style="font-size: 0.75rem;">Weekend</span>
        </div>
        <div class="ms-auto fw-medium text-dark" style="font-size: 0.75rem;">
            @currentMonthItemCount @(EventLegendLabel)(s) this month
        </div>
    </div>

</div>

@code {

    [Parameter] public int Year { get; set; } = DateTime.Now.Year;
    [Parameter] public int Month { get; set; } = DateTime.Now.Month;
    [Parameter] public List<TItem> Items { get; set; } = new();
    [Parameter] public Func<TItem, DateTime> DateSelector { get; set; } = default!;
    [Parameter] public Func<TItem, string> TitleSelector { get; set; } = default!;
    [Parameter] public EventCallback<(int Year, int Month)> OnMonthChanged { get; set; }
    [Parameter] public EventCallback<DateTime> OnDateClick { get; set; }

    [Parameter] public string EventClass { get; set; } = "cal-event-danger";
    [Parameter] public string EventIcon { get; set; } = "bi bi-star-fill";
    [Parameter] public string EventLegendLabel { get; set; } = "Holiday";
    [Parameter] public string EventLegendDotClass { get; set; } = "bg-danger";

    private readonly (string Name, bool IsWeekend)[] weekDayHeaders = new[]
    {
        ("Sun", true),
        ("Mon", false),
        ("Tue", false),
        ("Wed", false),
        ("Thu", false),
        ("Fri", false),
        ("Sat", true)
    };

    private List<DateTime> leadingDays = new();
    private List<DateTime> monthDays = new();
    private List<DateTime> trailingDays = new();
    private Dictionary<DateTime, TItem> itemLookup = new();
    private int currentMonthItemCount;

    protected override void OnParametersSet()
    {
        BuildCalendarGrid();
        BuildLookup();
    }

    private void BuildCalendarGrid()
    {
        leadingDays.Clear();
        monthDays.Clear();
        trailingDays.Clear();

        var firstDay = new DateTime(Year, Month, 1);
        var daysInMonth = DateTime.DaysInMonth(Year, Month);
        var lastDay = new DateTime(Year, Month, daysInMonth);

        // Leading days from previous month
        var prevMonthOffset = (int)firstDay.DayOfWeek;
        for (int i = prevMonthOffset; i > 0; i--)
        {
            leadingDays.Add(firstDay.AddDays(-i));
        }

        // Current month days
        for (int d = 1; d <= daysInMonth; d++)
        {
            monthDays.Add(new DateTime(Year, Month, d));
        }

        // Trailing days to complete multiple of 7
        var totalCells = leadingDays.Count + monthDays.Count;
        var remainder = totalCells % 7;
        if (remainder > 0)
        {
            var trailingCount = 7 - remainder;
            for (int i = 1; i <= trailingCount; i++)
            {
                trailingDays.Add(lastDay.AddDays(i));
            }
        }
    }

    private void BuildLookup()
    {
        if (Items == null || DateSelector == null)
        {
            itemLookup = new();
            currentMonthItemCount = 0;
            return;
        }

        itemLookup = Items
            .GroupBy(item => DateSelector(item).Date)
            .ToDictionary(g => g.Key, g => g.First());

        currentMonthItemCount = Items
            .Count(item =>
            {
                var d = DateSelector(item);
                return d.Year == Year && d.Month == Month;
            });
    }

    private async Task PrevMonth()
    {
        if (Month == 1)
        {
            Month = 12;
            Year--;
        }
        else
        {
            Month--;
        }

        BuildCalendarGrid();
        BuildLookup();

        await OnMonthChanged.InvokeAsync((Year, Month));
    }

    private async Task NextMonth()
    {
        if (Month == 12)
        {
            Month = 1;
            Year++;
        }
        else
        {
            Month++;
        }

        BuildCalendarGrid();
        BuildLookup();

        await OnMonthChanged.InvokeAsync((Year, Month));
    }

    private TItem? GetItemForDate(DateTime date)
    {
        itemLookup.TryGetValue(date.Date, out var item);
        return item;
    }

    private string GetTitle(TItem item)
    {
        return TitleSelector != null ? TitleSelector(item) : item?.ToString() ?? "";
    }

    private async Task OnDateClicked(DateTime date, TItem? item)
    {
        if (OnDateClick.HasDelegate)
            await OnDateClick.InvokeAsync(date);
    }

    private static string Truncate(string text, int max) =>
        string.IsNullOrEmpty(text) ? "" :
        text.Length <= max ? text : text[..max] + "…";
}