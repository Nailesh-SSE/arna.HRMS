@page "/role"

@using arna.HRMS.Components.Loader
@using arna.HRMS.Models.ViewModels
@using arna.HRMS.Services
@using arna.HRMS.Services.Auth
@using arna.HRMS.Services.Common

@inject NavigationManager NavigationManager
@inject IRoleService RoleService
@inject NotificationService NotificationService
@inject IJSRuntime JsRuntime
@inherits AuthenticatedLayoutBase

<Loader Visible="_isLoading" Message="@_loadingMessage" />

<div class="role-page-container">

    <!-- ═══════════ 1. PAGE HEADER & PRIMARY ACTION ═══════════ -->
    <div class="d-flex flex-column flex-sm-row align-items-start align-items-sm-center justify-content-between gap-3 mb-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <h3 class="role-title mb-0">Roles</h3>
                @if (!_isLoading)
                {
                    <span class="header-count-pill">
                        @_roles.Count Total
                    </span>
                }
            </div>
            <p class="role-subtitle mb-0">Manage organizational roles and access levels.</p>
        </div>

        <div class="d-flex align-items-center gap-2 flex-wrap">
            <button type="button" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1.5 px-3 py-2 rounded-3 shadow-xs fw-medium bg-white"
                    @onclick="LoadRolesAsync" disabled="@_isLoading" title="Refresh roles">
                <i class="bi bi-arrow-clockwise @(_isLoading ? "spin-animation" : "")"></i>
                <span>Refresh</span>
            </button>

            @if (IsAdmin() || IsSuperAdmin())
            {
                <button class="btn btn-add-primary"
                        @onclick="@(() => NavigateTo("/role/create"))">
                    <i class="bi bi-plus-lg"></i>
                    <span>Add Role</span>
                </button>
            }
        </div>
    </div>

    <!-- ═══════════ 2. SEARCH & FILTER BAR ═══════════ -->
    <div class="role-filter-card mb-3">
        <div class="d-flex flex-wrap align-items-center gap-3">

            <!-- Search Box -->
            <div class="filter-search-box flex-grow-1">
                <i class="bi bi-search filter-search-icon"></i>
                <input type="text"
                       class="filter-search-input"
                       placeholder="Search by role name or description..."
                       value="@_searchTerm"
                       @oninput="OnSearchInput" />
                @if (!string.IsNullOrWhiteSpace(_searchTerm))
                {
                    <button type="button" class="filter-clear-btn" @onclick="ClearSearch" title="Clear search">
                        <i class="bi bi-x-circle-fill"></i>
                    </button>
                }
            </div>

            <!-- Role Status Filter -->
            <div class="filter-select-wrap">
                <select class="filter-dropdown-select" value="@_selectedStatus" @onchange="OnStatusFilterChange">
                    <option value="All">All Roles</option>
                    <option value="Active">Active Roles</option>
                    <option value="Inactive">Inactive Roles</option>
                </select>
            </div>

            <!-- Reset Filters Trigger -->
            @if (HasActiveFilters)
            {
                <div>
                    <button type="button" class="btn-filter-trigger active-filter" @onclick="ClearAllFilters" title="Reset all filters">
                        <i class="bi bi-x-lg"></i>
                        <span>Reset Filters</span>
                    </button>
                </div>
            }

        </div>
    </div>

    <!-- ═══════════ 3. ROLE DIRECTORY TABLE ═══════════ -->
    <div class="role-grid-card">

        <!-- Context Header Banner -->
        <div class="role-context-banner d-flex align-items-center justify-content-between px-3 py-2 bg-light border-bottom">
            <div class="d-flex align-items-center gap-2">
                <span class="status-dot-sm bg-primary"></span>
                <span class="fw-semibold text-dark small">Role Directory</span>
                <span class="text-muted small">• Organizational Roles</span>
            </div>
            <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-2.5 py-1 small fw-medium">
                @FilteredRoles.Count role(s)
            </span>
        </div>

        <div class="role-table-wrapper">
            @if (_isLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary mb-3" role="status"></div>
                    <p class="text-muted mb-0 small">Loading roles...</p>
                </div>
            }
            else if (!FilteredRoles.Any())
            {
                <div class="text-center py-5 px-3">
                    <div class="d-inline-flex align-items-center justify-content-center bg-light rounded-circle p-3 mb-3 text-secondary opacity-75" style="width:64px; height:64px;">
                        <i class="bi bi-shield-lock fs-2"></i>
                    </div>
                    <h6 class="fw-bold text-dark mb-1">No Roles Found</h6>
                    <p class="text-muted small mb-3">
                        @if (HasActiveFilters)
                        {
                            <span>No roles match your active search or filter criteria.</span>
                        }
                        else
                        {
                            <span>No roles have been configured in the system yet.</span>
                        }
                    </p>
                    @if (HasActiveFilters)
                    {
                        <button class="btn btn-sm btn-outline-primary rounded-pill px-3" @onclick="ClearAllFilters">
                            <i class="bi bi-arrow-counterclockwise me-1"></i> Clear Filters
                        </button>
                    }
                    else if (IsAdmin() || IsSuperAdmin())
                    {
                        <button class="btn btn-sm btn-primary rounded-pill px-3" @onclick="@(() => NavigateTo("/role/create"))">
                            <i class="bi bi-plus-lg me-1"></i> Add First Role
                        </button>
                    }
                </div>
            }
            else
            {
                <table class="role-modern-table">
                    <thead>
                        <tr>
                            <th style="min-width: 220px;">NAME</th>
                            <th style="min-width: 320px;">DESCRIPTION</th>
                            <th style="width: 130px; text-align: center;">STATUS</th>
                            @if (IsAdmin() || IsSuperAdmin())
                            {
                                <th style="width: 100px; text-align: center;">ACTION</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var role in PagedRoles)
                        {
                            var isSystem = IsSystemRole(role.Name);
                            var iconClass = GetRoleIcon(role.Name);
                            var iconColorClass = GetRoleIconColorClass(role.Name);

                            <tr>
                                <!-- NAME (Icon Circle + Name + System Badge) -->
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="role-icon-circle @iconColorClass">
                                            <i class="bi @iconClass"></i>
                                        </div>
                                        <span class="role-name text-truncate" title="@role.Name">
                                            @role.Name
                                        </span>
                                        @if (isSystem)
                                        {
                                            <span class="system-badge" title="Built-in core system role">
                                                <i class="bi bi-shield-check"></i> System
                                            </span>
                                        }
                                    </div>
                                </td>

                                <!-- DESCRIPTION -->
                                <td>
                                    <span class="role-desc-text" title="@FormatDescription(role.Description)">
                                        @(string.IsNullOrWhiteSpace(role.Description) ? "—" : FormatDescription(role.Description))
                                    </span>
                                </td>

                                <!-- STATUS -->
                                <td class="text-center">
                                    @if (role.IsActive)
                                    {
                                        <span class="role-status-pill role-status-active">
                                            <span class="status-dot"></span>
                                            <span>Active</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="role-status-pill role-status-inactive">
                                            <span class="status-dot"></span>
                                            <span>Inactive</span>
                                        </span>
                                    }
                                </td>

                                <!-- ACTIONS -->
                                @if (IsAdmin() || IsSuperAdmin())
                                {
                                    <td class="text-center">
                                        <div class="d-inline-flex align-items-center gap-1.5 justify-content-center">
                                            <button type="button"
                                                    class="btn-action-icon-edit"
                                                    title="Edit role"
                                                    @onclick="() => EditRole(role)">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>

                                            @if (isSystem)
                                            {
                                                <button type="button"
                                                        class="btn-action-icon-delete"
                                                        disabled
                                                        title="Built-in system roles cannot be deleted">
                                                    <i class="bi bi-trash3"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button"
                                                        class="btn-action-icon-delete"
                                                        title="Delete role"
                                                        @onclick="() => DeleteRole(role)">
                                                    <i class="bi bi-trash3"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <!-- ═══════════ 4. PAGINATION & SUMMARY FOOTER ═══════════ -->
        @if (!_isLoading && FilteredRoles.Any())
        {
            <div class="role-pagination-bar d-flex flex-column flex-sm-row align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-2 text-muted small flex-wrap">
                    <span>Showing <strong>@StartIndex</strong> to <strong>@EndIndex</strong> of <strong>@TotalCount</strong> roles</span>
                    <span class="text-black-50">•</span>
                    <div class="d-flex align-items-center gap-1.5">
                        <span>Show</span>
                        <select class="page-size-select" value="@_pageSize" @onchange="OnPageSizeChange">
                            <option value="10">10</option>
                            <option value="25">25</option>
                            <option value="50">50</option>
                        </select>
                        <span>per page</span>
                    </div>
                </div>

                @if (TotalPages > 1)
                {
                    <div class="d-flex align-items-center gap-1">
                        <button type="button" class="page-btn" disabled="@(_currentPage <= 1)" @onclick="() => GoToPage(_currentPage - 1)" title="Previous page">
                            <i class="bi bi-chevron-left"></i>
                        </button>

                        @for (int p = 1; p <= TotalPages; p++)
                        {
                            var pageNum = p;
                            <button type="button" class="page-btn @(pageNum == _currentPage ? "active" : "")" @onclick="() => GoToPage(pageNum)">
                                @pageNum
                            </button>
                        }

                        <button type="button" class="page-btn" disabled="@(_currentPage >= TotalPages)" @onclick="() => GoToPage(_currentPage + 1)" title="Next page">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                }
            </div>
        }

    </div>

</div>

@code {

    // ═══════════ STATE ═══════════
    private List<RoleViewModel> _roles = new();
    private bool _isLoading = true;
    private string _loadingMessage = "Loading roles...";

    // Filters
    private string? _searchTerm;
    private string _selectedStatus = "All";

    // Pagination
    private int _currentPage = 1;
    private int _pageSize = 10;

    // ═══════════ COMPUTED ═══════════
    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(_searchTerm) ||
        _selectedStatus != "All";

    private List<RoleViewModel> FilteredRoles
    {
        get
        {
            var query = _roles.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_searchTerm))
            {
                var term = _searchTerm.Trim();
                query = query.Where(r =>
                    MatchesSearch(r.Name, term) ||
                    MatchesSearch(r.Description, term));
            }

            if (_selectedStatus == "Active")
            {
                query = query.Where(r => r.IsActive);
            }
            else if (_selectedStatus == "Inactive")
            {
                query = query.Where(r => !r.IsActive);
            }

            return query.OrderByDescending(r => IsSystemRole(r.Name))
                        .ThenBy(r => r.Name)
                        .ToList();
        }
    }

    private int TotalCount => FilteredRoles.Count;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling((double)TotalCount / _pageSize));
    private int StartIndex => TotalCount == 0 ? 0 : (_currentPage - 1) * _pageSize + 1;
    private int EndIndex => Math.Min(_currentPage * _pageSize, TotalCount);

    private List<RoleViewModel> PagedRoles =>
        FilteredRoles.Skip((_currentPage - 1) * _pageSize).Take(_pageSize).ToList();

    // ═══════════ LIFECYCLE ═══════════
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await LoadRolesAsync();
    }

    // ═══════════ DATA LOADING ═══════════
    private async Task LoadRolesAsync()
    {
        _isLoading = true;
        try
        {
            var result = await RoleService.GetRolesAsync();

            if (result.IsSuccess && result.Data != null)
            {
                _roles = result.Data;
            }
            else
            {
                await NotificationService.Error(result.Message ?? "Failed to load roles");
                _roles = new List<RoleViewModel>();
            }
        }
        catch (Exception ex)
        {
            await NotificationService.Error("Error connecting to roles service: " + ex.Message);
            _roles = new List<RoleViewModel>();
        }
        finally
        {
            _isLoading = false;
        }
    }

    // ═══════════ FILTER & PAGINATION HANDLERS ═══════════
    private void OnSearchInput(ChangeEventArgs e)
    {
        _searchTerm = e.Value?.ToString();
        _currentPage = 1;
    }

    private void ClearSearch()
    {
        _searchTerm = null;
        _currentPage = 1;
    }

    private void OnStatusFilterChange(ChangeEventArgs e)
    {
        _selectedStatus = e.Value?.ToString() ?? "All";
        _currentPage = 1;
    }

    private void ClearAllFilters()
    {
        _searchTerm = null;
        _selectedStatus = "All";
        _currentPage = 1;
    }

    private void OnPageSizeChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var size) && size > 0)
        {
            _pageSize = size;
            _currentPage = 1;
        }
    }

    private void GoToPage(int page)
    {
        _currentPage = Math.Clamp(page, 1, TotalPages);
    }

    // ═══════════ NAVIGATION & ACTIONS ═══════════
    private void NavigateTo(string route) => NavigationManager.NavigateTo(route);

    private void EditRole(RoleViewModel model) => NavigationManager.NavigateTo($"/role/edit/{model.Id}");

    private async Task DeleteRole(RoleViewModel model)
    {
        if (IsSystemRole(model.Name))
        {
            await NotificationService.Warning("Default system roles (SuperAdmin, Admin) cannot be deleted.");
            return;
        }

        var confirmed = await JsRuntime.InvokeAsync<bool>(
            "confirm", $"Are you sure you want to delete the '{model.Name}' role?");

        if (!confirmed) return;

        var result = await RoleService.DeleteRoleAsync(model.Id);

        if (!result.IsSuccess)
        {
            await NotificationService.Error(result.Message ?? "Unable to delete role.");
            return;
        }

        await NotificationService.Success("Role deleted successfully.");
        await LoadRolesAsync();
    }

    // ═══════════ ROLE CLASSIFICATION & FORMATTING HELPERS ═══════════
    private static bool IsSystemRole(string name) =>
        name.Equals("SuperAdmin", StringComparison.OrdinalIgnoreCase) ||
        name.Equals("Admin", StringComparison.OrdinalIgnoreCase);

    private static string GetRoleIcon(string name)
    {
        if (name.Contains("Super", StringComparison.OrdinalIgnoreCase)) return "bi-shield-shaded";
        if (name.Contains("Admin", StringComparison.OrdinalIgnoreCase)) return "bi-shield-lock";
        if (name.Contains("Manager", StringComparison.OrdinalIgnoreCase) || name.Contains("Lead", StringComparison.OrdinalIgnoreCase)) return "bi-person-badge";
        if (name.Contains("Employee", StringComparison.OrdinalIgnoreCase) || name.Contains("Staff", StringComparison.OrdinalIgnoreCase)) return "bi-person";
        return "bi-person";
    }

    private static string GetRoleIconColorClass(string name)
    {
        if (name.Contains("Super", StringComparison.OrdinalIgnoreCase)) return "role-icon-super";
        if (name.Contains("Admin", StringComparison.OrdinalIgnoreCase)) return "role-icon-admin";
        if (name.Contains("Manager", StringComparison.OrdinalIgnoreCase) || name.Contains("Lead", StringComparison.OrdinalIgnoreCase)) return "role-icon-manager";
        if (name.Contains("Employee", StringComparison.OrdinalIgnoreCase) || name.Contains("Staff", StringComparison.OrdinalIgnoreCase)) return "role-icon-employee";
        return "role-icon-custom";
    }

    private static string FormatDescription(string? desc)
    {
        if (string.IsNullOrWhiteSpace(desc)) return "—";
        return desc.Replace("with full permissions", "with full system access", StringComparison.OrdinalIgnoreCase)
                   .Replace("permissions", "access", StringComparison.OrdinalIgnoreCase);
    }

    private static bool MatchesSearch(string? value, string term)
        => !string.IsNullOrWhiteSpace(value) &&
           value.Contains(term, StringComparison.OrdinalIgnoreCase);
}
