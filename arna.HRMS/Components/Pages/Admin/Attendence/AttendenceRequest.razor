@page "/admin-attendance-requests"

@using arna.HRMS.Components.Loader
@using arna.HRMS.Components.lib.components.ui.CommonComponent
@using arna.HRMS.Components.lib.components.ui.Forms
@using arna.HRMS.Components.lib.components.ui.Model
@using arna.HRMS.Models.Common
@using arna.HRMS.Models.Enums
@using arna.HRMS.Models.State.Attendance
@using arna.HRMS.Models.ViewModels.Attendance
@using arna.HRMS.Services
@using arna.HRMS.Services.Auth
@using arna.HRMS.Services.Common

@inject AttendanceState State
@inject IAttendanceRequestService AttendanceRequestService
@inject IEmployeeService EmployeeService
@inject NotificationService NotificationService
@inject IJSRuntime JsRuntime
@inherits AuthenticatedLayoutBase

<Loader Visible="_isLoading" Message="@_loadingMessage" />

@if (!_isLoading)
{
    <div class="att-req-page-container">

        <!-- ═══════════ 1. EXECUTIVE HEADER ═══════════ -->
        <div class="d-flex flex-column flex-sm-row align-items-start align-items-sm-center justify-content-between gap-2 mb-2 flex-shrink-0">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <h3 class="enterprise-page-title mb-0">Attendance Requests</h3>
                    <span class="header-count-pill">
                        @_allRequests.Count Total
                    </span>
                </div>
                <p class="enterprise-page-subtitle mb-0">Review, approve, or reject employee attendance adjustment and regularisation requests.</p>
            </div>

            <div class="d-flex align-items-center gap-2 flex-wrap">
                <AppButton Class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1.5 px-3 py-1.5 rounded-3 shadow-xs fw-medium bg-white"
                           OnClick="LoadRequests"
                           Disabled="@_isLoading"
                           Text="Refresh">
                    <i class="bi bi-arrow-clockwise @(_isLoading ? "spin-animation" : "")"></i>
                </AppButton>
            </div>
        </div>

        <!-- ═══════════ 2. FILTER & METRICS BAR ═══════════ -->
        <div class="att-req-filter-card mb-2 flex-shrink-0">
            <div class="d-flex flex-column flex-lg-row align-items-start align-items-lg-center justify-content-between gap-3">

                <!-- Quick Status Filter Pills -->
                <div class="d-flex align-items-center gap-1.5 flex-wrap">
                    <button type="button" class="btn-filter-pill @(!_statusFilter.HasValue ? "active" : "")"
                            @onclick="() => FilterByStatus(null)">
                        <span>All</span>
                        <span class="pill-count">@_allRequests.Count</span>
                    </button>

                    <button type="button" class="btn-filter-pill pill-pending @(_statusFilter == Status.Pending ? "active" : "")"
                            @onclick="() => FilterByStatus(Status.Pending)">
                        <span class="status-dot-sm bg-warning"></span>
                        <span>Pending</span>
                        <span class="pill-count">@_pendingCount</span>
                    </button>

                    <button type="button" class="btn-filter-pill pill-approved @(_statusFilter == Status.Approved ? "active" : "")"
                            @onclick="() => FilterByStatus(Status.Approved)">
                        <span class="status-dot-sm bg-success"></span>
                        <span>Approved</span>
                        <span class="pill-count">@_approvedCount</span>
                    </button>

                    <button type="button" class="btn-filter-pill pill-rejected @(_statusFilter == Status.Rejected ? "active" : "")"
                            @onclick="() => FilterByStatus(Status.Rejected)">
                        <span class="status-dot-sm bg-danger"></span>
                        <span>Rejected</span>
                        <span class="pill-count">@_rejectedCount</span>
                    </button>

                    <button type="button" class="btn-filter-pill pill-cancelled @(_statusFilter == Status.Cancelled ? "active" : "")"
                            @onclick="() => FilterByStatus(Status.Cancelled)">
                        <span class="status-dot-sm bg-secondary"></span>
                        <span>Cancelled</span>
                        <span class="pill-count">@(_allRequests.Count(r => r.StatusId == Status.Cancelled))</span>
                    </button>
                </div>

                <!-- Dropdown & Search Filters -->
                <div class="d-flex align-items-center gap-2 flex-wrap ms-lg-auto">
                    <SearchEmployee Employees="Employees"
                                    SelectedValue="@GetEmployeeValue()"
                                    OnChanged="OnEmployeeChanged"
                                    OnNameChanged="OnEmployeeNameChanged" />

                    @if (HasActiveFilters)
                    {
                        <button type="button" class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1 rounded-3 px-2.5 py-1.5"
                                @onclick="ClearFilters" title="Clear all active filters">
                            <i class="bi bi-x-circle"></i>
                            <span>Reset</span>
                        </button>
                    }
                </div>

            </div>
        </div>

        <!-- ═══════════ APPROVE SELECTED CONFIRMATION MODAL ═══════════ -->
        @if (_showApproveModal)
        {
            <div class="modal d-block" style="background-color: rgba(0, 0, 0, 0.5); z-index: 1050;">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content border-0 rounded-3 shadow-lg">
                        <div class="modal-header border-0 bg-light rounded-top-3">
                            <h5 class="modal-title fw-semibold">
                                <i class="bi bi-check2-circle text-success me-2"></i>
                                Approve Selected Requests?
                            </h5>
                            <button type="button" class="btn-close" @onclick="() => _showApproveModal = false"></button>
                        </div>
                        <div class="modal-body py-3 py-md-4">
                            <p class="mb-2">
                                You are about to approve <strong>@_selectedRequestIds.Count</strong> selected pending attendance request(s).
                            </p>
                            <small class="text-muted">This action will immediately update the status of these requests to Approved.</small>
                        </div>
                        <div class="modal-footer border-0 bg-light rounded-bottom-3 gap-2">
                            <AppButton Class="btn btn-sm btn-outline-secondary rounded-pill px-3"
                                       OnClick="() => _showApproveModal = false"
                                       Disabled="@_isUpdating"
                                       Text="Cancel">
                                <i class="bi bi-x-lg me-1"></i>
                            </AppButton>
                            <AppButton Class="btn btn-sm btn-success rounded-pill px-3 text-white"
                                       OnClick="ApproveSelectedAsync"
                                       Disabled="@_isUpdating"
                                       Text="@(_isUpdating ? "Approving..." : $"Approve ({_selectedRequestIds.Count})")">
                                @if (_isUpdating)
                                {
                                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                }
                                else
                                {
                                    <i class="bi bi-check-circle me-1"></i>
                                }
                            </AppButton>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- ═══════════ 3. DATA TABLE CARD ═══════════ -->
        <div class="att-req-grid-card">

            <!-- Context & Actions Banner -->
            <div class="att-req-context-banner d-flex align-items-center justify-content-between px-3 py-2 bg-light border-bottom flex-wrap gap-2">
                <div class="d-flex align-items-center gap-2">
                    <span class="status-dot-sm bg-primary"></span>
                    <span class="fw-semibold text-dark small">Request Records</span>
                    <span class="text-muted small">• Showing @FilteredRequests.Count of @_allRequests.Count requests</span>
                    @if (_selectedRequestIds.Count > 0)
                    {
                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 rounded-pill px-2.5 py-1 small">
                            @_selectedRequestIds.Count selected
                        </span>
                    }
                </div>

                @if (IsAdmin() || IsSuperAdmin())
                {
                    <div class="d-flex align-items-center gap-2">
                        <AppButton Class="@(_selectedRequestIds.Count > 0 ? "btn btn-sm btn-success d-inline-flex align-items-center gap-1.5 px-3 py-1.5 rounded-3 shadow-xs fw-medium text-white" : "btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1.5 px-3 py-1.5 rounded-3 shadow-xs fw-medium")"
                                   OnClick="PromptApproveSelected"
                                   Disabled="@(_isUpdating || _selectedRequestIds.Count == 0)"
                                   Text="@($"Approve Selected {(_selectedRequestIds.Count > 0 ? $"({_selectedRequestIds.Count})" : "")}".Trim())">
                            <i class="bi bi-check2-all"></i>
                        </AppButton>
                    </div>
                }
            </div>

            <!-- Table Container -->
            <div class="att-req-table-wrapper">
                @if (!FilteredRequests.Any())
                {
                    <div class="text-center py-5 px-3">
                        <div class="d-inline-flex align-items-center justify-content-center bg-light rounded-circle p-3 mb-3 text-secondary opacity-75" style="width:64px; height:64px;">
                            <i class="bi bi-inbox fs-2"></i>
                        </div>
                        <h6 class="fw-bold text-dark mb-1">No Requests Found</h6>
                        <p class="text-muted small mb-3">
                            @(HasActiveFilters ? "No requests match your current filters." : "There are no attendance requests available.")
                        </p>
                        @if (HasActiveFilters)
                        {
                            <button class="btn btn-sm btn-outline-primary rounded-pill px-3" @onclick="ClearFilters">
                                <i class="bi bi-arrow-counterclockwise me-1"></i> Reset Filters
                            </button>
                        }
                    </div>
                }
                else
                {
                    <table class="att-req-modern-table">
                        <thead>
                            <tr>
                                @if (IsAdmin() || IsSuperAdmin())
                                {
                                    <th class="th-select-col" style="width: 44px; text-align: center;">
                                        <AppCheckBox Value="@IsAllSelected"
                                                     ValueChanged="OnToggleSelectAll"
                                                     Disabled="@(!HasAnyPendingInCurrentPage)"
                                                     ContainerClass="form-check m-0 d-inline-flex justify-content-center align-items-center"
                                                     title="Select All Pending" />
                                    </th>
                                }
                                <th style="min-width: 220px;">EMPLOYEE</th>
                                <th style="min-width: 130px;">FROM DATE</th>
                                <th style="min-width: 130px;">TO DATE</th>
                                <th style="min-width: 110px;">CLOCK IN</th>
                                <th style="min-width: 110px;">CLOCK OUT</th>
                                <th style="min-width: 160px;">REASON</th>
                                <th style="min-width: 120px;">STATUS</th>
                                @if (IsAdmin() || IsSuperAdmin())
                                {
                                    <th style="width: 170px; text-align: center;">ACTION</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var req in PagedRequests)
                            {
                                <tr class="att-req-data-row @(IsSelected(req.Id) ? "att-req-row-selected" : "")">
                                    @if (IsAdmin() || IsSuperAdmin())
                                    {
                                        <td class="td-select-col" style="width: 44px; text-align: center;">
                                            @if (req.StatusId == Status.Pending)
                                            {
                                                <AppCheckBox Value="@IsSelected(req.Id)"
                                                             ValueChanged="@(selected => OnToggleSelect(req.Id, selected))"
                                                             Disabled="@_isUpdating"
                                                             ContainerClass="form-check m-0 d-inline-flex justify-content-center align-items-center"
                                                             title="Select request" />
                                            }
                                        </td>
                                    }
                                    <!-- EMPLOYEE (Avatar + Name) -->
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            @if (!string.IsNullOrWhiteSpace(req.ProfileImage))
                                            {
                                                <img src="@req.ProfileImage" alt="@req.EmployeeName" class="avatar-circle avatar-img" />
                                            }
                                            else
                                            {
                                                <div class="avatar-circle">
                                                    @GetInitials(req.EmployeeName)
                                                </div>
                                            }
                                            <span class="emp-name text-truncate">
                                                @FormatName(req.EmployeeName)
                                            </span>
                                        </div>
                                    </td>

                                    <!-- FROM DATE -->
                                    <td>
                                        <span class="date-badge">
                                            @(req.FromDate?.ToString("dd MMM yyyy") ?? "—")
                                        </span>
                                    </td>

                                    <!-- TO DATE -->
                                    <td>
                                        <span class="date-badge">
                                            @(req.ToDate?.ToString("dd MMM yyyy") ?? "—")
                                        </span>
                                    </td>

                                    <!-- CLOCK IN -->
                                    <td>
                                        @if (req.ClockIn != null)
                                        {
                                            <span class="time-pill time-pill-in">
                                                <i class="bi bi-box-arrow-in-right"></i>
                                                <span>@req.ClockIn.Value.ToString("hh:mm tt")</span>
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">—</span>
                                        }
                                    </td>

                                    <!-- CLOCK OUT -->
                                    <td>
                                        @if (req.ClockOut != null)
                                        {
                                            <span class="time-pill time-pill-out">
                                                <i class="bi bi-box-arrow-right"></i>
                                                <span>@req.ClockOut.Value.ToString("hh:mm tt")</span>
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">—</span>
                                        }
                                    </td>

                                    <!-- REASON -->
                                    <td>
                                        <div class="d-flex align-items-center gap-1.5 flex-wrap">
                                            <span class="reason-badge">
                                                @FormatReason(req.ReasonTypeId)
                                            </span>
                                            @if (!string.IsNullOrWhiteSpace(req.Description))
                                            {
                                                <span class="desc-info-icon" title="@req.Description">
                                                    <i class="bi bi-info-circle-fill"></i>
                                                </span>
                                            }
                                        </div>
                                    </td>

                                    <!-- STATUS BADGE -->
                                    <td>
                                        @RenderStatusBadge(req.StatusId)
                                    </td>

                                    <!-- ACTIONS -->
                                    @if (IsAdmin() || IsSuperAdmin())
                                    {
                                        <td class="text-center">
                                            @if (req.StatusId == Status.Pending)
                                            {
                                                <div class="d-inline-flex align-items-center gap-1.5">
                                                    <button type="button" class="btn-action-approve-solid"
                                                            title="Approve request"
                                                            disabled="@_isUpdating"
                                                            @onclick="() => UpdateStatus(req, Status.Approved)">
                                                        <i class="bi bi-check-lg"></i>
                                                    </button>
                                                    <button type="button" class="btn-action-reject-outline"
                                                            title="Reject request"
                                                            disabled="@_isUpdating"
                                                            @onclick="() => UpdateStatus(req, Status.Rejected)">
                                                        <i class="bi bi-x-lg"></i>
                                                    </button>
                                                </div>
                                            }
                                            else if (req.StatusId == Status.Approved)
                                            {
                                                <span class="text-success small fw-medium" title="@(string.IsNullOrWhiteSpace(req.ApprovedByName) ? "Approved" : $"Approved by {req.ApprovedByName}")">
                                                    <i class="bi bi-check-circle-fill me-1"></i>Approved
                                                </span>
                                            }
                                            else if (req.StatusId == Status.Rejected)
                                            {
                                                <span class="text-danger small fw-medium">
                                                    <i class="bi bi-x-circle-fill me-1"></i>Rejected
                                                </span>
                                            }
                                            else if (req.StatusId == Status.Cancelled)
                                            {
                                                <span class="text-muted small fw-medium">
                                                    <i class="bi bi-dash-circle me-1"></i>Cancelled
                                                </span>
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>

            <!-- Pagination Bar -->
            @if (FilteredRequests.Any())
            {
                <div class="att-req-pagination-bar d-flex flex-column flex-sm-row align-items-center justify-content-between gap-3">
                    <div class="d-flex align-items-center gap-2 text-muted small flex-wrap">
                        <span>Showing <strong>@StartIndex</strong> to <strong>@EndIndex</strong> of <strong>@TotalCount</strong> records</span>
                        <span class="text-black-50">•</span>
                        <div class="d-flex align-items-center gap-1.5">
                            <span>Show</span>
                            <select class="page-size-select" value="@_pageSize" @onchange="OnPageSizeChange">
                                <option value="10">10</option>
                                <option value="25">25</option>
                                <option value="50">50</option>
                                <option value="100">100</option>
                            </select>
                            <span>per page</span>
                        </div>
                    </div>

                    @if (TotalPages > 1)
                    {
                        <div class="d-flex align-items-center gap-1">
                            <button type="button" class="page-btn" disabled="@(_currentPage <= 1)" @onclick="() => GoToPage(_currentPage - 1)" title="Previous page">
                                <i class="bi bi-chevron-left"></i>
                            </button>
                            @for (int p = 1; p <= TotalPages; p++)
                            {
                                var pageNum = p;
                                <button type="button" class="page-btn @(pageNum == _currentPage ? "active" : "")" @onclick="() => GoToPage(pageNum)">
                                    @pageNum
                                </button>
                            }
                            <button type="button" class="page-btn" disabled="@(_currentPage >= TotalPages)" @onclick="() => GoToPage(_currentPage + 1)" title="Next page">
                                <i class="bi bi-chevron-right"></i>
                            </button>
                        </div>
                    }
                </div>
            }

        </div>

    </div>
}

@code {
    // ═══════════ STATE ═══════════

    private bool _isLoading;
    private bool _isUpdating;
    private string _loadingMessage = "Loading attendance requests...";

    private List<AttendanceRequestViewModel> _allRequests = new();
    private List<SelectOption> Employees = new();

    private Status? _statusFilter;
    private string? _selectedEmployeeName;
    private string? _selectedEmployeeNumber;

    private int _pendingCount;
    private int _approvedCount;
    private int _rejectedCount;

    private HashSet<int> _selectedRequestIds = new();
    private bool _showApproveModal;

    // Pagination
    private int _currentPage = 1;
    private int _pageSize = 10;

    // ═══════════ COMPUTED ═══════════
    private bool HasAnyPendingInCurrentPage =>
        PagedRequests.Any(r => r.StatusId == Status.Pending);

    private bool IsAllSelected =>
        HasAnyPendingInCurrentPage &&
        PagedRequests.Where(r => r.StatusId == Status.Pending).All(r => _selectedRequestIds.Contains(r.Id));

    private bool IsSelected(int id) => _selectedRequestIds.Contains(id);

    private bool HasActiveFilters
        => _statusFilter.HasValue || State.SelectedEmployeeId.HasValue || !string.IsNullOrWhiteSpace(_selectedEmployeeName);

    private List<AttendanceRequestViewModel> FilteredRequests
        => _allRequests
            .Where(r =>
                (!_statusFilter.HasValue || r.StatusId == _statusFilter) &&
                (!State.SelectedEmployeeId.HasValue ||
                 r.EmployeeId == State.SelectedEmployeeId) &&
                (string.IsNullOrWhiteSpace(_selectedEmployeeName) ||
                 (r.EmployeeName?.Contains(_selectedEmployeeName,
                     StringComparison.OrdinalIgnoreCase) ?? false)))
            .ToList();

    private int TotalCount => FilteredRequests.Count;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling((double)TotalCount / _pageSize));
    private int StartIndex => TotalCount == 0 ? 0 : (_currentPage - 1) * _pageSize + 1;
    private int EndIndex => Math.Min(_currentPage * _pageSize, TotalCount);

    private List<AttendanceRequestViewModel> PagedRequests =>
        FilteredRequests.Skip((_currentPage - 1) * _pageSize).Take(_pageSize).ToList();

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        _isLoading = true;

        try
        {
            _statusFilter = null;
            State.SelectedEmployeeId = null;
            State.SelectedEmployeeName = null;

            _selectedEmployeeName = null;
            _selectedEmployeeNumber = null;

            await Task.WhenAll(LoadEmployees(), LoadRequests());
        }
        catch (Exception ex)
        {
            await NotificationService.Error($"Failed to load data: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    // ═══════════ DATA ═══════════

    private async Task LoadRequests()
    {
        try
        {
            var result = await AttendanceRequestService.GetAllAsync();

            _allRequests = result?.IsSuccess == true
                ? result.Data ?? new()
                : new();

            RecalculateCounts();
        }
        catch
        {
            _allRequests = new();
            _pendingCount = _approvedCount = _rejectedCount = 0;
        }
    }

    private async Task LoadEmployees()
    {
        try
        {
            var result = await EmployeeService.GetEmployeesAsync();

            Employees = result?.IsSuccess == true && result.Data != null
                ? result.Data
                    .Select(e => new SelectOption
                    {
                        Value = e.Id.ToString(),
                        Text = $"{e.FullName} ({e.EmployeeNumber})"
                    })
                    .ToList()
                : new();
        }
        catch
        {
            Employees = new();
        }
    }

    private void RecalculateCounts()
    {
        _pendingCount = _allRequests.Count(r => r.StatusId == Status.Pending);
        _approvedCount = _allRequests.Count(r => r.StatusId == Status.Approved);
        _rejectedCount = _allRequests.Count(r => r.StatusId == Status.Rejected);
    }

    // ═══════════ EVENTS & FILTERS ═══════════

    private Task FilterByStatus(Status? status)
    {
        _statusFilter = status;
        _currentPage = 1;
        _selectedRequestIds.Clear();
        return Task.CompletedTask;
    }

    private async Task ClearFilters()
    {
        _statusFilter = null;
        State.SelectedEmployeeId = null;
        _selectedEmployeeName = null;
        _selectedEmployeeNumber = null;
        _currentPage = 1;
        _selectedRequestIds.Clear();
        await LoadRequests();
    }

    private async Task OnEmployeeChanged(string? empId)
    {
        State.SelectedEmployeeId =
            !string.IsNullOrWhiteSpace(empId) && empId != "0"
                ? int.Parse(empId)
                : null;
        _currentPage = 1;
        _selectedRequestIds.Clear();
        await LoadRequests();
    }

    private async Task OnEmployeeNameChanged(string? text)
    {
        _selectedEmployeeName = null;
        _selectedEmployeeNumber = null;

        if (!string.IsNullOrWhiteSpace(text))
        {
            var match = System.Text.RegularExpressions.Regex.Match(
                text, @"^(.*?)(?:\s*\((.*?)\))?$");

            if (match.Success)
            {
                _selectedEmployeeName = match.Groups[1].Value.Trim();
                _selectedEmployeeNumber = match.Groups[2].Value.Trim();
            }
        }

        _currentPage = 1;
        await LoadRequests();
    }

    private void GoToPage(int page)
    {
        _currentPage = Math.Clamp(page, 1, TotalPages);
        _selectedRequestIds.Clear();
    }

    private void OnPageSizeChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var size) && size > 0)
        {
            _pageSize = size;
            _currentPage = 1;
            _selectedRequestIds.Clear();
        }
    }

    private async Task UpdateStatus(AttendanceRequestViewModel req, Status newStatus)
    {
        var action = newStatus == Status.Approved ? "approve" : "reject";

        var confirmed = await JsRuntime.InvokeAsync<bool>(
            "confirm",
            $"Are you sure you want to {action} this attendance request?");

        if (!confirmed) return;

        _isUpdating = true;
        StateHasChanged();

        try
        {
            var employeeId = GetEmployeeId();
            if (employeeId <= 0)
            {
                employeeId = GetUserId() > 0 ? GetUserId() : 1;
            }

            var result = await AttendanceRequestService
                .UpdateRequestStatusAsync(req.Id, newStatus, employeeId);

            if (result?.IsSuccess == true)
            {
                await NotificationService.Success($"Request {action}d successfully.");
                await LoadRequests();
                RecalculateCounts();
                StateHasChanged();
            }
            else
            {
                await NotificationService.Error(result?.Message ?? "Operation failed.");
            }
        }
        finally
        {
            _isUpdating = false;
        }
    }

    private void OnToggleSelect(int id, bool selected)
    {
        if (selected)
            _selectedRequestIds.Add(id);
        else
            _selectedRequestIds.Remove(id);
    }

    private void OnToggleSelectAll(bool selectAll)
    {
        if (selectAll)
        {
            PagedRequests.Where(r => r.StatusId == Status.Pending)
                .Select(r => r.Id)
                .ToList()
                .ForEach(id => _selectedRequestIds.Add(id));
        }
        else
        {
            PagedRequests.Select(r => r.Id)
                .ToList()
                .ForEach(id => _selectedRequestIds.Remove(id));
        }
    }

    private void PromptApproveSelected()
    {
        if (_selectedRequestIds.Count == 0)
        {
            _ = NotificationService.Warning("Please select at least one pending request to approve.");
            return;
        }

        _showApproveModal = true;
    }

    private async Task ApproveSelectedAsync()
    {
        if (_selectedRequestIds.Count == 0)
        {
            _showApproveModal = false;
            return;
        }

        _isUpdating = true;
        StateHasChanged();

        try
        {
            var employeeId = GetEmployeeId();
            if (employeeId <= 0)
            {
                employeeId = GetUserId() > 0 ? GetUserId() : 1;
            }

            var idsToApprove = _selectedRequestIds.ToList();
            var result = await AttendanceRequestService.BulkApproveAsync(idsToApprove, employeeId);

            _selectedRequestIds.Clear();
            _showApproveModal = false;
            await LoadRequests();
            RecalculateCounts();

            if (result?.IsSuccess == true)
            {
                await NotificationService.Success(result.Message ?? $"Successfully approved {result.Data} attendance request(s).");
            }
            else
            {
                await NotificationService.Error(result?.Message ?? "Failed to approve selected requests.");
            }
        }
        catch (Exception ex)
        {
            await NotificationService.Error($"Error approving requests: {ex.Message}");
        }
        finally
        {
            _isUpdating = false;
            StateHasChanged();
        }
    }

    // ═══════════ FORMATTERS & BADGES ═══════════

    private string GetEmployeeValue()
        => State.SelectedEmployeeId?.ToString() ?? "0";

    private static string FormatName(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "Employee";
        var words = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Join(" ", words.Select(w => char.ToUpper(w[0]) + (w.Length > 1 ? w[1..] : "")));
    }

    private static string GetInitials(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return "EM";
        return arna.HRMS.Helper.Avatar.AvatarHelper.GetInitials(fullName);
    }

    private static string FormatReason(AttendanceReasonType? reason) => reason switch
    {
        AttendanceReasonType.ForgotToClockIn => "Forgot To Clock In",
        AttendanceReasonType.ForgotToClockOut => "Forgot To Clock Out",
        AttendanceReasonType.LateClockIn => "Late Clock In",
        AttendanceReasonType.EarlyClockOut => "Early Clock Out",
        AttendanceReasonType.ClientVisit => "Client Visit",
        AttendanceReasonType.WorkFromHome => "Work From Home",
        AttendanceReasonType.TechnicalIssue => "Technical Issue",
        AttendanceReasonType.CompOffRequest => "Comp-off Request",
        _ => reason?.ToString() ?? "—"
    };

    private RenderFragment RenderStatusBadge(Status status) => builder =>
    {
        var (cssClass, label) = status switch
        {
            Status.Approved => ("att-status-approved", "Approved"),
            Status.Pending => ("att-status-pending", "Pending"),
            Status.Rejected => ("att-status-rejected", "Rejected"),
            Status.Cancelled => ("att-status-cancelled", "Cancelled"),
            _ => ("att-status-default", status.ToString())
        };

        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", $"att-req-status-pill {cssClass}");
        builder.OpenElement(2, "span");
        builder.AddAttribute(3, "class", "status-dot");
        builder.CloseElement();
        builder.OpenElement(4, "span");
        builder.AddContent(5, label);
        builder.CloseElement();
        builder.CloseElement();
    };
}
