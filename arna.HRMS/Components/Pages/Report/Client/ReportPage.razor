@using arna.HRMS.Components.Loader
@using arna.HRMS.Components.lib.components.ui.Forms
@using arna.HRMS.Models.Common.Table
@using arna.HRMS.Models.Enums
@using arna.HRMS.Models.ViewModels
@using arna.HRMS.Models.ViewModels.Attendance
@using arna.HRMS.Services
@using arna.HRMS.Services.Auth
@using arna.HRMS.Services.Report
@using arna.HRMS.Services.Export
@using arna.HRMS.Services.Common
@using Microsoft.AspNetCore.Components.Authorization

@inherits AuthenticatedLayoutBase
@inject IReportService ReportService
@inject IEmployeeService EmployeeService
@inject NotificationService NotificationService
@inject AuthenticationStateProvider AuthProvider
@inject IExcelExportService ExcelExportService
@inject IJSRuntime JS

@if (isLoading)
{
    <Loader Visible="isLoading" Message="@loadingMessage" />
}
else if (Employee == null)
{
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body text-center py-5">
            <div class="mb-3">
                <i class="bi bi-exclamation-triangle text-warning fs-1"></i>
            </div>
            <h5 class="fw-semibold text-muted mb-2">Employee Not Found</h5>
            <p class="text-muted mb-0">Unable to load your employee information. Please contact HR.</p>
        </div>
    </div>
}
else
{
    <div class="att-animate">

        <!-- ══════════ 1. HEADER & EXPORT ══════════ -->
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-3">
            <div>
                <h4 class="fw-bold mb-1 text-dark d-flex align-items-center gap-2">
                    <span class="p-2 rounded-2 bg-primary bg-opacity-10 text-primary d-inline-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                        <i class="bi bi-file-earmark-bar-graph-fill fs-5"></i>
                    </span>
                    Attendance Report
                </h4>
                <p class="text-muted small mb-0">Self-service monthly attendance logs, working hours, and status breakdown.</p>
            </div>
            <div>
                <button class="btn btn-excel btn-sm rounded-pill px-3 py-2 shadow-sm d-inline-flex align-items-center gap-2 fw-semibold"
                        @onclick="ExportToExcelAsync"
                        disabled="@(isExporting || !cachedFilteredRecords.Any())"
                        title="Download Attendance Report as Excel (.xlsx)">
                    @if (isExporting)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        <span>Exporting...</span>
                    }
                    else
                    {
                        <i class="bi bi-file-earmark-excel-fill"></i>
                        <span>Export to Excel</span>
                    }
                </button>
            </div>
        </div>

        <!-- ══════════ 2. EMPLOYEE HERO PROFILE CARD ══════════ -->
        <div class="card border-0 shadow-sm rounded-3 mb-3 employee-hero-card">
            <div class="card-body p-3 p-md-4">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                    
                    <!-- Left: Employee Identity -->
                    <div class="d-flex align-items-center gap-3">
                        <div class="att-hero-avatar"
                             style="background:@GetColor(Employee.FullName ?? "");">
                            @GetInitials(Employee.FullName ?? "")
                        </div>
                        <div>
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <h5 class="fw-bold text-dark mb-0">@Employee.FullName</h5>
                                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 rounded-pill px-2.5 py-1 fw-semibold small">
                                    @Employee.EmployeeNumber
                                </span>
                            </div>
                            <div class="text-muted small mt-1 d-flex align-items-center gap-2">
                                @if (Employee.Designation.HasValue)
                                {
                                    <span><i class="bi bi-briefcase me-1 text-primary"></i>@Employee.Designation.Value</span>
                                }
                                @if (!string.IsNullOrEmpty(Employee.DepartmentName))
                                {
                                    <span>•</span>
                                    <span><i class="bi bi-building me-1 text-primary"></i>@Employee.DepartmentName</span>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Right: Period & Attendance Health -->
                    <div class="d-flex align-items-center gap-3 ms-auto flex-wrap">
                        <div class="text-end d-none d-sm-block">
                            <small class="text-muted text-uppercase fw-semibold" style="font-size: 0.7rem; letter-spacing: 0.5px;">Active Period</small>
                            <div class="fw-semibold text-dark small">
                                <i class="bi bi-calendar3 text-primary me-1"></i>
                                @(filterMode == "month" ? $"{MonthName(selectedMonth)} {selectedYear}" : $"{FormatDate(fromDate)} - {FormatDate(toDate)}")
                            </div>
                        </div>

                        <div class="vr opacity-25 d-none d-sm-block" style="height: 36px;"></div>

                        <div class="d-flex align-items-center gap-2 px-3 py-2 rounded-3 @RateBadgeClass(attendanceRate) shadow-xs">
                            <div class="fs-4 fw-bold">@attendanceRate%</div>
                            <div class="lh-sm text-start">
                                <div class="fw-semibold small">Attendance Rate</div>
                                <small class="opacity-75" style="font-size: 0.72rem;">@RateStatusText(attendanceRate)</small>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <!-- ══════════ 3. UNIFIED TABLE & CONTROLS CARD ══════════ -->
        <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
            <div class="card-header bg-white border-bottom p-3 p-md-4">
                
                <!-- Unified Controls: Filter Chips + Date Controls -->
                <div class="d-flex flex-column flex-xl-row align-items-xl-center justify-content-between gap-3">
                    
                    <!-- Status Filter Tabs / Chips -->
                    <div class="d-flex flex-wrap align-items-center gap-1.5">
                        <button type="button"
                                class="btn btn-sm att-stat-chip @(selectedStatusFilter == null ? "active" : "")"
                                @onclick="() => ToggleStatusFilter(null)"
                                title="View all records">
                            <span class="att-chip-dot bg-secondary"></span>
                            <span class="att-chip-label">All</span>
                            <strong class="att-chip-value">@cachedFilteredRecords.Count</strong>
                        </button>

                        <button type="button"
                                class="btn btn-sm att-stat-chip @(selectedStatusFilter == nameof(AttendanceStatus.Present) ? "active" : "")"
                                @onclick="() => ToggleStatusFilter(nameof(AttendanceStatus.Present))"
                                title="Filter Present">
                            <span class="att-chip-dot bg-success"></span>
                            <span class="att-chip-label text-success">Present</span>
                            <strong class="att-chip-value text-success">@presentCount</strong>
                        </button>

                        <button type="button"
                                class="btn btn-sm att-stat-chip @(selectedStatusFilter == nameof(AttendanceStatus.Late) ? "active" : "")"
                                @onclick="() => ToggleStatusFilter(nameof(AttendanceStatus.Late))"
                                title="Filter Late">
                            <span class="att-chip-dot bg-warning"></span>
                            <span class="att-chip-label text-warning-emphasis">Late</span>
                            <strong class="att-chip-value text-warning-emphasis">@lateCount</strong>
                        </button>

                        <button type="button"
                                class="btn btn-sm att-stat-chip @(selectedStatusFilter == nameof(AttendanceStatus.HalfDay) ? "active" : "")"
                                @onclick="() => ToggleStatusFilter(nameof(AttendanceStatus.HalfDay))"
                                title="Filter Half Day">
                            <span class="att-chip-dot bg-info"></span>
                            <span class="att-chip-label text-info-emphasis">Half Day</span>
                            <strong class="att-chip-value text-info-emphasis">@halfDayCount</strong>
                        </button>

                        <button type="button"
                                class="btn btn-sm att-stat-chip @(selectedStatusFilter == nameof(AttendanceStatus.OnLeave) ? "active" : "")"
                                @onclick="() => ToggleStatusFilter(nameof(AttendanceStatus.OnLeave))"
                                title="Filter On Leave">
                            <span class="att-chip-dot bg-secondary"></span>
                            <span class="att-chip-label text-secondary">Leave</span>
                            <strong class="att-chip-value text-secondary">@onLeaveCount</strong>
                        </button>
                    </div>

                    <!-- Right Controls: Mode Toggle, Month/Year / Range & Reset -->
                    <div class="d-flex align-items-center flex-wrap gap-2 ms-xl-auto">
                        
                        <div class="btn-group btn-group-sm" role="group">
                            <button type="button"
                                    class="btn @(filterMode == "month" ? "btn-primary shadow-sm" : "btn-outline-secondary")"
                                    @onclick='() => SwitchFilterMode("month")'>
                                <i class="bi bi-calendar3 me-1"></i>Monthly
                            </button>
                            <button type="button"
                                    class="btn @(filterMode == "dateRange" ? "btn-primary shadow-sm" : "btn-outline-secondary")"
                                    @onclick='() => SwitchFilterMode("dateRange")'>
                                <i class="bi bi-calendar-range me-1"></i>Range
                            </button>
                        </div>

                        @if (filterMode == "month")
                        {
                            <select class="form-select form-select-sm"
                                    style="width: auto; min-width: 120px;"
                                    value="@selectedMonth"
                                    @onchange="OnMonthChanged">
                                @for (int m = 1; m <= 12; m++)
                                {
                                    <option value="@m">@MonthName(m)</option>
                                }
                            </select>

                            <select class="form-select form-select-sm"
                                    style="width: auto; min-width: 90px;"
                                    value="@selectedYear"
                                    @onchange="OnYearChanged">
                                @for (int y = DateTime.Today.Year - 5; y <= DateTime.Today.Year + 1; y++)
                                {
                                    <option value="@y">@y</option>
                                }
                            </select>
                        }
                        else
                        {
                            <input type="text"
                                   class="form-control form-control-sm @(fromDateError ? "is-invalid" : "")"
                                   placeholder="DD/MM/YY"
                                   style="width: 120px;"
                                   maxlength="8"
                                   value="@FormatDate(fromDate)"
                                   @onchange="OnFromDateChanged" />

                            <input type="text"
                                   class="form-control form-control-sm @(toDateError ? "is-invalid" : "")"
                                   placeholder="DD/MM/YY"
                                   style="width: 120px;"
                                   maxlength="8"
                                   value="@FormatDate(toDate)"
                                   @onchange="OnToDateChanged" />
                        }

                        <button class="btn btn-sm btn-outline-secondary rounded-pill px-3"
                                @onclick="ResetFilters"
                                title="Reset to current month">
                            <i class="bi bi-arrow-counterclockwise me-1"></i>Reset
                        </button>

                    </div>
                </div>

            </div>

            <!-- Table Body -->
            <div class="card-body p-0">
                @if (!cachedFilteredRecords.Any())
                {
                    <div class="text-center py-5">
                        <div class="mb-3">
                            <i class="bi bi-calendar-x display-3 text-muted opacity-25"></i>
                        </div>
                        <h6 class="fw-bold text-dark mb-1">No Attendance Records Found</h6>
                        <p class="text-muted small mb-3">
                            No logs found for @(filterMode == "month" ? $"{MonthName(selectedMonth)} {selectedYear}" : $"{FormatDate(fromDate)} to {FormatDate(toDate)}")
                        </p>
                        <button class="btn btn-sm btn-primary rounded-pill px-4 shadow-sm"
                                @onclick="ResetFilters">
                            <i class="bi bi-arrow-counterclockwise me-1"></i>Reset to Current Month
                        </button>
                    </div>
                }
                else if (!DisplayRecords.Any())
                {
                    <div class="text-center py-5">
                        <i class="bi bi-funnel display-4 text-muted opacity-25 d-block mb-2"></i>
                        <h6 class="fw-semibold text-dark mb-1">No @selectedStatusFilter Records</h6>
                        <p class="text-muted small mb-3">There are no records matching the selected status in this period.</p>
                        <button class="btn btn-sm btn-outline-primary rounded-pill px-3"
                                @onclick="ClearStatusFilter">
                            <i class="bi bi-x-lg me-1"></i>Show All Records
                        </button>
                    </div>
                }
                else
                {
                    <AppTable TItem="AttendanceReportViewModel"
                              Items="DisplayRecords"
                              Columns="TableSchemas.EmployeeAttendanceDetailReport"
                              ShowActions="false"
                              EnablePagination="true"
                              PageSize="15"
                              WrapperClass="att-detail-table"
                              RowClassFunc="GetRowClass" />
                }
            </div>
        </div>
    </div>
}

@code {

    private EmployeeViewModel? Employee;
    private string filterMode = "month";
    private int selectedYear;
    private int selectedMonth;
    private DateTime fromDate;
    private DateTime toDate;
    private bool fromDateError;
    private bool toDateError;
    private bool isLoading;
    private bool isExporting;
    private string loadingMessage = "Loading your attendance report…";
    private string? selectedStatusFilter;
    private List<AttendanceReportViewModel> allRecords = new();
    private List<AttendanceReportViewModel> cachedFilteredRecords = new();
    private int presentCount, absentCount, lateCount, halfDayCount, onLeaveCount, holidayCount;
    private double weightedPresentDays, averageCount, attendanceRate;
    private int totalWorkingDays;

    private List<AttendanceReportViewModel> DisplayRecords =>
        string.IsNullOrEmpty(selectedStatusFilter)
            ? cachedFilteredRecords
            : cachedFilteredRecords
                .Where(r => r.AttendanceStatus?.ToString() == selectedStatusFilter)
                .ToList();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await base.OnInitializedAsync();
            isLoading = true;
            StateHasChanged();

            int empId = GetEmployeeId();

            if (empId == 0)
            {
                try
                {
                    var authState = await AuthProvider.GetAuthenticationStateAsync();
                    var user = authState?.User;

                    if (user != null)
                    {
                        var empIdClaim = user.FindFirst("EmployeeId")?.Value;
                        if (!string.IsNullOrEmpty(empIdClaim) && int.TryParse(empIdClaim, out var claimEmpId))
                        {
                            empId = claimEmpId;
                        }
                    }
                }
                catch { /* Fallback */ }
            }

            if (empId > 0)
            {
                var empResult = await EmployeeService.GetEmployeeByIdAsync(empId);
                if (empResult?.IsSuccess == true && empResult.Data != null)
                {
                    Employee = empResult.Data;
                }
                else
                {
                    await NotificationService.Error("Failed to load employee information. Please ensure your employee record is linked to your account.");
                    return;
                }
            }
            else
            {
                await NotificationService.Error("Unable to identify current employee. EmployeeId not found. Please contact HR to link your employee record.");
                return;
            }

            filterMode = "month";
            selectedYear = DateTime.Today.Year;
            selectedMonth = DateTime.Today.Month;
            SetDefaultDateRange();

            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            await NotificationService.Error($"Error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadDataAsync()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            if (Employee == null) return;

            int? yearParam;
            int? monthParam;
            DateTime? fromParam;
            DateTime? toParam;

            if (filterMode == "month")
            {
                yearParam = selectedYear;
                monthParam = selectedMonth;
                fromParam = null;
                toParam = null;
            }
            else
            {
                yearParam = null;
                monthParam = null;
                fromParam = fromDate;
                toParam = toDate;
            }

            var result = await ReportService.GetEmployeeDailyAttendanceReportAsync(
                yearParam, monthParam, Employee.Id, null, null, fromParam, toParam);

            if (result?.IsSuccess == true && result.Data != null)
            {
                allRecords = result.Data;
            }
            else
            {
                allRecords = new();
            }
        }
        catch (Exception ex)
        {
            allRecords = new();
            await NotificationService.Error($"Error: {ex.Message}");
        }
        finally
        {
            RefreshCache();
            isLoading = false;
            StateHasChanged();
        }
    }

    private void RefreshCache()
    {
        if (filterMode == "dateRange")
        {
            cachedFilteredRecords = allRecords
                .Where(r => r.AttendanceDate.Date >= fromDate.Date
                          && r.AttendanceDate.Date <= toDate.Date)
                .OrderBy(r => r.AttendanceDate)
                .ToList();
        }
        else
        {
            cachedFilteredRecords = allRecords
                .Where(r => r.AttendanceDate.Year == selectedYear
                          && r.AttendanceDate.Month == selectedMonth)
                .OrderBy(r => r.AttendanceDate)
                .ToList();
        }

        ComputeStatistics();
    }

    private void ComputeStatistics()
    {
        var records = cachedFilteredRecords;

        presentCount = records.Count(r => r.AttendanceStatus == AttendanceStatus.Present);
        absentCount = records.Count(r => r.AttendanceStatus == AttendanceStatus.Absent);
        lateCount = records.Count(r => r.AttendanceStatus == AttendanceStatus.Late);
        halfDayCount = records.Count(r => r.AttendanceStatus == AttendanceStatus.HalfDay);
        onLeaveCount = records.Count(r => r.AttendanceStatus == AttendanceStatus.OnLeave);
        holidayCount = records.Count(r => r.AttendanceStatus == AttendanceStatus.Holiday);

        weightedPresentDays = presentCount + lateCount + (halfDayCount * 0.5);
        totalWorkingDays = records.Count - holidayCount;

        attendanceRate = totalWorkingDays > 0
            ? Math.Min(100, Math.Round((weightedPresentDays / totalWorkingDays) * 100, 1))
            : 0;

        averageCount = Math.Round(weightedPresentDays, 1);
    }

    private async Task ExportToExcelAsync()
    {
        if (Employee == null || !cachedFilteredRecords.Any())
        {
            await NotificationService.Warning("No attendance records to export.");
            return;
        }

        try
        {
            isExporting = true;
            StateHasChanged();

            string periodTitle = filterMode == "month"
                ? $"{MonthName(selectedMonth)} {selectedYear}"
                : $"{FormatDate(fromDate)} to {FormatDate(toDate)}";

            var bytes = ExcelExportService.ExportAttendanceReport(
                Employee,
                cachedFilteredRecords,
                periodTitle,
                attendanceRate,
                averageCount,
                totalWorkingDays,
                presentCount,
                lateCount,
                halfDayCount,
                absentCount,
                onLeaveCount);

            var base64 = Convert.ToBase64String(bytes);
            var safeEmpNum = string.IsNullOrWhiteSpace(Employee.EmployeeNumber) ? "EMP" : Employee.EmployeeNumber.Replace(" ", "_");
            var fileName = $"Attendance_Report_{safeEmpNum}_{DateTime.Now:yyyyMMdd_HHmm}.xlsx";

            try
            {
                await JS.InvokeVoidAsync("downloadFileFromBase64", fileName, base64, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
            }
            catch (JSException jex) when (jex.Message.Contains("downloadFileFromBase64") || jex.Message.Contains("undefined"))
            {
                // Self-healing: inject the helper dynamically if browser hasn't refreshed scripts yet
                await JS.InvokeVoidAsync("eval", @"
                    window.downloadFileFromBase64 = function(fileName, base64Data, contentType) {
                        contentType = contentType || 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet';
                        var byteChars = atob(base64Data);
                        var byteNums = new Array(byteChars.length);
                        for (var i = 0; i < byteChars.length; i++) { byteNums[i] = byteChars.charCodeAt(i); }
                        var blob = new Blob([new Uint8Array(byteNums)], { type: contentType });
                        var url = URL.createObjectURL(blob);
                        var a = document.createElement('a');
                        a.href = url;
                        a.download = fileName;
                        document.body.appendChild(a);
                        a.click();
                        document.body.removeChild(a);
                        setTimeout(function() { URL.revokeObjectURL(url); }, 1500);
                    };
                ");
                await JS.InvokeVoidAsync("downloadFileFromBase64", fileName, base64, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
            }

            await NotificationService.Success("Attendance report exported to Excel successfully!");
        }
        catch (Exception ex)
        {
            await NotificationService.Error($"Failed to export Excel: {ex.Message}");
        }
        finally
        {
            isExporting = false;
            StateHasChanged();
        }
    }

    private static string FormatDate(DateTime date)
        => date.ToString("dd/MM/yy");

    private static bool TryParseDate(string? input, out DateTime result)
    {
        result = default;
        if (string.IsNullOrWhiteSpace(input)) return false;

        string[] formats = {
            "dd/MM/yy", "dd-MM-yy", "dd.MM.yy",
            "dd/MM/yyyy", "dd-MM-yyyy", "dd.MM.yyyy"
        };

        return DateTime.TryParseExact(
            input.Trim(),
            formats,
            System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.None,
            out result);
    }

    private async Task SwitchFilterMode(string mode)
    {
        if (filterMode == mode) return;
        filterMode = mode;
        selectedStatusFilter = null;
        fromDateError = false;
        toDateError = false;

        if (mode == "month")
        {
            selectedYear = DateTime.Today.Year;
            selectedMonth = DateTime.Today.Month;
        }
        else
        {
            fromDate = new DateTime(selectedYear, selectedMonth, 1);
            toDate = new DateTime(selectedYear, selectedMonth,
                                  DateTime.DaysInMonth(selectedYear, selectedMonth));
        }

        await LoadDataAsync();
    }

    private async Task OnMonthChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var m) && m >= 1 && m <= 12)
        {
            selectedMonth = m;
            selectedStatusFilter = null;
            await LoadDataAsync();
        }
    }

    private async Task OnYearChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var y) && y >= 1900)
        {
            selectedYear = y;
            selectedStatusFilter = null;
            await LoadDataAsync();
        }
    }

    private async Task OnFromDateChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        if (TryParseDate(val, out var d))
        {
            fromDate = d;
            fromDateError = false;
            selectedStatusFilter = null;
            if (fromDate > toDate) toDate = fromDate;
            await LoadDataAsync();
        }
        else
        {
            fromDateError = true;
        }
    }

    private async Task OnToDateChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        if (TryParseDate(val, out var d))
        {
            toDate = d;
            toDateError = false;
            selectedStatusFilter = null;
            if (toDate < fromDate) fromDate = toDate;
            await LoadDataAsync();
        }
        else
        {
            toDateError = true;
        }
    }

    private async Task ResetFilters()
    {
        filterMode = "month";
        selectedYear = DateTime.Today.Year;
        selectedMonth = DateTime.Today.Month;
        SetDefaultDateRange();
        selectedStatusFilter = null;
        fromDateError = false;
        toDateError = false;
        await LoadDataAsync();
    }

    private void SetDefaultDateRange()
    {
        var today = DateTime.Today;
        fromDate = new DateTime(today.Year, today.Month, 1);
        toDate = new DateTime(today.Year, today.Month,
                              DateTime.DaysInMonth(today.Year, today.Month));
    }

    private void ToggleStatusFilter(string? status)
    {
        if (status == null)
        {
            selectedStatusFilter = null;
            return;
        }
        selectedStatusFilter = selectedStatusFilter == status ? null : status;
    }

    private void ClearStatusFilter() => selectedStatusFilter = null;

    private static string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var p = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return p.Length >= 2
            ? $"{p[0][0]}{p[1][0]}".ToUpper()
            : p[0][..Math.Min(2, p[0].Length)].ToUpper();
    }

    private static string MonthName(int m) =>
        System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m);

    private static string GetColor(string name)
    {
        string[] palette = { "#4e73df", "#1cc88a", "#36b9cc", "#f6c23e",
                             "#e74a3b", "#6f42c1", "#fd7e14", "#20c997" };
        return palette[Math.Abs(name.GetHashCode()) % palette.Length];
    }

    private double ComputeProgressWidth() =>
        cachedFilteredRecords.Count > 0
            ? Math.Min(100, (weightedPresentDays / cachedFilteredRecords.Count) * 100)
            : 0;

    private static string RateTextColor(double r) =>
        r >= 80 ? "text-success" : r >= 60 ? "text-warning" : "text-danger";

    private static string RateBarColor(double r) =>
        r >= 80 ? "bg-success" : r >= 60 ? "bg-warning" : "bg-danger";

    private static string RateStatusText(double r) =>
        r >= 90 ? "Excellent" : r >= 80 ? "Good" : r >= 60 ? "Average" : "Needs Attention";

    private static string RateBadgeClass(double r) =>
        r >= 80 ? "bg-success bg-opacity-10 text-success border border-success border-opacity-25"
                : r >= 60 ? "bg-warning bg-opacity-10 text-warning-emphasis border border-warning border-opacity-25"
                          : "bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25";

    private string GetRowClass(AttendanceReportViewModel rec) =>
        rec.AttendanceDate.DayOfWeek == DayOfWeek.Saturday || rec.AttendanceDate.DayOfWeek == DayOfWeek.Sunday
            ? "att-row-weekend"
            : "att-row-clean";
}
