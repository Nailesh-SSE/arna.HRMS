@using arna.HRMS.Components.Loader
@using arna.HRMS.Components.lib.components.ui.Forms
@using arna.HRMS.Models.Common.Table
@using arna.HRMS.Models.Enums
@using arna.HRMS.Models.ViewModels
@using arna.HRMS.Services
@using arna.HRMS.Services.Report
@using arna.HRMS.Services.Common

@inject IReportService ReportService
@inject NotificationService NotificationService

@if (isLoading)
{
    <Loader Visible="isLoading" Message="@loadingMessage" />
}
else
{
    <div class="att-detail-animated">

        <!-- ══════════ BACK + BREADCRUMB ══════════ -->
        @if (ShowBackButton == true)
        {
            <div class="d-flex align-items-center gap-2 mb-3 flex-wrap">
                <button class="btn btn-sm btn-outline-primary rounded-pill px-3 att-detail-back-btn"
                        @onclick="HandleBack">
                    <i class="bi bi-arrow-left me-1"></i>Back
                </button>
                <nav>
                    <ol class="breadcrumb mb-0 small">
                        <li class="breadcrumb-item">
                            <a href="javascript:void(0)" @onclick="HandleBack"
                               class="text-decoration-none text-primary">
                                Leave Report
                            </a>
                        </li>
                        <li class="breadcrumb-item active text-muted">@Employee.FullName</li>
                    </ol>
                </nav>
            </div>
        }

        <!-- ══════════ EMPLOYEE HERO PROFILE CARD ══════════ -->
        <div class="card border-0 shadow-sm rounded-3 mb-3 bg-white">
            <div class="card-body p-3 p-md-4">
                <div class="row align-items-center g-3">
                    <div class="col-12 col-md-auto text-center text-md-start">
                        <div class="att-detail-avatar mx-auto mx-md-0"
                             style="background-color:@GetColor(Employee.FullName ?? "")">
                            @GetInitials(Employee.FullName ?? "")
                        </div>
                    </div>
                    <div class="col-12 col-sm text-center text-sm-start">
                        <h4 class="fw-bold mb-1 text-dark">@Employee.FullName</h4>
                        <div class="d-flex flex-wrap gap-2 justify-content-center justify-content-sm-start align-items-center">
                            <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-1">
                                <i class="bi bi-person-badge me-1"></i>@Employee.EmployeeNumber
                            </span>
                            @if (Employee.Designation.HasValue)
                            {
                                <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3 py-1">
                                    <i class="bi bi-briefcase me-1"></i>@Employee.Designation.Value
                                </span>
                            }
                            @if (!string.IsNullOrWhiteSpace(Employee.DepartmentName))
                            {
                                <span class="badge bg-info bg-opacity-10 text-info rounded-pill px-3 py-1">
                                    <i class="bi bi-building me-1"></i>@Employee.DepartmentName
                                </span>
                            }
                        </div>
                    </div>
                    <div class="col-12 col-md-auto text-center text-md-end">
                        <div class="d-flex flex-column align-items-center align-items-md-end gap-2">
                            <span class="badge bg-light text-primary border px-3 py-2 fs-6 rounded-pill shadow-xs">
                                <i class="bi bi-calendar3 me-1"></i>
                                @if (filterMode == "month")
                                {
                                    <span>@MonthName(selectedMonth) @selectedYear</span>
                                }
                                else
                                {
                                    <span>@FormatDate(fromDate) - @FormatDate(toDate)</span>
                                }
                            </span>
                            <div class="d-flex gap-2">
                                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-3 py-1 rounded-pill small">
                                    <i class="bi bi-card-checklist me-1"></i><strong>@cachedFilteredRecords.Count</strong> Records
                                </span>
                                <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 px-3 py-1 rounded-pill small">
                                    <i class="bi bi-calendar-event me-1"></i><strong>@cachedFilteredRecords.Sum(r => r.LeaveDays)</strong> Days
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ══════════ FILTER TOOLBAR CARD ══════════ -->
        <div class="card border-0 shadow-sm rounded-3 mb-3 bg-white">
            <div class="card-body p-3">
                <div class="row align-items-end g-3">
                    <!-- Filter Mode Toggle -->
                    <div class="col-12 col-sm-auto">
                        <label class="form-label small fw-semibold text-muted mb-1">
                            <i class="bi bi-funnel me-1"></i>Filter By
                        </label>
                        <div class="btn-group btn-group-sm d-flex" role="group">
                            <button type="button"
                                    class="btn @(filterMode == "month" ? "btn-primary shadow-sm" : "btn-outline-primary")"
                                    @onclick='() => SwitchFilterMode("month")'>
                                <i class="bi bi-calendar3 me-1"></i>Monthly
                            </button>
                            <button type="button"
                                    class="btn @(filterMode == "dateRange" ? "btn-primary shadow-sm" : "btn-outline-primary")"
                                    @onclick='() => SwitchFilterMode("dateRange")'>
                                <i class="bi bi-calendar-range me-1"></i>Date Range
                            </button>
                        </div>
                    </div>

                    <!-- Month & Year -->
                    @if (filterMode == "month")
                    {
                        <div class="col-6 col-sm-4 col-md-3 col-lg-2">
                            <label class="form-label small fw-semibold text-muted mb-1">Month</label>
                            <select class="form-select form-select-sm"
                                    value="@selectedMonth"
                                    @onchange="OnMonthChanged">
                                @for (int m = 1; m <= 12; m++)
                                {
                                    <option value="@m">@MonthName(m)</option>
                                }
                            </select>
                        </div>
                        <div class="col-6 col-sm-4 col-md-3 col-lg-2">
                            <label class="form-label small fw-semibold text-muted mb-1">Year</label>
                            <select class="form-select form-select-sm"
                                    value="@selectedYear"
                                    @onchange="OnYearChanged">
                                @for (int y = DateTime.Today.Year - 5; y <= DateTime.Today.Year + 1; y++)
                                {
                                    <option value="@y">@y</option>
                                }
                            </select>
                        </div>
                    }

                    <!-- Date Range (DD/MM/YY) -->
                    @if (filterMode == "dateRange")
                    {
                        <div class="col-6 col-sm-4 col-md-3 col-lg-2">
                            <label class="form-label small fw-semibold text-muted mb-1">From</label>
                            <input type="date"
                                   class="form-control form-control-sm"
                                   value="@fromDate.ToString("yyyy-MM-dd")"
                                   @onchange="OnFromDateInputChanged" />
                        </div>
                        <div class="col-6 col-sm-4 col-md-3 col-lg-2">
                            <label class="form-label small fw-semibold text-muted mb-1">To</label>
                            <input type="date"
                                   class="form-control form-control-sm"
                                   value="@toDate.ToString("yyyy-MM-dd")"
                                   @onchange="OnToDateInputChanged" />
                        </div>
                    }

                    <!-- Reset -->
                    <div class="col-auto">
                        <button class="btn btn-sm btn-outline-secondary rounded-pill px-3"
                                @onclick="ResetFilters"
                                title="Reset to current month">
                            <i class="bi bi-arrow-counterclockwise me-1"></i>Reset
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- ══════════ DATA TABLE OR EMPTY STATE ══════════ -->
        <div class="card border-0 shadow-sm rounded-3 overflow-hidden bg-white">
            <div class="card-header bg-white border-0 py-3 px-3 px-md-4">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <h6 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                        <i class="bi bi-table text-primary"></i>
                        Leave History
                        <span class="badge bg-light text-dark border rounded-pill">
                            @cachedFilteredRecords.Count
                        </span>
                    </h6>
                    <small class="text-muted">
                        Showing leave details for <strong>@Employee.FullName</strong>
                    </small>
                </div>
            </div>

            <div class="card-body p-0">
                @if (!cachedFilteredRecords.Any())
                {
                    <div class="text-center py-5">
                        <div class="mb-3">
                            <i class="bi bi-calendar-x display-3 text-muted opacity-25"></i>
                        </div>
                        <h5 class="fw-semibold text-muted mb-1">No Leave Records Found</h5>
                        <p class="text-muted small mb-3">
                            No leave data found for <strong>@Employee.FullName</strong>
                            @if (filterMode == "month")
                            {
                                <span>in <strong>@MonthName(selectedMonth) @selectedYear</strong>.</span>
                            }
                            else
                            {
                                <span>from <strong>@FormatDate(fromDate)</strong> to <strong>@FormatDate(toDate)</strong>.</span>
                            }
                        </p>
                        <button class="btn btn-sm btn-outline-primary rounded-pill px-3"
                                @onclick="ResetFilters">
                            <i class="bi bi-arrow-counterclockwise me-1"></i>Reset to Current Month
                        </button>
                    </div>
                }
                else
                {
                    <AppTable TItem="EmployeeLeaveDetailsReportViewModel"
                              Items="cachedFilteredRecords"
                              Columns="TableSchemas.EmployeeLeaveDetailsReport"
                              ShowActions="false"
                              EnablePagination="true"
                              PageSize="10"
                              WrapperClass="att-detail-table" />
                }
            </div>
        </div>

    </div>
}

@code {

    [Parameter, EditorRequired]
    public EmployeeViewModel Employee { get; set; } = default!;

    [Parameter] public EventCallback OnBackClicked { get; set; }
    [Parameter] public int Year { get; set; }
    [Parameter] public int Month { get; set; }
    [Parameter] public DateTime? InitialFromDate { get; set; }
    [Parameter] public DateTime? InitialToDate { get; set; }
    [Parameter] public string? EmployeeNumber { get; set; }
    [Parameter] public int? EmployeeId { get; set; }
    [Parameter] public bool? ShowBackButton { get; set; } = true;

    private string filterMode = "month";
    private int selectedYear;
    private int selectedMonth;
    private DateTime fromDate;
    private DateTime toDate;
    private bool isLoading;
    private string loadingMessage = "Loading leave details…";
    private List<EmployeeLeaveDetailsReportViewModel> allRecords = new();
    private List<EmployeeLeaveDetailsReportViewModel> cachedFilteredRecords = new();
    private int _prevYear, _prevMonth;
    private int? _prevEmployeeId;

    protected override async Task OnInitializedAsync()
    {
        if (InitialFromDate.HasValue && InitialToDate.HasValue)
        {
            filterMode = "dateRange";
            fromDate = InitialFromDate.Value;
            toDate = InitialToDate.Value;
            selectedYear = fromDate.Year;
            selectedMonth = fromDate.Month;
        }
        else
        {
            filterMode = "month";
            selectedYear = Year > 0 ? Year : DateTime.Today.Year;
            selectedMonth = Month > 0 ? Month : DateTime.Today.Month;
            SetDefaultDateRange();
        }

        _prevYear = selectedYear;
        _prevMonth = selectedMonth;
        _prevEmployeeId = Employee?.Id;

        await LoadDataAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        bool changed = _prevYear != Year
                     || _prevMonth != Month
                     || _prevEmployeeId != Employee?.Id;

        if (changed)
        {
            _prevYear = Year;
            _prevMonth = Month;
            _prevEmployeeId = Employee?.Id;

            selectedYear = Year > 0 ? Year : DateTime.Today.Year;
            selectedMonth = Month > 0 ? Month : DateTime.Today.Month;

            await LoadDataAsync();
        }
    }

    private async Task LoadDataAsync()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            int? yearParam;
            int? monthParam;
            DateTime? fromParam;
            DateTime? toParam;

            if (filterMode == "month")
            {
                yearParam = selectedYear;
                monthParam = selectedMonth;
                fromParam = null;
                toParam = null;
            }
            else
            {
                yearParam = null;
                monthParam = null;
                fromParam = fromDate;
                toParam = toDate;
            }

            var result = await ReportService.GetEmployeeLeaveDetailsReportAsync(
                yearParam, monthParam, fromParam, toParam, Employee.Id, Employee.EmployeeNumber);

            if (result?.IsSuccess == true && result.Data != null)
            {
                // Only include records that have a valid start date (ignoring dummy empty rows if any)
                allRecords = result.Data.Where(r => r.StartDate.HasValue).ToList();
            }
            else
            {
                allRecords = new();
            }
        }
        catch (Exception ex)
        {
            allRecords = new();
            await NotificationService.Error($"Error loading leave details: {ex.Message}");
        }
        finally
        {
            RefreshCache();
            isLoading = false;
            StateHasChanged();
        }
    }

    private void RefreshCache()
    {
        if (filterMode == "dateRange")
        {
            cachedFilteredRecords = allRecords
                .Where(r => r.StartDate.HasValue 
                          && r.EndDate.HasValue
                          && r.StartDate.Value.Date <= toDate.Date 
                          && r.EndDate.Value.Date >= fromDate.Date)
                .OrderBy(r => r.StartDate)
                .ToList();
        }
        else
        {
            cachedFilteredRecords = allRecords
                .Where(r => r.StartDate.HasValue && 
                    ((r.StartDate.Value.Year == selectedYear && r.StartDate.Value.Month == selectedMonth)
                     || (r.EndDate.HasValue && r.EndDate.Value.Year == selectedYear && r.EndDate.Value.Month == selectedMonth)))
                .OrderBy(r => r.StartDate)
                .ToList();
        }
    }

    /* ───── Format Date ───── */
    private static string FormatDate(DateTime date)
        => date.ToString("dd/MM/yy");

    /* ───── Filter Actions ───── */
    private async Task SwitchFilterMode(string mode)
    {
        if (filterMode == mode) return;

        filterMode = mode;

        if (filterMode == "month")
        {
            selectedYear = fromDate.Year;
            selectedMonth = fromDate.Month;
        }
        else
        {
            SetDefaultDateRange();
        }

        await LoadDataAsync();
    }

    private async Task OnMonthChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int m))
        {
            selectedMonth = m;
            await LoadDataAsync();
        }
    }

    private async Task OnYearChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int y))
        {
            selectedYear = y;
            await LoadDataAsync();
        }
    }

    private async Task OnFromDateInputChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var dt))
        {
            fromDate = dt;
            if (fromDate > toDate)
                toDate = fromDate;

            await LoadDataAsync();
        }
    }

    private async Task OnToDateInputChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var dt))
        {
            toDate = dt;
            if (toDate < fromDate)
                fromDate = toDate;

            await LoadDataAsync();
        }
    }

    private async Task ResetFilters()
    {
        filterMode = "month";
        selectedYear = DateTime.Today.Year;
        selectedMonth = DateTime.Today.Month;
        SetDefaultDateRange();
        await LoadDataAsync();
    }

    private void SetDefaultDateRange()
    {
        var year = selectedYear > 0 ? selectedYear : DateTime.Today.Year;
        var month = selectedMonth > 0 ? selectedMonth : DateTime.Today.Month;
        fromDate = new DateTime(year, month, 1);
        toDate = new DateTime(year, month, DateTime.DaysInMonth(year, month));
    }

    /* ───── Navigation ───── */
    private async Task HandleBack()
    {
        if (OnBackClicked.HasDelegate)
            await OnBackClicked.InvokeAsync();
    }

    /* ───── Helpers ───── */
    private static string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var p = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return p.Length >= 2
            ? $"{p[0][0]}{p[1][0]}".ToUpper()
            : p[0][..Math.Min(2, p[0].Length)].ToUpper();
    }

    private static string MonthName(int m)
    {
        if (m < 1 || m > 12) return "";
        return System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m);
    }

    private static string GetColor(string name)
    {
        string[] palette = { "#4e73df", "#1cc88a", "#36b9cc", "#f6c23e",
                             "#e74a3b", "#6f42c1", "#fd7e14", "#20c997" };
        return palette[Math.Abs(name.GetHashCode()) % palette.Length];
    }
}