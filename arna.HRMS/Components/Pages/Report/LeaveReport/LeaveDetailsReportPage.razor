@using arna.HRMS.Components.Loader
@using arna.HRMS.Components.lib.components.ui.Forms
@using arna.HRMS.Models.Common.Table
@using arna.HRMS.Models.Enums
@using arna.HRMS.Models.ViewModels
@using arna.HRMS.Services
@using arna.HRMS.Services.Report
@using arna.HRMS.Services.Common

@inject IReportService ReportService
@inject NotificationService NotificationService

@if (isLoading)
{
    <Loader Visible="isLoading" Message="@loadingMessage" />
}
else if (Employee == null)
{
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body text-center py-5">
            <div class="mb-3">
                <i class="bi bi-exclamation-triangle text-warning fs-1"></i>
            </div>
            <h5 class="fw-semibold text-muted mb-2">Employee Not Found</h5>
            <p class="text-muted mb-0">Unable to load employee information.</p>
            @if (ShowBackButton == true)
            {
                <button class="btn btn-sm btn-outline-primary rounded-pill px-4 mt-3" @onclick="HandleBack">
                    <i class="bi bi-arrow-left me-1"></i>Back to Reports
                </button>
            }
        </div>
    </div>
}
else
{
    <div class="att-animate">

        <!-- ══════════ 1. BACK + BREADCRUMB ══════════ -->
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-3">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                @if (ShowBackButton == true)
                {
                    <button type="button" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1.5 px-3 py-1.5 rounded-pill shadow-xs fw-medium bg-white att-back-btn"
                            @onclick="HandleBack" title="Back to leave overview">
                        <i class="bi bi-arrow-left"></i>
                        <span>Back</span>
                    </button>
                }
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0 small ps-1">
                        <li class="breadcrumb-item">
                            @if (ShowBackButton == true)
                            {
                                <a href="javascript:void(0)" @onclick="HandleBack" class="text-decoration-none text-primary">
                                    Leave Reports
                                </a>
                            }
                            else
                            {
                                <span class="text-primary fw-semibold">Leave Report</span>
                            }
                        </li>
                        <li class="breadcrumb-item active text-muted" aria-current="page">
                            @Employee.FullName
                        </li>
                    </ol>
                </nav>
            </div>
        </div>

        <!-- ══════════ 2. EMPLOYEE HERO PROFILE CARD ══════════ -->
        <div class="card border-0 shadow-sm rounded-3 mb-3 employee-hero-card">
            <div class="card-body p-3 p-md-4">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">

                    <!-- Left: Employee Identity -->
                    <div class="d-flex align-items-center gap-3">
                        @if (!string.IsNullOrWhiteSpace(Employee.ProfileImage ?? allRecords.FirstOrDefault()?.ProfileImage))
                        {
                            <img src="@(Employee.ProfileImage ?? allRecords.FirstOrDefault()?.ProfileImage)" alt="@Employee.FullName" class="att-hero-avatar avatar-img" />
                        }
                        else
                        {
                            <div class="att-hero-avatar">
                                @GetInitials(Employee.FullName ?? "")
                            </div>
                        }
                        <div>
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <h5 class="fw-bold text-dark mb-0">@Employee.FullName</h5>
                                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 rounded-pill px-2.5 py-1 fw-semibold small">
                                    @Employee.EmployeeNumber
                                </span>
                            </div>
                            <div class="text-muted small mt-1 d-flex align-items-center gap-2">
                                @if (Employee.Designation.HasValue)
                                {
                                    <span><i class="bi bi-briefcase me-1 text-primary"></i>@Employee.Designation.Value</span>
                                }
                                @if (!string.IsNullOrEmpty(Employee.DepartmentName))
                                {
                                    <span>•</span>
                                    <span><i class="bi bi-building me-1 text-primary"></i>@Employee.DepartmentName</span>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Right: Active Period & Stat Pill -->
                    <div class="d-flex align-items-center gap-3 ms-auto flex-wrap">
                        <div class="text-end d-none d-sm-block">
                            <small class="text-muted text-uppercase fw-semibold" style="font-size: 0.7rem; letter-spacing: 0.5px;">Active Period</small>
                            <div class="fw-semibold text-dark small">
                                <i class="bi bi-calendar3 text-primary me-1"></i>
                                @(filterMode == "month" ? (selectedMonth > 0 ? $"{MonthName(selectedMonth)} {selectedYear}" : $"All Months {selectedYear}") : $"{FormatDate(fromDate)} - {FormatDate(toDate)}")
                            </div>
                        </div>

                        <div class="vr opacity-25 d-none d-sm-block" style="height: 36px;"></div>

                        <div class="d-flex align-items-center gap-2 px-3 py-2 rounded-3 bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 shadow-xs">
                            <div class="fs-4 fw-bold">@cachedFilteredRecords.Sum(r => r.LeaveDays)</div>
                            <div class="lh-sm text-start">
                                <div class="fw-semibold small">Leave Days</div>
                                <small class="opacity-75" style="font-size: 0.72rem;">@cachedFilteredRecords.Count records</small>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <!-- ══════════ 3. UNIFIED TABLE & CONTROLS CARD ══════════ -->
        <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
            <div class="report-detail-filter-bar">

                <!-- Unified Controls: Title on Left + Single-Row Toolbar on Right -->
                <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">

                    <!-- Left: Table Title & Count -->
                    <div class="d-flex align-items-center gap-2">
                        <span class="report-table-title d-inline-flex align-items-center gap-2">
                            <i class="bi bi-calendar4-week text-primary"></i>
                            <span>Leave History Logs</span>
                        </span>
                        <span class="badge bg-light text-muted border rounded-pill px-2.5 py-1 small fw-normal">
                            @cachedFilteredRecords.Count @(cachedFilteredRecords.Count == 1 ? "record" : "records")
                        </span>
                    </div>

                    <!-- Right Controls (Single Clean Row) -->
                    <div class="d-flex align-items-center flex-wrap gap-2 ms-lg-auto">

                        <!-- Leave Type Filter -->
                        @if (AvailableLeaveTypes.Any())
                        {
                            <div class="filter-select-wrap" style="min-width: 160px;">
                                <select class="filter-select-modern"
                                        value="@selectedLeaveTypeFilter"
                                        @onchange="OnLeaveTypeFilterChanged"
                                        title="Filter by leave type">
                                    <option value="">All Leave Types (@allRecords.Count)</option>
                                    @foreach (var lt in AvailableLeaveTypes)
                                    {
                                        <option value="@lt.Key">@lt.Value (@GetCountForLeaveType(lt.Key))</option>
                                    }
                                </select>
                            </div>
                        }

                        <!-- Status Filter -->
                        <div class="filter-select-wrap" style="min-width: 135px;">
                            <select class="filter-select-modern"
                                    value="@selectedStatusFilter"
                                    @onchange="OnStatusFilterChanged"
                                    title="Filter by status">
                                <option value="">All Statuses (@allRecords.Count)</option>
                                <option value="@((int)Status.Approved)">Approved (@approvedCount)</option>
                                <option value="@((int)Status.Pending)">Pending (@pendingCount)</option>
                                <option value="@((int)Status.Rejected)">Rejected (@rejectedCount)</option>
                            </select>
                        </div>

                        <!-- Segmented Mode Toggle -->
                        <div class="view-toggle-segmented" role="group">
                            <button type="button"
                                    class="segmented-btn @(filterMode == "month" ? "active" : "")"
                                    @onclick='() => SwitchFilterMode("month")'>
                                <i class="bi bi-calendar3"></i>
                                <span>Monthly</span>
                            </button>
                            <button type="button"
                                    class="segmented-btn @(filterMode == "dateRange" ? "active" : "")"
                                    @onclick='() => SwitchFilterMode("dateRange")'>
                                <i class="bi bi-calendar-range"></i>
                                <span>Range</span>
                            </button>
                        </div>

                        <!-- Month & Year Pickers -->
                        @if (filterMode == "month")
                        {
                            <div class="filter-select-wrap" style="min-width: 140px;">
                                <select class="filter-select-modern"
                                        value="@selectedMonth"
                                        @onchange="OnMonthChanged">
                                    <option value="0">All Months (Year)</option>
                                    @for (int m = 1; m <= 12; m++)
                                    {
                                        <option value="@m">@MonthName(m)</option>
                                    }
                                </select>
                            </div>

                            <div class="filter-select-wrap" style="min-width: 90px;">
                                <select class="filter-select-modern"
                                        value="@selectedYear"
                                        @onchange="OnYearChanged">
                                    @for (int y = DateTime.Today.Year - 5; y <= DateTime.Today.Year + 1; y++)
                                    {
                                        <option value="@y">@y</option>
                                    }
                                </select>
                            </div>
                        }

                        <!-- Date Range Pickers -->
                        @if (filterMode == "dateRange")
                        {
                            <div class="filter-date-wrap">
                                <span class="filter-date-label">From:</span>
                                <input type="date"
                                       class="filter-date-input-modern"
                                       value="@fromDate.ToString("yyyy-MM-dd")"
                                       @onchange="OnFromDateInputChanged" />
                            </div>
                            <div class="filter-date-wrap">
                                <span class="filter-date-label">To:</span>
                                <input type="date"
                                       class="filter-date-input-modern"
                                       value="@toDate.ToString("yyyy-MM-dd")"
                                       @onchange="OnToDateInputChanged" />
                            </div>
                        }

                        <!-- Reset -->
                        <button type="button"
                                class="filter-btn-reset"
                                @onclick="ResetFilters"
                                title="Reset all filters">
                            <i class="bi bi-arrow-counterclockwise"></i>
                            <span>Reset</span>
                        </button>

                    </div>
                </div>
            </div>

            <!-- Table or Empty State -->
            <div class="card-body p-0">
                @if (!cachedFilteredRecords.Any())
                {
                    <div class="text-center py-5">
                        <div class="mb-3">
                            <i class="bi bi-calendar-x display-4 text-muted opacity-50"></i>
                        </div>
                        <h6 class="fw-semibold text-dark mt-2 mb-1">No Leave Records Found</h6>
                        <p class="text-muted small mb-3">
                            No leave data found for <strong>@Employee.FullName</strong>
                            @if (filterMode == "month")
                            {
                                <span> in <strong>@(selectedMonth > 0 ? $"{MonthName(selectedMonth)} {selectedYear}" : $"Year {selectedYear}")</strong>.</span>
                            }
                            else
                            {
                                <span> from <strong>@FormatDate(fromDate)</strong> to <strong>@FormatDate(toDate)</strong>.</span>
                            }
                        </p>
                        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3"
                                @onclick="ResetFilters">
                            <i class="bi bi-arrow-counterclockwise me-1"></i>Reset to Full Year
                        </button>
                    </div>
                }
                else
                {
                    <AppTable TItem="EmployeeLeaveDetailsReportViewModel"
                              Items="cachedFilteredRecords"
                              Columns="TableSchemas.EmployeeLeaveDetailsReport"
                              ShowActions="false"
                              EnablePagination="true"
                              PageSize="10"
                              WrapperClass="att-detail-table" />
                }
            </div>
        </div>

    </div>
}

@code {

    [Parameter, EditorRequired]
    public EmployeeViewModel Employee { get; set; } = default!;

    [Parameter] public EventCallback OnBackClicked { get; set; }
    [Parameter] public int Year { get; set; }
    [Parameter] public int? Month { get; set; }
    [Parameter] public DateTime? InitialFromDate { get; set; }
    [Parameter] public DateTime? InitialToDate { get; set; }
    [Parameter] public string? EmployeeNumber { get; set; }
    [Parameter] public int? EmployeeId { get; set; }
    [Parameter] public bool? ShowBackButton { get; set; } = true;

    private string filterMode = "month";
    private int selectedYear;
    private int selectedMonth; // 0 = All Months / Full Year, 1..12 = Jan..Dec
    private DateTime fromDate;
    private DateTime toDate;
    private bool isLoading;
    private string loadingMessage = "Loading leave details…";
    private List<EmployeeLeaveDetailsReportViewModel> allRecords = new();
    private List<EmployeeLeaveDetailsReportViewModel> cachedFilteredRecords = new();
    private string selectedLeaveTypeFilter = "";
    private string selectedStatusFilter = "";
    private int _prevYear;
    private int? _prevMonth;
    private int? _prevEmployeeId;

    private Dictionary<int, string> AvailableLeaveTypes => allRecords
        .Where(r => r.LeaveNameId.HasValue)
        .Select(r => r.LeaveNameId!.Value)
        .Distinct()
        .ToDictionary(
            id => id,
            id => System.Text.RegularExpressions.Regex.Replace(((LeaveName)id).ToString(), "([a-z])([A-Z])", "$1 $2")
        );

    private int GetCountForLeaveType(int leaveTypeId) =>
        allRecords.Count(r => r.LeaveNameId == leaveTypeId);

    private int approvedCount => allRecords.Count(r => r.StatusId == (int)Status.Approved);
    private int pendingCount => allRecords.Count(r => r.StatusId == (int)Status.Pending);
    private int rejectedCount => allRecords.Count(r => r.StatusId == (int)Status.Rejected);

    protected override async Task OnInitializedAsync()
    {
        if (InitialFromDate.HasValue && InitialToDate.HasValue)
        {
            filterMode = "dateRange";
            fromDate = InitialFromDate.Value;
            toDate = InitialToDate.Value;
            selectedYear = fromDate.Year;
            selectedMonth = fromDate.Month;
        }
        else
        {
            filterMode = "month";
            selectedYear = Year > 0 ? Year : DateTime.Today.Year;
            selectedMonth = Month.HasValue ? Month.Value : 0;
            SetDefaultDateRange();
        }

        _prevYear = selectedYear;
        _prevMonth = selectedMonth;
        _prevEmployeeId = Employee?.Id;

        await LoadDataAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        bool changed = _prevYear != Year
                     || _prevMonth != Month
                     || _prevEmployeeId != Employee?.Id;

        if (changed)
        {
            _prevYear = Year;
            _prevMonth = Month;
            _prevEmployeeId = Employee?.Id;

            selectedYear = Year > 0 ? Year : DateTime.Today.Year;
            selectedMonth = Month.HasValue ? Month.Value : 0;

            await LoadDataAsync();
        }
    }

    private async Task LoadDataAsync()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            int? yearParam;
            int? monthParam;
            DateTime? fromParam;
            DateTime? toParam;

            if (filterMode == "month")
            {
                yearParam = selectedYear;
                monthParam = selectedMonth > 0 ? selectedMonth : null;
                fromParam = null;
                toParam = null;
            }
            else
            {
                yearParam = null;
                monthParam = null;
                fromParam = fromDate;
                toParam = toDate;
            }

            var result = await ReportService.GetEmployeeLeaveDetailsReportAsync(
                yearParam, monthParam, fromParam, toParam, Employee.Id, Employee.EmployeeNumber);

            if (result?.IsSuccess == true && result.Data != null)
            {
                // Only include records that have a valid start date (ignoring dummy empty rows if any)
                allRecords = result.Data.Where(r => r.StartDate.HasValue).ToList();
            }
            else
            {
                allRecords = new();
            }
        }
        catch (Exception ex)
        {
            allRecords = new();
            await NotificationService.Error($"Error loading leave details: {ex.Message}");
        }
        finally
        {
            RefreshCache();
            isLoading = false;
            StateHasChanged();
        }
    }

    private void RefreshCache()
    {
        var query = allRecords.AsEnumerable();

        if (filterMode == "dateRange")
        {
            query = query.Where(r => r.StartDate.HasValue 
                                  && r.EndDate.HasValue
                                  && r.StartDate.Value.Date <= toDate.Date 
                                  && r.EndDate.Value.Date >= fromDate.Date);
        }
        else
        {
            if (selectedMonth > 0)
            {
                query = query.Where(r => r.StartDate.HasValue && 
                    ((r.StartDate.Value.Year == selectedYear && r.StartDate.Value.Month == selectedMonth)
                     || (r.EndDate.HasValue && r.EndDate.Value.Year == selectedYear && r.EndDate.Value.Month == selectedMonth)));
            }
            else
            {
                // Full Year / All Months
                query = query.Where(r => r.StartDate.HasValue && 
                    (r.StartDate.Value.Year == selectedYear 
                     || (r.EndDate.HasValue && r.EndDate.Value.Year == selectedYear)));
            }
        }

        if (!string.IsNullOrEmpty(selectedLeaveTypeFilter) && int.TryParse(selectedLeaveTypeFilter, out var ltId))
        {
            query = query.Where(r => r.LeaveNameId == ltId);
        }

        if (!string.IsNullOrEmpty(selectedStatusFilter) && int.TryParse(selectedStatusFilter, out var statusId))
        {
            query = query.Where(r => r.StatusId == statusId);
        }

        cachedFilteredRecords = query.OrderByDescending(r => r.StartDate).ToList();
    }

    private void OnLeaveTypeFilterChanged(ChangeEventArgs e)
    {
        selectedLeaveTypeFilter = e.Value?.ToString() ?? "";
        RefreshCache();
    }

    private void OnStatusFilterChanged(ChangeEventArgs e)
    {
        selectedStatusFilter = e.Value?.ToString() ?? "";
        RefreshCache();
    }

    /* ───── Format Date ───── */
    private static string FormatDate(DateTime date)
        => date.ToString("dd/MM/yy");

    /* ───── Filter Actions ───── */
    private async Task SwitchFilterMode(string mode)
    {
        if (filterMode == mode) return;

        filterMode = mode;

        if (filterMode == "month")
        {
            selectedYear = fromDate.Year;
            selectedMonth = (fromDate.Month == 1 && toDate.Month == 12 && fromDate.Year == toDate.Year) ? 0 : fromDate.Month;
        }
        else
        {
            SetDefaultDateRange();
        }

        await LoadDataAsync();
    }

    private async Task OnMonthChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int m))
        {
            selectedMonth = m;
            SetDefaultDateRange();
            await LoadDataAsync();
        }
    }

    private async Task OnYearChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int y))
        {
            selectedYear = y;
            SetDefaultDateRange();
            await LoadDataAsync();
        }
    }

    private async Task OnFromDateInputChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var dt))
        {
            fromDate = dt;
            if (fromDate > toDate)
                toDate = fromDate;

            await LoadDataAsync();
        }
    }

    private async Task OnToDateInputChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var dt))
        {
            toDate = dt;
            if (toDate < fromDate)
                fromDate = toDate;

            await LoadDataAsync();
        }
    }

    private async Task ResetFilters()
    {
        selectedLeaveTypeFilter = "";
        selectedStatusFilter = "";
        filterMode = "month";
        selectedYear = Year > 0 ? Year : DateTime.Today.Year;
        selectedMonth = Month.HasValue ? Month.Value : 0;
        SetDefaultDateRange();
        await LoadDataAsync();
    }

    private void SetDefaultDateRange()
    {
        var year = selectedYear > 0 ? selectedYear : DateTime.Today.Year;
        if (selectedMonth > 0 && selectedMonth <= 12)
        {
            fromDate = new DateTime(year, selectedMonth, 1);
            toDate = new DateTime(year, selectedMonth, DateTime.DaysInMonth(year, selectedMonth));
        }
        else
        {
            fromDate = new DateTime(year, 1, 1);
            toDate = new DateTime(year, 12, 31);
        }
    }

    /* ───── Navigation ───── */
    private async Task HandleBack()
    {
        if (OnBackClicked.HasDelegate)
            await OnBackClicked.InvokeAsync();
    }

    /* ───── Helpers ───── */
    private static string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        return arna.HRMS.Helper.Avatar.AvatarHelper.GetInitials(name);
    }

    private static string MonthName(int m)
    {
        if (m < 1 || m > 12) return "";
        return System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m);
    }
}
