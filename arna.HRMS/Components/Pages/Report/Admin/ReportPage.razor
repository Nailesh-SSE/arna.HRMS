@using arna.HRMS.Components.Loader
@using arna.HRMS.Models.ViewModels
@using arna.HRMS.Models.ViewModels.Attendance
@using arna.HRMS.Services
@using arna.HRMS.Services.Report
@using arna.HRMS.Services.Common

@inject IReportService ReportService
@inject NotificationService NotificationService

@implements IDisposable

@if (isLoading && !showDetail)
{
    <Loader Visible="isLoading" Message="@_loadingMessage" />
}
else if (!showDetail)
{
    <div class="report-page-container emp-report-fade-in">

        <!-- ═══════════ 1. PAGE HEADER & ACTIONS ═══════════ -->
        <div class="d-flex flex-column flex-sm-row align-items-start align-items-sm-center justify-content-between gap-3 mb-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <h3 class="report-title mb-0">Employees Attendance Report</h3>
                    @if (!isLoading)
                    {
                        <span class="header-count-pill">
                            @_allEmployees.Count Total
                        </span>
                    }
                </div>
                <p class="report-subtitle mb-0">Monitor team attendance metrics, work days, total logged hours, and absence rates.</p>
            </div>

            <div class="d-flex align-items-center gap-2 flex-wrap">
                <button type="button" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1.5 px-3 py-2 rounded-3 shadow-xs fw-medium bg-white"
                        @onclick="LoadEmployees" disabled="@isLoading" title="Refresh attendance data">
                    <i class="bi bi-arrow-clockwise @(isLoading ? "spin-animation" : "")"></i>
                    <span>Refresh</span>
                </button>
            </div>
        </div>

        <!-- ═══════════ 2. FILTER & SEARCH CONTROLS BAR ═══════════ -->
        <div class="report-filter-card mb-3">
            <div class="d-flex flex-wrap align-items-center gap-3">

                <!-- Search Box -->
                <div class="filter-search-box flex-grow-1">
                    <i class="bi bi-search filter-search-icon"></i>
                    <input type="text"
                           class="filter-search-input"
                           placeholder="Search by employee name or #..."
                           value="@_searchText"
                           @oninput="OnSearchInput" />
                    @if (!string.IsNullOrWhiteSpace(_searchText))
                    {
                        <button type="button" class="filter-clear-btn" @onclick="ClearSearch" title="Clear search">
                            <i class="bi bi-x-circle-fill"></i>
                        </button>
                    }
                </div>

                <!-- Filter Mode Selector -->
                <div class="filter-select-wrap">
                    <select class="filter-dropdown-select" value="@_filterMode" @onchange="OnFilterModeChanged">
                        <option value="month">Monthly View</option>
                        <option value="custom">Custom Date Range</option>
                    </select>
                </div>

                @if (_filterMode == "month")
                {
                    <!-- Month Selector -->
                    <div class="filter-select-wrap" style="min-width: 135px;">
                        <select class="filter-dropdown-select" value="@_selectedMonth" @onchange="OnMonthChanged">
                            @for (int m = 1; m <= 12; m++)
                            {
                                var mNum = m;
                                <option value="@mNum">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(mNum)</option>
                            }
                        </select>
                    </div>

                    <!-- Year Selector -->
                    <div class="filter-select-wrap" style="min-width: 95px;">
                        <select class="filter-dropdown-select" value="@_selectedYear" @onchange="OnYearChanged">
                            @for (int y = DateTime.Today.Year - 3; y <= DateTime.Today.Year + 1; y++)
                            {
                                var yNum = y;
                                <option value="@yNum">@yNum</option>
                            }
                        </select>
                    </div>
                }
                else
                {
                    <!-- From Date -->
                    <div class="filter-date-wrap">
                        <span class="filter-date-label">From:</span>
                        <input type="date"
                               class="filter-date-input"
                               value="@_fromDate.ToString("yyyy-MM-dd")"
                               @onchange="OnFromDateChanged" />
                    </div>

                    <!-- To Date -->
                    <div class="filter-date-wrap">
                        <span class="filter-date-label">To:</span>
                        <input type="date"
                               class="filter-date-input"
                               value="@_toDate.ToString("yyyy-MM-dd")"
                               @onchange="OnToDateChanged" />
                    </div>
                }

                <!-- Reset Filters Trigger -->
                @if (HasActiveFilters)
                {
                    <div>
                        <button type="button" class="btn-filter-trigger active-filter" @onclick="ResetFilters" title="Reset all filters">
                            <i class="bi bi-arrow-counterclockwise"></i>
                            <span>Reset</span>
                        </button>
                    </div>
                }

            </div>
        </div>

        <!-- ═══════════ 3. EMPLOYEES ATTENDANCE TABLE ═══════════ -->
        <div class="report-grid-card">

            <!-- Context Header Banner -->
            <div class="report-context-banner d-flex align-items-center justify-content-between px-3 py-2 bg-light border-bottom">
                <div class="d-flex align-items-center gap-2">
                    <span class="status-dot-sm bg-primary"></span>
                    <span class="report-banner-title small">Employee Attendance Summary</span>
                    <span class="text-muted small">• @GetPeriodDescription()</span>
                </div>
                <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-2.5 py-1 small">
                    @FilteredEmployees.Count employee(s)
                </span>
            </div>

            <div class="report-table-wrapper">
                @if (isLoading)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary mb-3" role="status"></div>
                        <p class="text-muted mb-0 small">Loading attendance reports...</p>
                    </div>
                }
                else if (!FilteredEmployees.Any())
                {
                    <div class="text-center py-5 px-3">
                        <div class="d-inline-flex align-items-center justify-content-center bg-light rounded-circle p-3 mb-3 text-secondary opacity-75" style="width:64px; height:64px;">
                            <i class="bi bi-person-slash fs-2"></i>
                        </div>
                        <h6 class="fw-bold text-dark mb-1">No Employees Found</h6>
                        <p class="text-muted small mb-3">
                            @if (!string.IsNullOrWhiteSpace(_searchText))
                            {
                                <span>No employees match "<strong>@_searchText</strong>".</span>
                            }
                            else
                            {
                                <span>No attendance records found for @GetPeriodDescription().</span>
                            }
                        </p>
                        @if (HasActiveFilters)
                        {
                            <button class="btn btn-sm btn-outline-primary rounded-pill px-3" @onclick="ResetFilters">
                                <i class="bi bi-arrow-counterclockwise me-1"></i> Reset Filters
                            </button>
                        }
                    </div>
                }
                else
                {
                    <table class="report-modern-table">
                        <thead>
                            <tr>
                                <th style="width: 110px;">EMP #</th>
                                <th style="min-width: 220px;">EMPLOYEE NAME</th>
                                <th style="width: 110px; text-align: center;">WORK DAYS</th>
                                <th style="width: 100px; text-align: center;">PRESENT</th>
                                <th style="width: 100px; text-align: center;">ABSENT</th>
                                <th style="width: 130px; text-align: center;">TOTAL HOURS</th>
                                <th style="width: 130px; text-align: center;">AVG WORK HOURS</th>
                                <th style="width: 130px; text-align: center;">AVG BREAK</th>
                                <th style="width: 100px; text-align: center;">ACTION</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var emp in PagedEmployees)
                            {
                                <tr>
                                    <!-- EMP # (Monospace Code Badge) -->
                                    <td>
                                        <span class="report-emp-code">
                                            @emp.EmployeeNumber
                                        </span>
                                    </td>

                                    <!-- EMPLOYEE NAME (Initials Circle + Single-line Name) -->
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            @if (!string.IsNullOrWhiteSpace(emp.ProfileImage))
                                            {
                                                <img src="@emp.ProfileImage" alt="@emp.EmployeeName" class="report-avatar-circle avatar-img" />
                                            }
                                            else
                                            {
                                                <div class="report-avatar-circle">
                                                    @GetInitials(emp.EmployeeName)
                                                </div>
                                            }
                                            <span class="report-emp-name text-truncate" title="@emp.EmployeeName">
                                                @emp.EmployeeName
                                            </span>
                                        </div>
                                    </td>

                                    <!-- WORK DAYS -->
                                    <td class="text-center">
                                        <span class="report-cell-num">
                                            @emp.TotalWorkDays
                                        </span>
                                    </td>

                                    <!-- PRESENT -->
                                    <td class="text-center">
                                        <span class="report-cell-present">
                                            @emp.TotalPresent
                                        </span>
                                    </td>

                                    <!-- ABSENT -->
                                    <td class="text-center">
                                        <span class="report-cell-absent">
                                            @emp.TotalAbsent
                                        </span>
                                    </td>

                                    <!-- TOTAL HOURS -->
                                    <td class="text-center">
                                        <span class="report-time-val">
                                            @(string.IsNullOrWhiteSpace(emp.TotalHours) ? "0:00:00" : emp.TotalHours)
                                        </span>
                                    </td>

                                    <!-- AVG WORK HOURS -->
                                    <td class="text-center">
                                        <span class="report-time-val">
                                            @(string.IsNullOrWhiteSpace(emp.AvgWorkHours) ? "0:00:00" : emp.AvgWorkHours)
                                        </span>
                                    </td>

                                    <!-- AVG BREAK -->
                                    <td class="text-center">
                                        <span class="report-time-val">
                                            @(string.IsNullOrWhiteSpace(emp.AvgBreak) ? "0:00:00" : emp.AvgBreak)
                                        </span>
                                    </td>

                                    <!-- ACTION (View Details) -->
                                    <td class="text-center">
                                        <button type="button"
                                                class="btn-action-icon-view"
                                                @onclick="() => OpenDetail(emp)"
                                                title="View detailed attendance for @emp.EmployeeName">
                                            <i class="bi bi-eye"></i>
                                            <span>View</span>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>

            <!-- ═══════════ 4. PAGINATION FOOTER ═══════════ -->
            @if (!isLoading && FilteredEmployees.Any())
            {
                <div class="report-pagination-bar d-flex flex-column flex-sm-row align-items-center justify-content-between gap-3">
                    <div class="d-flex align-items-center gap-2 text-muted small flex-wrap">
                        <span>Showing <strong>@StartIndex</strong> to <strong>@EndIndex</strong> of <strong>@TotalCount</strong> employees</span>
                        <span class="text-black-50">•</span>
                        <div class="d-flex align-items-center gap-1.5">
                            <span>Show</span>
                            <select class="page-size-select" value="@_pageSize" @onchange="OnPageSizeChange">
                                <option value="10">10</option>
                                <option value="25">25</option>
                                <option value="50">50</option>
                                <option value="100">100</option>
                            </select>
                            <span>per page</span>
                        </div>
                    </div>

                    @if (TotalPages > 1)
                    {
                        <div class="d-flex align-items-center gap-1">
                            <button type="button" class="page-btn" disabled="@(_currentPage <= 1)" @onclick="() => GoToPage(_currentPage - 1)" title="Previous page">
                                <i class="bi bi-chevron-left"></i>
                            </button>

                            @for (int p = 1; p <= TotalPages; p++)
                            {
                                var pageNum = p;
                                <button type="button" class="page-btn @(pageNum == _currentPage ? "active" : "")" @onclick="() => GoToPage(pageNum)">
                                    @pageNum
                                </button>
                            }

                            <button type="button" class="page-btn" disabled="@(_currentPage >= TotalPages)" @onclick="() => GoToPage(_currentPage + 1)" title="Next page">
                                <i class="bi bi-chevron-right"></i>
                            </button>
                        </div>
                    }
                </div>
            }

        </div>

    </div>
}
else
{
    <ReportDetailPage Employee="selectedEmployee!"
                      Year="@_selectedYear"
                      Month="@_selectedMonth"
                      InitialFromDate="@(_filterMode == "custom" ? (DateTime?)_fromDate : null)"
                      InitialToDate="@(_filterMode == "custom" ? (DateTime?)_toDate : null)"
                      OnBackClicked="BackToList" />
}

@code {

    [Parameter] public EventCallback<int> OnCountChanged { get; set; }

    /* ───── State ───── */
    private bool showDetail;
    private bool isLoading = true;
    private string _loadingMessage = "Loading attendance reports...";
    private string _searchText = "";
    private EmployeeViewModel? selectedEmployee;

    // Filters
    private string _filterMode = "month"; // "month" or "custom"
    private int _selectedMonth = (DateTime.Today.Year == 2026 && DateTime.Today.Month == 11) ? 10 : DateTime.Today.Month;
    private int _selectedYear = 2026;
    private DateTime _fromDate;
    private DateTime _toDate;

    // Data
    private List<EmployeeAttendanceReportViewModel> _allEmployees = new();
    private CancellationTokenSource _cts = new();
    private bool _isDisposed;

    // Pagination
    private int _currentPage = 1;
    private int _pageSize = 10;

    /* ───── Computed ───── */
    private List<EmployeeAttendanceReportViewModel> FilteredEmployees =>
        string.IsNullOrWhiteSpace(_searchText)
            ? _allEmployees
            : _allEmployees.Where(e =>
                MatchesSearch(e.EmployeeName) ||
                MatchesSearch(e.EmployeeNumber)
            ).ToList();

    private int TotalCount => FilteredEmployees.Count;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling((double)TotalCount / _pageSize));
    private int StartIndex => TotalCount == 0 ? 0 : (_currentPage - 1) * _pageSize + 1;
    private int EndIndex => Math.Min(_currentPage * _pageSize, TotalCount);

    private IEnumerable<EmployeeAttendanceReportViewModel> PagedEmployees =>
        FilteredEmployees.Skip((_currentPage - 1) * _pageSize).Take(_pageSize);

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(_searchText) ||
        _filterMode != "month" ||
        _selectedMonth != ((DateTime.Today.Year == 2026 && DateTime.Today.Month == 11) ? 10 : DateTime.Today.Month) ||
        _selectedYear != DateTime.Today.Year;

    /* ───── Lifecycle ───── */
    protected override async Task OnInitializedAsync()
    {
        SetMonthDateDefaults();
        await LoadEmployees();
    }

    private void SetMonthDateDefaults()
    {
        var today = DateTime.Today;
        if (today.Year == 2026 && today.Month == 11)
        {
            _selectedMonth = 10;
            _selectedYear = 2026;
        }
        else
        {
            _selectedMonth = today.Month;
            _selectedYear = today.Year;
        }
        _fromDate = new DateTime(_selectedYear, _selectedMonth, 1);
        _toDate = new DateTime(_selectedYear, _selectedMonth, DateTime.DaysInMonth(_selectedYear, _selectedMonth));
    }

    /* ───── Data Loading ───── */
    private async Task LoadEmployees()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            int? yearParam = null;
            int? monthParam = null;
            DateTime? fromParam = null;
            DateTime? toParam = null;

            if (_filterMode == "month")
            {
                yearParam = _selectedYear;
                monthParam = _selectedMonth;
            }
            else
            {
                fromParam = _fromDate;
                toParam = _toDate;
            }

            var result = await ReportService.GetEmployeeAttendanceReportAsync(
                yearParam, monthParam, null, fromParam, toParam);

            if (_cts.IsCancellationRequested || _isDisposed) return;

            _allEmployees = result?.IsSuccess == true
                ? result.Data ?? new()
                : new();

            if (!_isDisposed)
                await OnCountChanged.InvokeAsync(_allEmployees.Count);
        }
        catch (Exception ex)
        {
            _allEmployees = new();
            await NotificationService.Error($"Error loading attendance report: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    /* ───── Event Handlers ───── */
    private async Task OnFilterModeChanged(ChangeEventArgs e)
    {
        _filterMode = e.Value?.ToString() ?? "month";
        _currentPage = 1;

        if (_filterMode == "month")
        {
            _fromDate = new DateTime(_selectedYear, _selectedMonth, 1);
            _toDate = new DateTime(_selectedYear, _selectedMonth, DateTime.DaysInMonth(_selectedYear, _selectedMonth));
        }

        await LoadEmployees();
    }

    private async Task OnMonthChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var m))
        {
            _selectedMonth = m;
            _fromDate = new DateTime(_selectedYear, _selectedMonth, 1);
            _toDate = new DateTime(_selectedYear, _selectedMonth, DateTime.DaysInMonth(_selectedYear, _selectedMonth));
            _currentPage = 1;
            await LoadEmployees();
        }
    }

    private async Task OnYearChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var y))
        {
            _selectedYear = y;
            _fromDate = new DateTime(_selectedYear, _selectedMonth, 1);
            _toDate = new DateTime(_selectedYear, _selectedMonth, DateTime.DaysInMonth(_selectedYear, _selectedMonth));
            _currentPage = 1;
            await LoadEmployees();
        }
    }

    private async Task OnFromDateChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var d))
        {
            _fromDate = d;
            if (_fromDate > _toDate) _toDate = _fromDate;
            _currentPage = 1;
            await LoadEmployees();
        }
    }

    private async Task OnToDateChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var d))
        {
            _toDate = d;
            if (_toDate < _fromDate) _fromDate = _toDate;
            _currentPage = 1;
            await LoadEmployees();
        }
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _searchText = e.Value?.ToString() ?? "";
        _currentPage = 1;
    }

    private void ClearSearch()
    {
        _searchText = "";
        _currentPage = 1;
    }

    private async Task ResetFilters()
    {
        _searchText = "";
        _filterMode = "month";
        SetMonthDateDefaults();
        _currentPage = 1;
        await LoadEmployees();
    }

    /* ───── Pagination ───── */
    private void GoToPage(int page)
    {
        if (page >= 1 && page <= TotalPages)
        {
            _currentPage = page;
        }
    }

    private void OnPageSizeChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int newSize) && newSize > 0)
        {
            _pageSize = newSize;
            _currentPage = 1;
        }
    }

    /* ───── Helpers ───── */
    private bool MatchesSearch(string? value) =>
        !string.IsNullOrWhiteSpace(value) &&
        value.Contains(_searchText, StringComparison.OrdinalIgnoreCase);

    private string GetPeriodDescription()
    {
        if (_filterMode == "month")
        {
            var monthName = System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(_selectedMonth);
            return $"{monthName} {_selectedYear}";
        }
        return $"{_fromDate:dd/MM/yyyy} – {_toDate:dd/MM/yyyy}";
    }

    private static string GetInitials(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return "--";
        return arna.HRMS.Helper.Avatar.AvatarHelper.GetInitials(fullName);
    }

    /* ───── Navigation ───── */
    private void OpenDetail(EmployeeAttendanceReportViewModel emp)
    {
        var nameParts = (emp.EmployeeName ?? "").Split(' ', 2, StringSplitOptions.RemoveEmptyEntries);

        selectedEmployee = new EmployeeViewModel
        {
            Id = emp.EmployeeId,
            EmployeeNumber = emp.EmployeeNumber,
            FirstName = nameParts.Length > 0 ? nameParts[0] : "",
            LastName = nameParts.Length > 1 ? nameParts[1] : "",
        };
        showDetail = true;
    }

    private void BackToList()
    {
        showDetail = false;
        selectedEmployee = null;
    }

    /* ───── Dispose ───── */
    public void Dispose()
    {
        if (_isDisposed) return;
        _isDisposed = true;
        try { _cts.Cancel(); } catch { }
        try { _cts.Dispose(); } catch { }
    }
}
