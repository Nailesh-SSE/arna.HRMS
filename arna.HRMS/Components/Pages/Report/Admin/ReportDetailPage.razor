@using arna.HRMS.Components.Loader
@using arna.HRMS.Components.lib.components.ui.Forms
@using arna.HRMS.Models.Common.Table
@using arna.HRMS.Models.Enums
@using arna.HRMS.Models.ViewModels
@using arna.HRMS.Models.ViewModels.Attendance
@using arna.HRMS.Services
@using arna.HRMS.Services.Report
@using arna.HRMS.Services.Export
@using arna.HRMS.Services.Common

@inject IReportService ReportService
@inject IEmployeeService EmployeeService
@inject NotificationService NotificationService
@inject IFestivalHolidayService festivalHolidayService
@inject IExcelExportService ExcelExportService
@inject IJSRuntime JS

@if (isLoading)
{
    <Loader Visible="isLoading" Message="@loadingMessage" />
}
else if (Employee == null)
{
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body text-center py-5">
            <div class="mb-3">
                <i class="bi bi-exclamation-triangle text-warning fs-1"></i>
            </div>
            <h5 class="fw-semibold text-muted mb-2">Employee Not Found</h5>
            <p class="text-muted mb-0">Unable to load employee information.</p>
            <button class="btn btn-sm btn-outline-primary rounded-pill px-4 mt-3" @onclick="HandleBack">
                <i class="bi bi-arrow-left me-1"></i>Back to Reports
            </button>
        </div>
    </div>
}
else
{
    <div class="att-animate">

        <!-- ══════════ 1. BACK + BREADCRUMB + EXPORT ══════════ -->
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-3">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <button type="button" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1.5 px-3 py-1.5 rounded-pill shadow-xs fw-medium bg-white att-back-btn"
                        @onclick="HandleBack" title="Back to attendance overview">
                    <i class="bi bi-arrow-left"></i>
                    <span>Back</span>
                </button>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0 small ps-1">
                        <li class="breadcrumb-item">
                            <a href="javascript:void(0)" @onclick="HandleBack" class="text-decoration-none text-primary">
                                Attendance Reports
                            </a>
                        </li>
                        <li class="breadcrumb-item active text-muted" aria-current="page">
                            @Employee.FullName
                        </li>
                    </ol>
                </nav>
            </div>

            <!-- Export to Excel Button -->
            <div>
                <button class="btn btn-excel btn-sm rounded-pill px-3 py-2 shadow-sm d-inline-flex align-items-center gap-2 fw-semibold"
                        @onclick="ExportToExcelAsync"
                        disabled="@(isExporting || !cachedFilteredRecords.Any())"
                        title="Download Attendance Report as Excel (.xlsx)">
                    @if (isExporting)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        <span>Exporting...</span>
                    }
                    else
                    {
                        <i class="bi bi-file-earmark-excel-fill"></i>
                        <span>Export to Excel</span>
                    }
                </button>
            </div>
        </div>

        <!-- ══════════ 2. EMPLOYEE HERO PROFILE CARD ══════════ -->
        <div class="card border-0 shadow-sm rounded-3 mb-3 employee-hero-card">
            <div class="card-body p-3 p-md-4">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">

                    <!-- Left: Employee Identity -->
                    <div class="d-flex align-items-center gap-3">
                        @if (!string.IsNullOrWhiteSpace(Employee.ProfileImage ?? allRecords.FirstOrDefault()?.ProfileImage))
                        {
                            <img src="@(Employee.ProfileImage ?? allRecords.FirstOrDefault()?.ProfileImage)" alt="@Employee.FullName" class="att-hero-avatar avatar-img" />
                        }
                        else
                        {
                            <div class="att-hero-avatar">
                                @GetInitials(Employee.FullName ?? "")
                            </div>
                        }
                        <div>
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <h5 class="fw-bold text-dark mb-0">@Employee.FullName</h5>
                                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 rounded-pill px-2.5 py-1 fw-semibold small">
                                    @Employee.EmployeeNumber
                                </span>
                            </div>
                            <div class="text-muted small mt-1 d-flex align-items-center gap-2">
                                @if (Employee.Designation.HasValue)
                                {
                                    <span><i class="bi bi-briefcase me-1 text-primary"></i>@Employee.Designation.Value</span>
                                }
                                @if (!string.IsNullOrEmpty(Employee.DepartmentName))
                                {
                                    <span>•</span>
                                    <span><i class="bi bi-building me-1 text-primary"></i>@Employee.DepartmentName</span>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Right: Active Period & Attendance Health -->
                    <div class="d-flex align-items-center gap-3 ms-auto flex-wrap">
                        <div class="text-end d-none d-sm-block">
                            <small class="text-muted text-uppercase fw-semibold" style="font-size: 0.7rem; letter-spacing: 0.5px;">Active Period</small>
                            <div class="fw-semibold text-dark small">
                                <i class="bi bi-calendar3 text-primary me-1"></i>
                                @(filterMode == "month" ? $"{MonthName(selectedMonth)} {selectedYear}" : $"{FormatDate(fromDate)} - {FormatDate(toDate)}")
                            </div>
                        </div>

                        <div class="vr opacity-25 d-none d-sm-block" style="height: 36px;"></div>

                        <div class="d-flex align-items-center gap-2 px-3 py-2 rounded-3 @RateBadgeClass(attendanceRate) shadow-xs">
                            <div class="fs-4 fw-bold">@attendanceRate%</div>
                            <div class="lh-sm text-start">
                                <div class="fw-semibold small">Attendance Rate</div>
                                <small class="opacity-75" style="font-size: 0.72rem;">@RateStatusText(attendanceRate)</small>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <!-- ══════════ 3. UNIFIED TABLE & CONTROLS CARD ══════════ -->
        <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
            <div class="report-detail-filter-bar">

                <!-- Unified Controls: Title/Info on Left + Single-Row Toolbar on Right -->
                <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">

                    <!-- Left: Table Title & Total Count -->
                    <div class="d-flex align-items-center gap-2">
                        <span class="report-table-title d-inline-flex align-items-center gap-2">
                            <i class="bi bi-calendar4-week text-primary"></i>
                            <span>Daily Attendance Logs</span>
                        </span>
                        <span class="badge bg-light text-muted border rounded-pill px-2.5 py-1 small fw-normal">
                            @DisplayRecords.Count @(DisplayRecords.Count == 1 ? "day" : "days")
                        </span>
                    </div>

                    <!-- Right Controls: Status Dropdown, Mode Toggle, Month/Year / Range & Reset (Single Clean Row) -->
                    <div class="d-flex align-items-center flex-wrap gap-2 ms-lg-auto">

                        <!-- Status Filter Dropdown -->
                        <div class="filter-select-wrap" style="min-width: 155px;">
                            <select class="filter-select-modern"
                                    value="@(selectedStatusFilter ?? "")"
                                    @onchange="OnStatusFilterChanged"
                                    title="Filter records by status">
                                <option value="">All Statuses (@cachedFilteredRecords.Count)</option>
                                <option value="@nameof(AttendanceStatus.Present)">Present (@presentCount)</option>
                                <option value="@nameof(AttendanceStatus.Late)">Late (@lateCount)</option>
                                <option value="@nameof(AttendanceStatus.HalfDay)">Half Day (@halfDayCount)</option>
                                <option value="@nameof(AttendanceStatus.OnLeave)">Leave (@onLeaveCount)</option>
                                <option value="@nameof(AttendanceStatus.Absent)">Absent (@absentCount)</option>
                            </select>
                        </div>

                        <!-- Modern Segmented Control -->
                        <div class="view-toggle-segmented" role="group">
                            <button type="button"
                                    class="segmented-btn @(filterMode == "month" ? "active" : "")"
                                    @onclick='() => SwitchFilterMode("month")'>
                                <i class="bi bi-calendar3"></i>
                                <span>Monthly</span>
                            </button>
                            <button type="button"
                                    class="segmented-btn @(filterMode == "dateRange" ? "active" : "")"
                                    @onclick='() => SwitchFilterMode("dateRange")'>
                                <i class="bi bi-calendar-range"></i>
                                <span>Range</span>
                            </button>
                        </div>

                        @if (filterMode == "month")
                        {
                            <div class="filter-select-wrap" style="min-width: 120px;">
                                <select class="filter-select-modern"
                                        value="@selectedMonth"
                                        @onchange="OnMonthChanged">
                                    @for (int m = 1; m <= 12; m++)
                                    {
                                        <option value="@m">@MonthName(m)</option>
                                    }
                                </select>
                            </div>

                            <div class="filter-select-wrap" style="min-width: 90px;">
                                <select class="filter-select-modern"
                                        value="@selectedYear"
                                        @onchange="OnYearChanged">
                                    @for (int y = DateTime.Today.Year - 5; y <= DateTime.Today.Year + 1; y++)
                                    {
                                        <option value="@y">@y</option>
                                    }
                                </select>
                            </div>
                        }
                        else
                        {
                            <div class="filter-date-wrap">
                                <span class="filter-date-label">From:</span>
                                <input type="date"
                                       class="filter-date-input-modern"
                                       value="@fromDate.ToString("yyyy-MM-dd")"
                                       @onchange="OnFromDateChanged" />
                            </div>

                            <div class="filter-date-wrap">
                                <span class="filter-date-label">To:</span>
                                <input type="date"
                                       class="filter-date-input-modern"
                                       value="@toDate.ToString("yyyy-MM-dd")"
                                       @onchange="OnToDateChanged" />
                            </div>
                        }

                        <button type="button"
                                class="filter-btn-reset"
                                @onclick="ResetFilters"
                                title="Reset to current month and all statuses">
                            <i class="bi bi-arrow-counterclockwise"></i>
                            <span>Reset</span>
                        </button>

                    </div>
                </div>

            </div>

            <!-- Table Body -->
            <div class="card-body p-0">
                @if (!cachedFilteredRecords.Any())
                {
                    <div class="text-center py-5">
                        <div class="mb-3">
                            <i class="bi bi-calendar-x display-3 text-muted opacity-25"></i>
                        </div>
                        <h6 class="fw-bold text-dark mb-1">No Attendance Records Found</h6>
                        <p class="text-muted small mb-3">
                            No logs found for <strong>@Employee.FullName</strong> in @(filterMode == "month" ? $"{MonthName(selectedMonth)} {selectedYear}" : $"{FormatDate(fromDate)} to {FormatDate(toDate)}").
                        </p>
                        <div class="d-flex justify-content-center align-items-center gap-2 flex-wrap">
                            @if (selectedMonth != 10 || selectedYear != 2026)
                            {
                                <button class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm"
                                        @onclick="() => SwitchToMonth(10, 2026)">
                                    <i class="bi bi-calendar2-check me-1"></i>View October 2026 Data
                                </button>
                            }
                            <button class="btn btn-sm btn-outline-secondary rounded-pill px-3"
                                    @onclick="ResetFilters">
                                <i class="bi bi-arrow-counterclockwise me-1"></i>Reset to Current Month
                            </button>
                        </div>
                    </div>
                }
                else if (!DisplayRecords.Any())
                {
                    <div class="text-center py-5">
                        <i class="bi bi-funnel display-4 text-muted opacity-25 d-block mb-2"></i>
                        <h6 class="fw-semibold text-dark mb-1">No @selectedStatusFilter Records</h6>
                        <p class="text-muted small mb-3">There are no records matching the selected status in this period.</p>
                        <button class="btn btn-sm btn-outline-primary rounded-pill px-3"
                                @onclick="ClearStatusFilter">
                            <i class="bi bi-x-lg me-1"></i>Show All Records
                        </button>
                    </div>
                }
                else
                {
                    <AppTable TItem="AttendanceReportViewModel"
                              Items="DisplayRecords"
                              Columns="TableSchemas.EmployeeAttendanceDetailReport"
                              ShowActions="false"
                              EnablePagination="true"
                              PageSize="15"
                              WrapperClass="att-detail-table"
                              RowClassFunc="GetRowClass" />
                }
            </div>
        </div>

    </div>
}

@code {

    [Parameter, EditorRequired]
    public EmployeeViewModel Employee { get; set; } = default!;

    [Parameter] public EventCallback OnBackClicked { get; set; }

    [Parameter] public int Year { get; set; }
    [Parameter] public int Month { get; set; }
    [Parameter] public DateTime? InitialFromDate { get; set; }
    [Parameter] public DateTime? InitialToDate { get; set; }

    private string filterMode = "month";
    private int selectedYear;
    private int selectedMonth;
    private DateTime fromDate;
    private DateTime toDate;
    private bool isLoading;
    private bool isExporting;
    private string loadingMessage = "Loading attendance details…";
    private string? selectedStatusFilter;
    private List<AttendanceReportViewModel> allRecords = new();
    private List<AttendanceReportViewModel> cachedFilteredRecords = new();
    private int presentCount, absentCount, lateCount, halfDayCount, onLeaveCount, holidayCount;
    private double weightedPresentDays, averageCount, attendanceRate;
    private int totalWorkingDays;
    private int _prevYear, _prevMonth;
    private int? _prevEmployeeId;

    private List<FestivalHolidayViewModel> holidayList = new();

    private List<AttendanceReportViewModel> DisplayRecords =>
        string.IsNullOrEmpty(selectedStatusFilter)
            ? cachedFilteredRecords
            : cachedFilteredRecords
                .Where(r => r.AttendanceStatus?.ToString() == selectedStatusFilter)
                .ToList();

    protected override async Task OnInitializedAsync()
    {
        if (InitialFromDate.HasValue && InitialToDate.HasValue)
        {
            filterMode = "dateRange";
            fromDate = InitialFromDate.Value;
            toDate = InitialToDate.Value;
            selectedYear = fromDate.Year;
            selectedMonth = fromDate.Month;
        }
        else
        {
            filterMode = "month";
            selectedYear = Year > 0 ? Year : 2026;
            selectedMonth = Month > 0 ? Month : 10;
            fromDate = new DateTime(selectedYear, selectedMonth, 1);
            toDate = new DateTime(selectedYear, selectedMonth, DateTime.DaysInMonth(selectedYear, selectedMonth));
        }

        _prevYear = selectedYear;
        _prevMonth = selectedMonth;
        _prevEmployeeId = Employee?.Id;

        // Fetch full employee details if designation or department is missing
        if (Employee != null && (Employee.Designation == null || string.IsNullOrEmpty(Employee.DepartmentName)))
        {
            try
            {
                var empRes = await EmployeeService.GetEmployeeByIdAsync(Employee.Id);
                if (empRes?.IsSuccess == true && empRes.Data != null)
                {
                    Employee = empRes.Data;
                }
            }
            catch { }
        }

        await LoadDataAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        bool changed = (Year > 0 && _prevYear != Year)
                     || (Month > 0 && _prevMonth != Month)
                     || (_prevEmployeeId != Employee?.Id);

        if (changed)
        {
            _prevYear = Year > 0 ? Year : _prevYear;
            _prevMonth = Month > 0 ? Month : _prevMonth;
            _prevEmployeeId = Employee?.Id;

            if (InitialFromDate.HasValue && InitialToDate.HasValue)
            {
                filterMode = "dateRange";
                fromDate = InitialFromDate.Value;
                toDate = InitialToDate.Value;
                selectedYear = fromDate.Year;
                selectedMonth = fromDate.Month;
            }
            else
            {
                filterMode = "month";
                selectedYear = Year > 0 ? Year : selectedYear;
                selectedMonth = Month > 0 ? Month : selectedMonth;
                fromDate = new DateTime(selectedYear, selectedMonth, 1);
                toDate = new DateTime(selectedYear, selectedMonth, DateTime.DaysInMonth(selectedYear, selectedMonth));
            }

            selectedStatusFilter = null;
            await LoadDataAsync();
        }
    }

    private async Task LoadDataAsync()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            if (Employee == null) return;

            int? yearParam;
            int? monthParam;
            DateTime? fromParam;
            DateTime? toParam;

            if (filterMode == "month")
            {
                yearParam = selectedYear;
                monthParam = selectedMonth;
                fromParam = null;
                toParam = null;
            }
            else
            {
                yearParam = null;
                monthParam = null;
                fromParam = fromDate;
                toParam = toDate;
            }

            var result = await ReportService.GetEmployeeDailyAttendanceReportAsync(
                yearParam, monthParam, Employee.Id, null, null, fromParam, toParam);

            if (result?.IsSuccess == true && result.Data != null)
            {
                allRecords = result.Data;
            }
            else
            {
                allRecords = new();
            }

            try
            {
                var holidayResult = await festivalHolidayService.GetFestivalHolidayByMonthAsync(selectedYear, selectedMonth);
                if (holidayResult?.IsSuccess == true && holidayResult.Data != null)
                {
                    holidayList = holidayResult.Data;
                }
                else
                {
                    holidayList = new();
                }
            }
            catch
            {
                holidayList = new();
            }
        }
        catch (Exception ex)
        {
            allRecords = new();
            await NotificationService.Error($"Error loading attendance data: {ex.Message}");
        }
        finally
        {
            RefreshCache();
            isLoading = false;
            StateHasChanged();
        }
    }

    private void RefreshCache()
    {
        if (filterMode == "dateRange")
        {
            cachedFilteredRecords = allRecords
                .Where(r => r.AttendanceDate.Date >= fromDate.Date
                          && r.AttendanceDate.Date <= toDate.Date)
                .OrderBy(r => r.AttendanceDate)
                .ToList();
        }
        else
        {
            cachedFilteredRecords = allRecords
                .Where(r => r.AttendanceDate.Year == selectedYear
                          && r.AttendanceDate.Month == selectedMonth)
                .OrderBy(r => r.AttendanceDate)
                .ToList();
        }

        ComputeStatistics();
    }

    private void ComputeStatistics()
    {
        var records = cachedFilteredRecords;

        presentCount = records.Count(r => r.AttendanceStatus == AttendanceStatus.Present);
        absentCount = records.Count(r => r.AttendanceStatus == AttendanceStatus.Absent);
        lateCount = records.Count(r => r.AttendanceStatus == AttendanceStatus.Late);
        halfDayCount = records.Count(r => r.AttendanceStatus == AttendanceStatus.HalfDay);
        onLeaveCount = records.Count(r => r.AttendanceStatus == AttendanceStatus.OnLeave);
        holidayCount = records.Count(r => r.AttendanceStatus == AttendanceStatus.Holiday);

        weightedPresentDays = presentCount + lateCount + (halfDayCount * 0.5);
        totalWorkingDays = Math.Max(0, records.Count - holidayCount);

        attendanceRate = totalWorkingDays > 0
            ? Math.Min(100, Math.Round((weightedPresentDays / totalWorkingDays) * 100, 1))
            : 0;

        averageCount = Math.Round(weightedPresentDays, 1);
    }

    /* ───── Format & Helpers ───── */
    private static string FormatDate(DateTime date) => date.ToString("dd/MM/yyyy");

    private static string MonthName(int m) =>
        System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m);

    private static string GetInitials(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return "?";
        return arna.HRMS.Helper.Avatar.AvatarHelper.GetInitials(fullName);
    }

    private static string RateBadgeClass(double r) =>
        r >= 85 ? "bg-success bg-opacity-10 text-success border border-success border-opacity-25" :
        r >= 70 ? "bg-warning bg-opacity-10 text-warning-emphasis border border-warning border-opacity-25" :
                  "bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25";

    private static string RateStatusText(double r) =>
        r >= 85 ? "High Attendance" :
        r >= 70 ? "Moderate Attendance" :
                  "Low Attendance";

    private string GetRowClass(AttendanceReportViewModel rec) =>
        (rec.Day == "Saturday" || rec.Day == "Sunday") ? "att-row-weekend" : "att-row-clean";

    /* ───── Filter Actions ───── */
    private void ToggleStatusFilter(string? status)
    {
        if (selectedStatusFilter == status)
            selectedStatusFilter = null;
        else
            selectedStatusFilter = status;
    }

    private void OnStatusFilterChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        selectedStatusFilter = string.IsNullOrWhiteSpace(val) ? null : val;
    }

    private void ClearStatusFilter() => selectedStatusFilter = null;

    private async Task SwitchFilterMode(string mode)
    {
        if (filterMode == mode) return;
        filterMode = mode;
        selectedStatusFilter = null;

        if (mode == "month")
        {
            fromDate = new DateTime(selectedYear, selectedMonth, 1);
            toDate = new DateTime(selectedYear, selectedMonth, DateTime.DaysInMonth(selectedYear, selectedMonth));
        }
        else
        {
            fromDate = new DateTime(selectedYear, selectedMonth, 1);
            toDate = new DateTime(selectedYear, selectedMonth, DateTime.DaysInMonth(selectedYear, selectedMonth));
        }

        await LoadDataAsync();
    }

    private async Task OnMonthChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var m) && m >= 1 && m <= 12)
        {
            selectedMonth = m;
            fromDate = new DateTime(selectedYear, selectedMonth, 1);
            toDate = new DateTime(selectedYear, selectedMonth, DateTime.DaysInMonth(selectedYear, selectedMonth));
            selectedStatusFilter = null;
            await LoadDataAsync();
        }
    }

    private async Task OnYearChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var y) && y >= 1900)
        {
            selectedYear = y;
            fromDate = new DateTime(selectedYear, selectedMonth, 1);
            toDate = new DateTime(selectedYear, selectedMonth, DateTime.DaysInMonth(selectedYear, selectedMonth));
            selectedStatusFilter = null;
            await LoadDataAsync();
        }
    }

    private async Task OnFromDateChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        if (!string.IsNullOrWhiteSpace(val) && DateTime.TryParse(val, out var d))
        {
            fromDate = d;
            selectedStatusFilter = null;
            if (fromDate > toDate) toDate = fromDate;
            await LoadDataAsync();
        }
    }

    private async Task OnToDateChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        if (!string.IsNullOrWhiteSpace(val) && DateTime.TryParse(val, out var d))
        {
            toDate = d;
            selectedStatusFilter = null;
            if (toDate < fromDate) fromDate = toDate;
            await LoadDataAsync();
        }
    }

    private async Task SwitchToMonth(int m, int y)
    {
        filterMode = "month";
        selectedMonth = m;
        selectedYear = y;
        fromDate = new DateTime(selectedYear, selectedMonth, 1);
        toDate = new DateTime(selectedYear, selectedMonth, DateTime.DaysInMonth(selectedYear, selectedMonth));
        selectedStatusFilter = null;
        await LoadDataAsync();
    }

    private async Task ResetFilters()
    {
        filterMode = "month";
        selectedYear = DateTime.Today.Year;
        selectedMonth = DateTime.Today.Month;
        fromDate = new DateTime(selectedYear, selectedMonth, 1);
        toDate = new DateTime(selectedYear, selectedMonth, DateTime.DaysInMonth(selectedYear, selectedMonth));
        selectedStatusFilter = null;
        await LoadDataAsync();
    }

    /* ───── Navigation ───── */
    private async Task HandleBack() => await OnBackClicked.InvokeAsync();

    /* ───── Excel Export ───── */
    private async Task ExportToExcelAsync()
    {
        if (Employee == null || !cachedFilteredRecords.Any())
        {
            await NotificationService.Warning("No attendance records to export.");
            return;
        }

        try
        {
            isExporting = true;
            StateHasChanged();

            string periodTitle = filterMode == "month"
                ? $"{MonthName(selectedMonth)} {selectedYear}"
                : $"{FormatDate(fromDate)} to {FormatDate(toDate)}";

            var bytes = ExcelExportService.ExportAttendanceReport(
                Employee,
                cachedFilteredRecords,
                periodTitle,
                attendanceRate,
                averageCount,
                totalWorkingDays,
                presentCount,
                lateCount,
                halfDayCount,
                absentCount,
                onLeaveCount);

            var base64 = Convert.ToBase64String(bytes);
            var safeEmpNum = string.IsNullOrWhiteSpace(Employee.EmployeeNumber) ? "EMP" : Employee.EmployeeNumber.Replace(" ", "_");
            var fileName = $"Attendance_Report_{safeEmpNum}_{DateTime.Now:yyyyMMdd_HHmm}.xlsx";

            try
            {
                await JS.InvokeVoidAsync("downloadFileFromBase64", fileName, base64, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
            }
            catch
            {
                await JS.InvokeVoidAsync("eval", @"
                    window.downloadFileFromBase64 = function(fileName, base64Data, contentType) {
                        contentType = contentType || 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet';
                        var byteChars = atob(base64Data);
                        var byteNums = new Array(byteChars.length);
                        for (var i = 0; i < byteChars.length; i++) { byteNums[i] = byteChars.charCodeAt(i); }
                        var blob = new Blob([new Uint8Array(byteNums)], { type: contentType });
                        var url = URL.createObjectURL(blob);
                        var a = document.createElement('a');
                        a.href = url;
                        a.download = fileName;
                        document.body.appendChild(a);
                        a.click();
                        document.body.removeChild(a);
                        URL.revokeObjectURL(url);
                    };
                ");
                await JS.InvokeVoidAsync("downloadFileFromBase64", fileName, base64, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
            }

            await NotificationService.Success("Attendance report exported successfully!");
        }
        catch (Exception ex)
        {
            await NotificationService.Error($"Export failed: {ex.Message}");
        }
        finally
        {
            isExporting = false;
            StateHasChanged();
        }
    }
}
