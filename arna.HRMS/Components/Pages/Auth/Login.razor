@page "/login"
@layout LoginLayout

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Authorization
@using arna.HRMS.Components.Layout
@using arna.HRMS.Components.lib.components.ui.Forms
@using arna.HRMS.Models.ViewModels.Auth
@using arna.HRMS.Services.Auth
@using arna.HRMS.Services.Common

@inject NavigationManager NavigationManager
@inject IAuthService AuthService
@inject AuthenticationStateProvider AuthStateProvider
@inject NotificationService NotificationService

<PageTitle>Arna HRMS - Login</PageTitle>

<div class="login-page-wrap">

    <!-- ══════════ AMBIENT FLUID WAVES & BACKGROUND CANVAS ══════════ -->
    <div class="page-bg-ambient" aria-hidden="true">
        <div class="ambient-glow glow-top-left"></div>
        <div class="ambient-glow glow-top-right"></div>
        <div class="ambient-glow glow-bottom-left"></div>

        <svg class="ambient-wave-canvas" viewBox="0 0 1600 1000" preserveAspectRatio="none" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
                <linearGradient id="wave1" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#93cbfb" stop-opacity="0.6" />
                    <stop offset="45%" stop-color="#cbe5fe" stop-opacity="0.4" />
                    <stop offset="100%" stop-color="#edf5fc" stop-opacity="0.08" />
                </linearGradient>
                <linearGradient id="wave2" x1="100%" y1="0%" x2="0%" y2="100%">
                    <stop offset="0%" stop-color="#7ec3f8" stop-opacity="0.5" />
                    <stop offset="55%" stop-color="#bee0fc" stop-opacity="0.3" />
                    <stop offset="100%" stop-color="#edf5fc" stop-opacity="0.08" />
                </linearGradient>
                <linearGradient id="wave3" x1="0%" y1="100%" x2="100%" y2="0%">
                    <stop offset="0%" stop-color="#bae6fd" stop-opacity="0.65" />
                    <stop offset="50%" stop-color="#dff0fd" stop-opacity="0.35" />
                    <stop offset="100%" stop-color="#ffffff" stop-opacity="0.05" />
                </linearGradient>
                <linearGradient id="waveAccent" x1="0%" y1="0%" x2="100%" y2="0%">
                    <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.25" />
                    <stop offset="100%" stop-color="#0076ce" stop-opacity="0.15" />
                </linearGradient>
            </defs>

            <!-- Organic Flow Wave 1 (Left & Center Sweeping Ribbon) -->
            <path d="M0,0 L920,0 C800,160 640,290 680,440 C730,600 940,650 1040,790 C1100,880 1020,950 940,1000 L0,1000 Z" fill="url(#wave1)" />

            <!-- Organic Flow Wave 2 (Right Sweeping Arc) -->
            <path d="M1600,0 L1120,0 C1220,180 1370,300 1300,490 C1220,690 1070,760 1170,1000 L1600,1000 Z" fill="url(#wave2)" />

            <!-- Organic Flow Wave 3 (Bottom Sweeping Ribbon) -->
            <path d="M0,720 C320,640 560,840 850,760 C1140,680 1340,840 1600,780 L1600,1000 L0,1000 Z" fill="url(#wave3)" />

            <!-- Delicate Wave Contour Line -->
            <path d="M0,720 C320,640 560,840 850,760 C1140,680 1340,840 1600,780" stroke="url(#waveAccent)" stroke-width="2.5" />
        </svg>

        <!-- Elegant Decorative Floating Rings -->
        <div class="geo-circle geo-circle-1"></div>
        <div class="geo-circle geo-circle-2"></div>
        <div class="geo-circle geo-circle-3"></div>

        <!-- Subtle Dot Grid Texture -->
        <div class="ambient-dots"></div>
    </div>

    <div class="container-fluid p-0 position-relative z-1">
        <div class="row g-0 min-vh-100">

            <!-- ══════════ LEFT HERO SHOWCASE PANEL (Desktop only) ══════════ -->
            <div class="col-lg-6 col-xl-7 d-none d-lg-flex login-hero-panel">

                <div class="hero-inner-wrap">

                    <!-- Brand Header -->
                    <div class="hero-brand-wrap">
                        <img src="companyLogo/arna_logo.svg"
                             alt="Arna HRMS"
                             class="hero-brand-logo" />
                    </div>

                    <!-- Headline & Lead Description -->
                    <h1 class="hero-headline">
                        Manage People,<br />
                        <span class="hero-headline-highlight">Build a Better Workplace</span>
                    </h1>
                    <p class="hero-lead">
                        A unified HR platform for attendance, leave management, and workforce intelligence.
                    </p>

                    <!-- Minimalist Capability Badges -->
                    <div class="hero-badges-row">
                        <div class="hero-badge-item">
                            <i class="bi bi-calendar2-check"></i>
                            <span>Attendance &amp; Leave</span>
                        </div>
                        <div class="hero-badge-item">
                            <i class="bi bi-bar-chart-line"></i>
                            <span>Reports &amp; Analytics</span>
                        </div>
                        <div class="hero-badge-item">
                            <i class="bi bi-shield-check"></i>
                            <span>Enterprise Security</span>
                        </div>
                    </div>

                </div>

            </div>

            <!-- ══════════ RIGHT FORM PANEL ══════════ -->
            <div class="col-12 col-lg-6 col-xl-5 login-form-panel">

                <div class="auth-card-container">

                    <div class="auth-card">

                        <!-- Card Header -->
                        <div class="auth-card-header">
                            <img src="companyLogo/arna_logo.svg"
                                 alt="Arna HRMS"
                                 class="auth-brand-logo" />
                            <div class="auth-brand-sub">HRMS</div>

                            <h2 class="auth-card-title">Welcome Back</h2>
                            <p class="auth-card-subtitle">
                                Sign in to continue to your account
                            </p>
                        </div>

                        <!-- Error Alert -->
                        @if (!string.IsNullOrWhiteSpace(errorMessage))
                        {
                            <div class="auth-alert auth-alert-danger mb-3" role="alert">
                                <i class="bi bi-exclamation-triangle-fill text-danger me-1"></i>
                                <span class="flex-grow-1">@errorMessage</span>
                                <button type="button"
                                        class="btn-close ms-2"
                                        style="font-size: 0.7rem;"
                                        @onclick="() => errorMessage = null"
                                        aria-label="Close">
                                </button>
                            </div>
                        }

                        <!-- Login Form -->
                        <EditForm Model="@loginModel" OnValidSubmit="HandleLogin">
                            <DataAnnotationsValidator />

                            <!-- Username -->
                            <div class="mb-3">
                                <label class="auth-label">
                                    Username
                                </label>
                                <div class="auth-input-group">
                                    <span class="auth-field-icon">
                                        <i class="bi bi-person-fill"></i>
                                    </span>
                                    <AppInput @bind-Value="loginModel.UserName"
                                              Type="text"
                                              ShowWrapper="false"
                                              CssClass="auth-field-input"
                                              placeholder="Enter your username"
                                              autofocus="true" />
                                </div>
                                <ValidationMessage For="@(() => loginModel.UserName)"
                                                   class="text-danger small mt-1" />
                            </div>

                            <!-- Password -->
                            <div class="mb-4">
                                <label class="auth-label">
                                    Password
                                </label>
                                <div class="auth-input-group">
                                    <span class="auth-field-icon">
                                        <i class="bi bi-lock-fill"></i>
                                    </span>
                                    <AppInput @bind-Value="loginModel.Password"
                                              Type="@passwordInputType"
                                              ShowWrapper="false"
                                              CssClass="auth-field-input"
                                              placeholder="Enter your password" />
                                    <button type="button"
                                            class="auth-eye-btn"
                                            @onclick="TogglePasswordVisibility"
                                            tabindex="-1"
                                            aria-label="Toggle password visibility">
                                        <i class="bi @(showPassword ? "bi-eye-slash" : "bi-eye")"></i>
                                    </button>
                                </div>
                                <ValidationMessage For="@(() => loginModel.Password)"
                                                   class="text-danger small mt-1" />
                            </div>

                            <!-- Submit Button ("→ Sign In") -->
                            <div class="d-grid mb-2">
                                <button type="submit"
                                        class="btn auth-btn-primary w-100"
                                        disabled="@isLoading">
                                    @if (isLoading)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                        <span>Signing in…</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-arrow-right"></i>
                                        <span>Sign In</span>
                                    }
                                </button>
                            </div>
                        </EditForm>

                        <!-- Card Security Footer -->
                        <div class="auth-footer-shield">
                            <i class="bi bi-shield-check"></i>
                            <span>Secured by <strong class="text-primary">Arna Technosoft</strong></span>
                        </div>

                    </div>

                    <!-- Page Copyright -->
                    <p class="auth-copyright">
                        &copy; @DateTime.Now.Year Arna Technosoft. All rights reserved.
                    </p>

                </div>

            </div>

        </div>
    </div>

</div>

@code {
    private LoginViewModel loginModel = new();
    private string? errorMessage;
    private bool isLoading;
    private bool showPassword;

    private string passwordInputType =>
        showPassword ? "text" : "password";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            NavigationManager.NavigateTo("/", replace: true);
        }
    }

    private async Task HandleLogin()
    {
        errorMessage = null;
        isLoading = true;

        try
        {
            var success = await AuthService.LoginAsync(loginModel);

            if (!success)
            {
                errorMessage = "Invalid username or password.";
                return;
            }

            await NotificationService.Success("User Login Successfully!");
            NavigationManager.NavigateTo("/", true);
        }
        catch (Exception ex)
        {
            errorMessage = $"An unexpected error occurred: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void TogglePasswordVisibility() =>
        showPassword = !showPassword;
}
