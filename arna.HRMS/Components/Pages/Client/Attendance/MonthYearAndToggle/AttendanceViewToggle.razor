<div class="view-toggle-container" role="group" aria-label="Attendance View Toggle">
    <button type="button"
            class="view-toggle-btn @(ActiveView == TableView ? "active" : "")"
            @onclick="() => OnChange.InvokeAsync(TableView)"
            title="Table View">
        <i class="bi bi-table"></i>
        <span>Table</span>
    </button>

    <button type="button"
            class="view-toggle-btn @(ActiveView == CalendarView ? "active" : "")"
            @onclick="() => OnChange.InvokeAsync(CalendarView)"
            title="Calendar View">
        <i class="bi bi-calendar3"></i>
        <span>Calendar</span>
    </button>
</div>

@code {
    /* ================= PARAMETERS ================= */

    [Parameter, EditorRequired]
    public string ActiveView { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public EventCallback<string> OnChange { get; set; }

    /* ================= CONSTANTS ================= */

    private const string TableView = "table";
    private const string CalendarView = "calendar";
}
