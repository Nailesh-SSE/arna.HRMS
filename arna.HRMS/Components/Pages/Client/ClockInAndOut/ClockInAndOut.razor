@namespace arna.HRMS.Components.Pages.Client.ClockInAndOut
@using arna.HRMS.Components.Loader
@using arna.HRMS.Components.Pages.Attendance
@using arna.HRMS.Models.Enums
@using arna.HRMS.Models.ViewModels.Attendance
@using arna.HRMS.Services
@using arna.HRMS.Services.Auth

@implements IDisposable
@inject IAttendanceService ClockService
@inject IJSRuntime JS
@inherits AuthenticatedLayoutBase

<Loader Visible="@IsLoading" Message="@LoaderMessage" />

@if (IsEmployee())
{
    <div class="card border-0 shadow-sm rounded-3 mb-4 punch-card overflow-hidden">
        <div class="card-body p-3 p-lg-4">

            <!-- Attendance Metric Bar (6 Columns) -->
            <div class="row g-3 align-items-center">

                <!-- 1. First Clock In -->
                <div class="col-6 col-sm-4 col-lg-2 punch-col">
                    <div class="punch-item">
                        <span class="punch-label">First Clock In</span>
                        <div class="punch-value">
                            @(string.IsNullOrEmpty(FirstClockInDisplay) ? "--:--" : FirstClockInDisplay)
                        </div>
                        <span class="punch-subtext">@(string.IsNullOrEmpty(FirstClockInDisplay) ? "--" : TodayDateStr)</span>
                    </div>
                </div>

                <!-- 2. Last Clock Out -->
                <div class="col-6 col-sm-4 col-lg-2 punch-col">
                    <div class="punch-item">
                        <span class="punch-label">Last Clock Out</span>
                        <div class="punch-value">
                            @(string.IsNullOrEmpty(LastClockOutDisplay) ? "--:--" : LastClockOutDisplay)
                        </div>
                        <span class="punch-subtext">@(string.IsNullOrEmpty(LastClockOutDisplay) ? "--" : TodayDateStr)</span>
                    </div>
                </div>

                <!-- 3. Today's Work Duration -->
                <div class="col-6 col-sm-4 col-lg-2 punch-col">
                    <div class="punch-item">
                        <span class="punch-label">Today's Work Duration</span>
                        <div class="punch-value">
                            @TodayWorkDisplay
                        </div>
                        <span class="punch-subtext">Total Duration</span>
                    </div>
                </div>

                <!-- 4. Break Duration -->
                <div class="col-6 col-sm-4 col-lg-2 punch-col">
                    <div class="punch-item">
                        <span class="punch-label">Break Duration</span>
                        <div class="punch-value">
                            @TodayBreakDisplay
                        </div>
                        <span class="punch-subtext">Total Break</span>
                    </div>
                </div>

                <!-- 5. Live Running Timer -->
                <div class="col-6 col-sm-4 col-lg-2 punch-col">
                    <div class="punch-item">
                        <span class="punch-label">Live Running Timer</span>
                        <div class="punch-value punch-timer @(IsClockedIn ? "text-success" : (BaseTodayWorkDuration > TimeSpan.Zero ? "text-primary" : "text-dark"))">
                            <i class="bi @(IsClockedIn ? "bi-clock-history text-success timer-icon me-2" : "bi-pause-circle text-muted timer-icon me-2")"></i>
                            <span>@SessionDuration</span>
                        </div>
                        <span class="punch-subtext @(IsClockedIn ? "text-success fw-medium" : "text-muted")">
                            @(IsClockedIn ? "Running..." : (BaseTodayWorkDuration > TimeSpan.Zero ? "Paused" : "Ready"))
                        </span>
                    </div>
                </div>

                <!-- 6. Large Primary Action Button -->
                <div class="col-6 col-sm-4 col-lg-2 text-start text-lg-end">
                    <button class="btn punch-btn @GetClockButtonClass() d-inline-flex align-items-center justify-content-center px-3 px-xl-4 py-2 fw-semibold shadow-sm w-100"
                            @onclick="HandleClockButtonClick"
                            title="@(MissedClockOutYesterday && !IsClockedIn ? (!string.IsNullOrEmpty(MissedClockOutDateStr) ? $"You forgot to clock out on {MissedClockOutDateStr}" : "You forgot to clock out yesterday") : "")"
                            disabled="@(CooldownActive || ShowDynamicForm || IsLoading)">
                        @if (CooldownActive)
                        {
                            <i class="bi bi-hourglass-split me-2 text-white"></i>
                            <span class="text-white">@(IsClockedIn ? "Clock Out" : "Clock In") (@(CooldownRemaining)s)</span>
                        }
                        else if (MissedClockOutYesterday && !IsClockedIn)
                        {
                            <i class="bi bi-exclamation-triangle-fill me-2 missed-warning-icon"></i>
                            <span class="text-white">Clock In</span>
                        }
                        else if (IsClockedIn)
                        {
                            <i class="bi bi-box-arrow-right me-2 text-white"></i>
                            <span class="text-white">Clock Out</span>
                        }
                        else
                        {
                            <i class="bi bi-box-arrow-in-right me-2 text-white"></i>
                            <span class="text-white">Clock In</span>
                        }
                    </button>
                </div>

            </div>
        </div>
    </div>

    <!-- ═══════ MISSED CLOCK-OUT MODAL ═══════ -->
    @if (ShowMissedClockOutModal)
    {
        <div class="position-fixed top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center p-2 p-md-3"
             style="z-index:1050; background:rgba(0,0,0,.5); backdrop-filter:blur(3px);"
             @onclick="CloseMissedModal">

            <div class="bg-white rounded-4 shadow-lg w-100 overflow-hidden"
                 style="max-width:460px;"
                 @onclick:stopPropagation="true">

                <div class="d-flex align-items-center justify-content-between px-3 py-2 text-white bg-danger bg-gradient">
                    <div class="d-flex align-items-center gap-2 fw-semibold small">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        Missed Clock-Out!
                    </div>
                    <button class="btn btn-sm text-white p-0 border-0"
                            @onclick="CloseMissedModal">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>

                <div class="p-4">
                    <div class="mb-4">
                        <p class="text-muted mb-3">
                            <i class="bi bi-info-circle text-danger me-2"></i>
                            <strong>You forgot to clock out on your previous session @(!string.IsNullOrEmpty(MissedClockOutDateStr) ? $"({MissedClockOutDateStr})" : "yesterday").</strong>
                        </p>
                        <p class="text-muted">
                            Please clock in to start a new session. Your last session was recorded. You missed clocking out—please submit an attendance request if needed.
                        </p>
                    </div>

                    <div class="d-flex gap-2 justify-content-end">
                        <button class="btn btn-danger px-4"
                                @onclick="CloseMissedModal">
                            <i class="bi bi-check-lg me-2"></i>OK
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- ═══════ CLOCK IN/OUT FORM MODAL ═══════ -->
    @if (ShowDynamicForm)
    {
        <div class="position-fixed top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center p-2 p-md-3"
             style="z-index:1050; background:rgba(0,0,0,.5); backdrop-filter:blur(3px);"
             @onclick="CloseForm">

            <div class="bg-white rounded-4 shadow-lg w-100 overflow-hidden animate-scale-in"
                 style="max-width:480px;"
                 @onclick:stopPropagation="true">

                <div class="d-flex align-items-center justify-content-between px-4 py-3 text-white @(PendingClockIn == true ? "bg-primary" : "bg-danger")">
                    <div class="d-flex align-items-center gap-2 fw-semibold">
                        <i class="bi @(PendingClockIn == true ? "bi-box-arrow-in-right" : "bi-box-arrow-right") fs-5"></i>
                        <span>@(PendingClockIn == true ? "Clock In Confirmation" : "Clock Out Confirmation")</span>

                        @if (MissedClockOutYesterday && PendingClockIn == true)
                        {
                            <span class="badge bg-white text-danger rounded-pill px-2.5 py-1 ms-2" style="font-size: 0.70rem;">
                                Missed yesterday
                            </span>
                        }
                        else if (PendingClockIn == true && (DateTime.Today.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday))
                        {
                            <span class="badge bg-warning text-dark rounded-pill px-2.5 py-1 ms-2" style="font-size: 0.70rem;">
                                <i class="bi bi-calendar-event me-1"></i> Weekend Duty
                            </span>
                        }
                    </div>
                    <button class="btn btn-sm text-white p-0 border-0" @onclick="CloseForm">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
                <div class="p-4">
                    <ClockInAndOutMessage Model="AttendanceFormModel"
                                          IsClockIn="@(PendingClockIn == true)"
                                          IsMissedYesterday="@(MissedClockOutYesterday && PendingClockIn == true)"
                                          OnSubmit="SubmitClockActionAsync"
                                          OnCancel="CloseForm" />
                </div>
            </div>
        </div>
    }

    <!-- ═══════ TOAST ALERTS ═══════ -->
    @if (ShowToast)
    {
        <div class="position-fixed bottom-0 end-0 p-3" style="z-index:1090;">
            <div class="toast show border-0 shadow-lg rounded-3 @(IsToastWarning ? "bg-warning text-dark" : "bg-success text-white")"
                 role="alert">
                <div class="toast-body d-flex align-items-center gap-2 py-3 px-4">
                    <i class="bi @(IsToastWarning ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill") fs-5 me-1"></i>
                    <span class="small fw-semibold">@ToastMessage</span>
                    <button type="button"
                            class="btn-close @(IsToastWarning ? "" : "btn-close-white") ms-auto"
                            @onclick="() => ShowToast = false"></button>
                </div>
            </div>
        </div>
    }
}

@code {
    [Parameter] public int? EmployeeId { get; set; }
    [Parameter] public EventCallback OnClockStatusChanged { get; set; }

    // State
    private bool IsLoading;
    private string LoaderMessage = "";
    private string TodayDateStr = DateTime.Now.ToString("dd MMM yyyy");

    private bool IsClockedIn;
    private bool CooldownActive;
    private int CooldownRemaining;
    private bool ShowDynamicForm;
    private bool ShowMissedClockOutModal;
    private bool? PendingClockIn;
    private bool ShowToast;
    private bool IsToastWarning;
    private string ToastMessage = "";
    private DateTime? LastClockInDateTime;
    private double? CurrentLatitude;
    private double? CurrentLongitude;
    private bool MissedClockOutYesterday;
    private string MissedClockOutDateStr = "";

    private AttendanceViewModel AttendanceFormModel = new();
    private string FirstClockInDisplay = "";
    private string LastClockOutDisplay = "";
    private string TodayWorkDisplay = "00h 00m";
    private string TodayBreakDisplay = "00h 00m";
    private string SessionDuration = "00:00:00";
    private TimeSpan BaseTodayWorkDuration = TimeSpan.Zero;

    private const int CooldownSec = 60;
    private const string TimeFmt = "hh:mm tt";
    private CancellationTokenSource? _liveTimerCts;
    private CancellationTokenSource? _cooldownCts;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await LoadClockStatusAsync();
        StartLiveSessionTimer();
    }

    private int ResolvedEmployeeId => EmployeeId ?? GetEmployeeId();

    public async Task RefreshAsync()
    {
        await LoadClockStatusAsync();
        StateHasChanged();
    }

    public async Task LoadClockStatusAsync()
    {
        try
        {
            var empId = ResolvedEmployeeId;
            if (empId <= 0) return;

            MissedClockOutYesterday = false;

            var todayResult = await ClockService.GetTodayClockinEntryAsync(empId);
            var todayRecords = todayResult?.Data ?? new List<AttendanceViewModel>();

            if (todayRecords.Any())
            {
                var firstClock = todayRecords
                    .Where(x => x.ClockInTime != null)
                    .OrderBy(x => x.ClockInTime)
                    .FirstOrDefault();

                if (firstClock?.ClockInTime != null)
                    FirstClockInDisplay = Fmt(firstClock.ClockInTime.Value);

                var lastClockOut = todayRecords
                    .Where(x => x.ClockOutTime != null)
                    .OrderByDescending(x => x.ClockOutTime)
                    .FirstOrDefault();

                if (lastClockOut?.ClockOutTime != null)
                    LastClockOutDisplay = Fmt(lastClockOut.ClockOutTime.Value);

                var lastRecord = todayRecords
                    .OrderByDescending(x => x.CreatedOn)
                    .FirstOrDefault();

                if (lastRecord != null)
                {
                    if (lastRecord.ClockInTime != null && lastRecord.ClockOutTime == null)
                    {
                        IsClockedIn = true;
                        LastClockInDateTime = lastRecord.CreatedOn;
                    }
                    else
                    {
                        IsClockedIn = false;
                    }

                    if (lastRecord.CreatedOn != default)
                    {
                        var remaining = CooldownSec - (int)(DateTime.Now - lastRecord.CreatedOn).TotalSeconds;
                        if (remaining > 0)
                            _ = CooldownAsync(remaining);
                    }
                }

                CalculateTodayDurations(todayRecords);
                return;
            }

            // Check if user forgot to clock out yesterday (or on their previous working day)
            try
            {
                var historyResult = await ClockService.GetAttendanceByEmployeeOrStatusAsync(null, empId);
                if (historyResult?.Data != null)
                {
                    var lastPast = historyResult.Data
                        .Where(x => x.Date.Date < DateTime.Today &&
                                    x.StatusId != AttendanceStatus.Leave &&
                                    x.ClockInTime != null)
                        .OrderByDescending(x => x.Date)
                        .ThenByDescending(x => x.ClockInTime ?? TimeSpan.Zero)
                        .FirstOrDefault();

                    if (lastPast != null &&
                        lastPast.ClockInTime != null &&
                        (lastPast.ClockOutTime == null || lastPast.ClockOutTime == TimeSpan.Zero))
                    {
                        MissedClockOutYesterday = true;
                        MissedClockOutDateStr = lastPast.Date.ToString("dd MMM yyyy");
                        ShowMissedClockOutModal = true;
                    }
                    else
                    {
                        MissedClockOutYesterday = false;
                        MissedClockOutDateStr = "";
                        ShowMissedClockOutModal = false;
                    }
                }
                else
                {
                    MissedClockOutYesterday = false;
                }
            }
            catch (Exception exHist)
            {
                Console.WriteLine($"[ClockInAndOut] Error checking yesterday attendance: {exHist.Message}");
                MissedClockOutYesterday = false;
            }

            IsClockedIn = false;

            TodayWorkDisplay = "00h 00m";
            TodayBreakDisplay = "00h 00m";
            SessionDuration = "00:00:00";
            BaseTodayWorkDuration = TimeSpan.Zero;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ClockInAndOut] Error loading clock status: {ex.Message}");
        }
    }

    private void CalculateTodayDurations(List<AttendanceViewModel> todayRecords)
    {
        var validCompleted = todayRecords
            .Where(x => x.ClockInTime != null && x.ClockOutTime != null)
            .OrderBy(x => x.ClockInTime)
            .ToList();

        var totalWork = TimeSpan.Zero;
        foreach (var entry in validCompleted)
        {
            if (entry.WorkingHours != null && entry.WorkingHours.Value > TimeSpan.Zero)
                totalWork += entry.WorkingHours.Value;
            else if (entry.ClockInTime != null && entry.ClockOutTime != null)
                totalWork += (entry.ClockOutTime.Value - entry.ClockInTime.Value);
        }

        BaseTodayWorkDuration = totalWork;

        var totalBreak = TimeSpan.Zero;
        for (int i = 1; i < validCompleted.Count; i++)
        {
            var prevOut = validCompleted[i - 1].ClockOutTime;
            var curIn = validCompleted[i].ClockInTime;
            if (prevOut != null && curIn != null && curIn.Value > prevOut.Value)
            {
                totalBreak += (curIn.Value - prevOut.Value);
            }
        }

        TodayBreakDisplay = $"{(int)totalBreak.TotalHours:D2}h {totalBreak.Minutes:D2}m";

        if (IsClockedIn && LastClockInDateTime != null)
        {
            var activeSession = DateTime.Now - LastClockInDateTime.Value;
            if (activeSession < TimeSpan.Zero) activeSession = TimeSpan.Zero;
            var currentTotal = totalWork + activeSession;
            TodayWorkDisplay = $"{(int)currentTotal.TotalHours:D2}h {currentTotal.Minutes:D2}m";
            SessionDuration = activeSession.ToString(@"hh\:mm\:ss");
        }
        else
        {
            TodayWorkDisplay = $"{(int)totalWork.TotalHours:D2}h {totalWork.Minutes:D2}m";
            SessionDuration = "00:00:00";
        }
    }

    private void StartLiveSessionTimer()
    {
        _liveTimerCts?.Cancel();
        _liveTimerCts = new CancellationTokenSource();
        var token = _liveTimerCts.Token;

        _ = Task.Run(async () =>
        {
            using var periodic = new PeriodicTimer(TimeSpan.FromSeconds(1));
            try
            {
                while (await periodic.WaitForNextTickAsync(token))
                {
                    if (IsClockedIn && LastClockInDateTime != null)
                    {
                        var elapsed = DateTime.Now - LastClockInDateTime.Value;
                        if (elapsed < TimeSpan.Zero) elapsed = TimeSpan.Zero;

                        SessionDuration = elapsed.ToString(@"hh\:mm\:ss");
                        var currentTotal = BaseTodayWorkDuration + elapsed;
                        TodayWorkDisplay = $"{(int)currentTotal.TotalHours:D2}h {currentTotal.Minutes:D2}m";

                        await InvokeAsync(StateHasChanged);
                    }
                }
            }
            catch (OperationCanceledException) { }
        }, token);
    }

    private async Task HandleClockButtonClick()
    {
        if (CooldownActive || ShowDynamicForm || IsLoading) return;
        PendingClockIn = !IsClockedIn;
        await OpenFormWithLocation();
    }

    private async Task OpenFormWithLocation()
    {
        try
        {
            await SetLoading(true, "Capturing location…");
            var loc = await ClockService.GetCurrentLocationAsync();

            if (loc is null)
            {
                await ShowToastMessage("Location permission is required to log attendance.", warning: true);
                return;
            }

            CurrentLatitude = loc.Value.Latitude;
            CurrentLongitude = loc.Value.Longitude;
            AttendanceFormModel = new();
            ShowDynamicForm = true;
        }
        catch (Exception ex)
        {
            await ShowToastMessage($"Location Error: {ex.Message}", warning: true);
        }
        finally
        {
            await SetLoading(false);
        }
    }

    private void CloseForm()
    {
        ShowDynamicForm = false;
        CurrentLatitude = null;
        CurrentLongitude = null;
        StateHasChanged();
    }

    private void CloseMissedModal()
    {
        ShowMissedClockOutModal = false;
        StateHasChanged();
    }

    private async Task SubmitClockActionAsync()
    {
        if (CurrentLatitude is null || CurrentLongitude is null)
        {
            await ShowToastMessage("Location is required for attendance.", warning: true);
            return;
        }

        ShowDynamicForm = false;
        var isIn = PendingClockIn == true;

        try
        {
            await SetLoading(true, isIn ? "Logging Clock In…" : "Logging Clock Out…");

            var empId = ResolvedEmployeeId;
            if (empId <= 0)
            {
                await ShowToastMessage("Employee profile not found.", warning: true);
                return;
            }

            DeviceType device = DeviceType.LaptopDesktop;
            try
            {
                var deviceStr = await JS.InvokeAsync<string>("deviceHelper.getDeviceType");
                if (!Enum.TryParse<DeviceType>(deviceStr, true, out device) || device == DeviceType.UnknownDevice)
                    device = DeviceType.LaptopDesktop;
            }
            catch
            {
                device = DeviceType.LaptopDesktop;
            }

            var now = DateTime.Now;

            if (isIn)
            {
                var vm = BuildVm(empId, device, clockIn: now.TimeOfDay);
                var res = await ClockService.CreateAttendanceAsync(vm);
                if (res?.IsSuccess == true)
                {
                    IsClockedIn = true;
                    LastClockInDateTime = now;
                    SessionDuration = "00:00:00";
                    MissedClockOutYesterday = false;
                    MissedClockOutDateStr = "";
                    ShowMissedClockOutModal = false;
                    if (string.IsNullOrEmpty(FirstClockInDisplay))
                        FirstClockInDisplay = now.ToString(TimeFmt);

                    _ = CooldownAsync(CooldownSec);
                    await ShowToastMessage($"Successfully Clocked In at {now.ToString(TimeFmt)}");
                }
                else
                {
                    await ShowToastMessage(res?.Message ?? "Clock-In failed.", warning: true);
                }
            }
            else
            {
                var hours = LastClockInDateTime != null ? now - LastClockInDateTime.Value : TimeSpan.Zero;
                if (hours < TimeSpan.Zero) hours = TimeSpan.Zero;

                var vm = BuildVm(empId, device, clockOut: now.TimeOfDay, hours: hours);
                var res = await ClockService.CreateAttendanceAsync(vm);
                if (res?.IsSuccess == true)
                {
                    IsClockedIn = false;
                    SessionDuration = "00:00:00";
                    LastClockOutDisplay = now.ToString(TimeFmt);

                    _ = CooldownAsync(CooldownSec);
                    await ShowToastMessage($"Successfully Clocked Out at {now.ToString(TimeFmt)}");
                }
                else
                {
                    await ShowToastMessage(res?.Message ?? "Clock-Out failed.", warning: true);
                }
            }

            await LoadClockStatusAsync();

            if (OnClockStatusChanged.HasDelegate)
            {
                await OnClockStatusChanged.InvokeAsync();
            }
        }
        catch (Exception ex)
        {
            await ShowToastMessage($"Error: {ex.Message}", warning: true);
        }
        finally
        {
            CurrentLatitude = CurrentLongitude = null;
            await SetLoading(false);
        }
    }

    private AttendanceViewModel BuildVm(
        int empId,
        DeviceType device,
        TimeSpan? clockIn = null,
        TimeSpan? clockOut = null,
        TimeSpan? hours = null) => new()
        {
            EmployeeId = empId,
            Date = DateTime.Today,
            ClockInTime = clockIn,
            ClockOutTime = clockOut,
            WorkingHours = hours,
            DeviceId = device,
            Latitude = CurrentLatitude,
            Longitude = CurrentLongitude,
            Notes = AttendanceFormModel.Notes ?? string.Empty,
            StatusId = AttendanceStatus.Present
        };

    private async Task CooldownAsync(int seconds)
    {
        _cooldownCts?.Cancel();
        _cooldownCts = new CancellationTokenSource();
        var token = _cooldownCts.Token;

        CooldownActive = true;
        CooldownRemaining = seconds;

        try
        {
            await InvokeAsync(StateHasChanged);
            while (CooldownRemaining > 0 && !token.IsCancellationRequested)
            {
                await Task.Delay(1000, token);
                CooldownRemaining--;
                await InvokeAsync(StateHasChanged);
            }
            CooldownActive = false;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) { }
    }

    private static string Fmt(TimeSpan ts) => TimeOnly.FromTimeSpan(ts).ToString(TimeFmt);

    private async Task ShowToastMessage(string msg, bool warning = false)
    {
        ToastMessage = msg;
        IsToastWarning = warning;
        ShowToast = true;
        await InvokeAsync(StateHasChanged);

        try { await Task.Delay(4000); } catch { }

        ShowToast = false;
        try { await InvokeAsync(StateHasChanged); } catch { }
    }

    private async Task SetLoading(bool on, string msg = "")
    {
        IsLoading = on;
        LoaderMessage = on ? msg : "";
        await InvokeAsync(StateHasChanged);
    }

    private string GetClockButtonClass()
    {
        if (CooldownActive)
        {
            return IsClockedIn ? "punch-btn-cooldown-out" : "punch-btn-cooldown-in";
        }
        if (MissedClockOutYesterday && !IsClockedIn)
        {
            return "punch-btn-missed";
        }
        if (IsClockedIn)
        {
            return "punch-btn-out";
        }
        return "punch-btn-in";
    }

    public void Dispose()
    {
        _liveTimerCts?.Cancel();
        _liveTimerCts?.Dispose();
        _cooldownCts?.Cancel();
        _cooldownCts?.Dispose();
    }
}