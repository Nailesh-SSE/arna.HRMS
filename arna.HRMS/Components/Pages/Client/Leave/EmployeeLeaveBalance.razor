@using arna.HRMS.Models.ViewModels.Leave
@using arna.HRMS.Models.Enums
@using arna.HRMS.Services
@using arna.HRMS.Services.Auth

@inject ILeaveService LeaveService
@inherits AuthenticatedLayoutBase

<div class="mb-3">
    @if (isLoading)
    {
        <div class="row g-3 row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4">
            @for (int i = 0; i < 2; i++)
            {
                <div class="col">
                    <div class="card border rounded-3 bg-white p-3 shadow-sm placeholder-glow" style="min-height: 120px;">
                        <div class="placeholder col-6 mb-2"></div>
                        <div class="placeholder col-4 mb-3"></div>
                        <div class="placeholder col-12"></div>
                    </div>
                </div>
            }
        </div>
    }
    else if (summaries.Count == 0)
    {
        <div class="card border rounded-3 bg-white p-3 text-center text-muted shadow-sm">
            <i class="bi bi-info-circle fs-4 d-block mb-1 text-primary opacity-75"></i>
            <span class="small fw-medium">No leave entitlement records configured.</span>
        </div>
    }
    else
    {
        <div class="row g-3 row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4">
            @foreach (var (s, idx) in summaries.Select((item, i) => (item, i)))
            {
                var isExceeded = s.IsExceeded;
                var color = isExceeded ? "danger" : GetColor(idx);
                var isSelected = SelectedLeaveTypeId == s.LeaveTypeId;

                <div class="col">
                    <div class="card leave-balance-card p-3 @(isSelected ? "is-selected" : "") @(isExceeded ? "is-exceeded" : "")"
                         role="button"
                         tabindex="0"
                         title="Click to @(isSelected ? "clear filter" : "filter requests by " + s.LeaveTypeName)"
                         @onclick="() => ToggleSelectLeaveType(s.LeaveTypeId)">
                        
                        <!-- Top Line: Icon + Title + Status Pill -->
                        <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
                            <div class="d-flex align-items-center gap-2.5 min-w-0">
                                <span class="leave-icon-badge bg-@color-subtle text-@color">
                                    <i class="bi @GetIcon(s.LeaveTypeName)"></i>
                                </span>
                                <div class="text-truncate">
                                    <div class="leave-type-name text-truncate" title="@s.LeaveTypeName">
                                        @s.LeaveTypeName
                                    </div>
                                    <div class="leave-quota-subtext text-muted">
                                        @s.TotalDays d annual quota
                                    </div>
                                </div>
                            </div>

                            @if (isExceeded)
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2 py-1 flex-shrink-0" style="font-size: 0.68rem; font-weight: 600;">
                                    <i class="bi bi-exclamation-triangle-fill me-1"></i>Over Quota
                                </span>
                            }
                            else if (isSelected)
                            {
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2 py-1 flex-shrink-0" style="font-size: 0.68rem; font-weight: 600;">
                                    <i class="bi bi-funnel-fill me-1"></i>Filtered
                                </span>
                            }
                        </div>

                        <!-- Middle: Big Metric -->
                        <div class="d-flex align-items-baseline justify-content-between my-2">
                            <div class="d-flex align-items-baseline gap-1.5">
                                <span class="leave-metric-value @(isExceeded ? "text-danger" : $"text-{color}")">
                                    @(isExceeded ? "0" : s.RemainingDays.ToString())
                                </span>
                                <span class="leave-metric-label text-muted">
                                    days available
                                </span>
                            </div>

                            @if (isExceeded)
                            {
                                <span class="text-danger small fw-semibold" title="@s.ExceededDays days exceeded">
                                    +@s.ExceededDays d over
                                </span>
                            }
                            else
                            {
                                <span class="text-muted small">
                                    @s.UsedDays d used
                                </span>
                            }
                        </div>

                        <!-- Bottom: Progress Bar + Subtext -->
                        <div class="leave-progress-wrap mt-1">
                            <div class="progress leave-progress-track">
                                <div class="progress-bar @GetProgressClass(s, color)"
                                     role="progressbar"
                                     style="width: @GetClampedPercent(s)%;">
                                </div>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-1 text-muted" style="font-size: 0.72rem;">
                                <span>@s.UsedDays of @s.TotalDays days used</span>
                                <span class="fw-semibold @(isExceeded ? "text-danger" : "")">
                                    @(isExceeded ? $"{GetPercent(s)}% (exceeded)" : $"{GetPercent(s)}%")
                                </span>
                            </div>
                        </div>

                    </div>
                </div>
            }
        </div>
    }
</div>

@code {

    [Parameter] public int? SelectedLeaveTypeId { get; set; }
    [Parameter] public EventCallback<int?> OnLeaveTypeSelected { get; set; }

    private List<LeaveBalanceViewModel> summaries = new();
    private List<LeaveTypeViewModel> leaveTypes = new();
    private List<LeaveRequestViewModel> employeeRequests = new();
    private bool isLoading = true;

    private async Task ToggleSelectLeaveType(int leaveTypeId)
    {
        if (SelectedLeaveTypeId == leaveTypeId)
        {
            SelectedLeaveTypeId = null;
        }
        else
        {
            SelectedLeaveTypeId = leaveTypeId;
        }

        await OnLeaveTypeSelected.InvokeAsync(SelectedLeaveTypeId);
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await LoadDataAsync();
    }

    public async Task RefreshAsync()
    {
        await LoadDataAsync();
        StateHasChanged();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;

        try
        {
            var employeeId = GetEmployeeId();
            var typeResult = await LeaveService.GetLeaveTypesAsync();
            leaveTypes = typeResult?.IsSuccess == true && typeResult.Data != null
                ? typeResult.Data.Where(x => x.IsActive).ToList()
                : new();

            var reqResult = await LeaveService.GetLeaveRequestsByEmployeeAsync(employeeId);
            employeeRequests = reqResult?.IsSuccess == true && reqResult.Data != null
                ? reqResult.Data
                : new();

            summaries = BuildBalanceSummaries();
        }
        catch
        {
            summaries = new();
        }
        finally
        {
            isLoading = false;
        }
    }

    private List<LeaveBalanceViewModel> BuildBalanceSummaries()
    {
        if (leaveTypes == null || !leaveTypes.Any())
            return new();

        var (start, end) = GetFinancialYear();

        var approvedRequests = employeeRequests
            .Where(r =>
                r.StatusId == Status.Approved &&
                r.StartDate >= start &&
                r.StartDate <= end)
            .ToList();

        return leaveTypes
            .Where(lt => lt.IsActive)
            .Select(lt =>
            {
                var usedDays = approvedRequests
                    .Where(r => r.LeaveTypeId == lt.Id)
                    .Sum(r => r.LeaveDays);

                return new LeaveBalanceViewModel
                {
                    LeaveTypeId = lt.Id,
                    LeaveTypeName = FormatEnum(lt.LeaveNameId.ToString()),
                    TotalDays = lt.MaxPerYear,
                    UsedDays = usedDays
                };
            })
            .ToList();
    }

    private int GetPercent(LeaveBalanceViewModel s) =>
        s.TotalDays == 0 ? 0 : (int)Math.Round((s.UsedDays * 100.0) / s.TotalDays);

    private int GetClampedPercent(LeaveBalanceViewModel s) =>
        Math.Min(100, Math.Max(0, GetPercent(s)));

    private static string GetColor(int idx) => (idx % 5) switch
    {
        0 => "primary",
        1 => "success",
        2 => "warning",
        3 => "purple",
        4 => "info",
        _ => "secondary"
    };

    private static string GetIcon(string name)
    {
        var n = (name ?? "").ToLowerInvariant();
        if (n.Contains("sick") || n.Contains("medical")) return "bi-heart-pulse-fill";
        if (n.Contains("maternity") || n.Contains("paternity")) return "bi-person-heart";
        if (n.Contains("casual")) return "bi-cup-hot-fill";
        if (n.Contains("unpaid")) return "bi-clock-history";
        if (n.Contains("earned") || n.Contains("annual")) return "bi-award-fill";
        return "bi-calendar2-check-fill";
    }

    private string GetProgressClass(LeaveBalanceViewModel s, string color) =>
        s.IsExceeded ? "bg-danger" :
        GetPercent(s) switch
        {
            >= 100 => "bg-danger",
            >= 80 => "bg-warning",
            _ => $"bg-{color}"
        };

    private static string FormatEnum(string name) =>
        System.Text.RegularExpressions.Regex.Replace(
            name ?? "", "([a-z])([A-Z])", "$1 $2");

    private (DateTime start, DateTime end) GetFinancialYear()
    {
        var today = DateTime.Today;
        int year = today.Month >= 4 ? today.Year : today.Year - 1;
        var start = new DateTime(year, 4, 1);
        var end = new DateTime(year + 1, 3, 31);
        return (start, end);
    }
}
