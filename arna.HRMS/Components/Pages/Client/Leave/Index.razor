@page "/emp-leave-management"
@page "/emp-leave-requests"
@page "/emp-festival-holidays"

@using arna.HRMS.Components.Loader
@using arna.HRMS.Components.Pages.Admin.LeaveManagement
@using arna.HRMS.Components.lib.components.ui.Model
@using arna.HRMS.Models.ViewModels.Leave
@using arna.HRMS.Models.Dropdown
@using arna.HRMS.Models.Enums
@using arna.HRMS.Services
@using arna.HRMS.Services.Auth
@using arna.HRMS.Services.Common

@inject ILeaveService LeaveService
@inject NotificationService NotificationService
@inject IJSRuntime JsRuntime
@inject NavigationManager NavigationManager
@inherits AuthenticatedLayoutBase
@implements IDisposable

<Loader Visible="isLoading" Message="@loadingMessage" />

@if (!isLoading)
{
    <div class="container-fluid p-0 leave-fade-in">

        <!-- ══════════ HEADER ══════════ -->
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div class="d-flex align-items-center gap-2">
                <span class="dash-header-icon bg-primary bg-opacity-10 text-primary rounded-2
                             p-2 d-inline-flex align-items-center justify-content-center">
                    <i class="bi @(activeTab == Tab.Leaves ? "bi-bookmark-check-fill" : "bi-calendar-heart-fill") fs-5"></i>
                </span>
                <div>
                    <h5 class="fw-bold mb-0">@(activeTab == Tab.Leaves ? "Leave Requests" : "Festival Holidays")</h5>
                    <p class="text-muted mb-0 small d-none d-sm-block">
                        @(activeTab == Tab.Leaves ? "View and manage your leave requests and balances" : "View organizational holidays and upcoming festival calendar")
                    </p>
                </div>
            </div>

            @if (activeTab == Tab.Leaves)
            {
                <button class="btn btn-primary btn-sm rounded-pill px-3 py-1.5 shadow-sm d-inline-flex align-items-center gap-1.5 fw-medium"
                        @onclick="() => leaveTab?.OpenApplyModal()">
                    <i class="bi bi-plus-lg"></i>
                    <span>Apply Leave</span>
                </button>
            }
        </div>

        <!-- ══════════ CONTENT ══════════ -->
        <div class="tab-content">

            @if (activeTab == Tab.Leaves)
            {
                <EmployeeLeaveTypes @ref="leaveTab" OnRequestCountChanged="c => { leaveRequestCount = c; StateHasChanged(); }" />
            }

            @if (activeTab == Tab.FestivalsHoliday)
            {
                <EmployeeFestivalHolidayTab @ref="festivalHoliday"
                                            OnCountChanged="c => { festivalCount = c; StateHasChanged(); }" />
            } 

        </div>
    </div>
}

@code {

    private bool isLoading = true;
    private enum Tab { Leaves, FestivalsHoliday }
    private Tab activeTab = Tab.Leaves;
    private int leaveRequestCount;
    private int festivalCount;

    private string loadingMessage = "Loading leave management... ";
    private EmployeeLeaveTypes? leaveTab;
    private EmployeeFestivalHolidayTab? festivalHoliday;
    
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        NavigationManager.LocationChanged += HandleLocationChanged;
        SyncTabFromUri(NavigationManager.Uri);
        isLoading = false;
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        SyncTabFromUri(e.Location);
        InvokeAsync(StateHasChanged);
    }

    private void SyncTabFromUri(string uri)
    {
        if (uri.Contains("/emp-festival-holidays", StringComparison.OrdinalIgnoreCase))
        {
            activeTab = Tab.FestivalsHoliday;
        }
        else
        {
            activeTab = Tab.Leaves;
        }
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= HandleLocationChanged;
    }
}
