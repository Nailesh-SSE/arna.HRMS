@using arna.HRMS.Components.lib.components.ui.CommonComponent
@using arna.HRMS.Components.lib.components.ui.Forms
@using arna.HRMS.Models.Common.Table
@using arna.HRMS.Models.ViewModels.Leave
@using arna.HRMS.Models.Enums
@using arna.HRMS.Services
@using arna.HRMS.Services.Auth
@using arna.HRMS.Services.Common

@inject ILeaveService LeaveService
@inject NotificationService NotificationService
@inject IJSRuntime JsRuntime
@inherits AuthenticatedLayoutBase

<!-- ══════════ REQUESTS CARD ══════════ -->
<div class="card border shadow-sm rounded-3 bg-white">
    <div class="card-body p-2 p-md-3">

        <!-- Toolbar / Filters -->
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 pb-2 mb-2 border-bottom">
            <div class="d-flex align-items-center flex-wrap gap-2">
                <div class="d-flex align-items-center gap-1.5 me-1 text-muted small fw-medium">
                    <i class="bi bi-funnel text-primary"></i>
                    <span>Filter:</span>
                </div>

                <div style="min-width: 170px;">
                    <SearchStatus SelectedValue="statusFilter"
                                  OnChanged="OnStatusChanged" />
                </div>

                @if (SelectedLeaveTypeId != null)
                {
                    var selectedTypeName = allRequests.FirstOrDefault(r => r.LeaveTypeId == SelectedLeaveTypeId)?.LeaveTypeName ?? "Selected Type";
                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 rounded-pill px-2.5 py-1 d-inline-flex align-items-center gap-1.5" style="font-size: 0.78rem;">
                        <i class="bi bi-tag-fill" style="font-size: 0.7rem;"></i>
                        <span>@selectedTypeName</span>
                        <button type="button" class="btn btn-sm p-0 ms-1 text-primary border-0" style="line-height: 1;" @onclick="ClearLeaveTypeFilter">
                            <i class="bi bi-x-circle-fill"></i>
                        </button>
                    </span>
                }

                @if (statusFilter != null)
                {
                    <button class="btn btn-sm btn-outline-secondary rounded-pill px-2.5 py-1"
                            style="font-size: 0.78rem;"
                            @onclick="ClearFilters">
                        <i class="bi bi-x-lg me-1"></i> Clear
                    </button>
                }
            </div>

            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-light text-secondary border rounded-pill px-2.5 py-1.5 small fw-medium">
                    Total: @FilteredRequests.Count request(s)
                </span>
            </div>
        </div>

        <!-- Table Content with Sticky Header and Internal Scroll -->
        <div>
            @if (FilteredRequests.Count == 0)
            {
                <div class="text-center text-muted py-5">
                    <i class="bi bi-calendar-x fs-1 opacity-50 d-block mb-2"></i>
                    <span class="fw-medium">No leave requests found</span>
                </div>
            }
            else
            {
                var hasPending = FilteredRequests.Any(r => r.StatusId == Status.Pending);

                <AppTable TItem="LeaveRequestViewModel"
                          Items="FilteredRequests"
                          Columns="TableSchemas.LeaveRequestColumns"
                          ShowActions="hasPending"
                          EnablePagination="true"
                          PageSize="10">

                    <ActionTemplate Context="req">
                        @if (req.StatusId == Status.Pending)
                        {
                            <div class="d-flex align-items-center justify-content-center gap-1">
                                <button type="button"
                                        class="btn btn-sm btn-outline-primary rounded-circle p-1 d-inline-flex align-items-center justify-content-center"
                                        style="width: 28px; height: 28px;"
                                        title="Edit Request"
                                        @onclick="() => OnEditClicked.InvokeAsync(req)">
                                    <i class="bi bi-pencil-square" style="font-size: 0.8rem;"></i>
                                </button>

                                <button type="button"
                                        class="btn btn-sm btn-outline-danger rounded-circle p-1 d-inline-flex align-items-center justify-content-center"
                                        style="width: 28px; height: 28px;"
                                        title="Cancel Request"
                                        @onclick="() => CancelRequest(req)">
                                    <i class="bi bi-x-lg" style="font-size: 0.8rem;"></i>
                                </button>
                            </div>
                        }
                        else
                        {
                            <span class="text-muted opacity-50">—</span>
                        }
                    </ActionTemplate>

                </AppTable>
            }
        </div>

    </div>
</div>

@code {

    [Parameter] public EventCallback OnApplyClicked { get; set; }
    [Parameter] public EventCallback<LeaveRequestViewModel> OnEditClicked { get; set; }
    [Parameter] public EventCallback OnRequestChanged { get; set; }
    [Parameter] public EventCallback<int> OnCountChanged { get; set; }
    [Parameter] public int? SelectedLeaveTypeId { get; set; }
    [Parameter] public EventCallback OnLeaveTypeCleared { get; set; }

    private List<LeaveRequestViewModel> allRequests = new();
    private Status? statusFilter;
    private bool _loaded = false;

    private List<LeaveRequestViewModel> FilteredRequests =>
        allRequests
            .Where(r => (statusFilter == null || r.StatusId == statusFilter) &&
                        (SelectedLeaveTypeId == null || r.LeaveTypeId == SelectedLeaveTypeId))
            .OrderByDescending(r => r.StartDate)
            .ToList();

    private async Task ClearLeaveTypeFilter()
    {
        SelectedLeaveTypeId = null;
        await OnLeaveTypeCleared.InvokeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnInitializedAsync();
        if (firstRender && !_loaded)
        {
            _loaded = true;
            await LoadRequestsAsync();
            StateHasChanged();
        }
    }

    private Task OnStatusChanged(Status? status)
    {
        statusFilter = status;
        return Task.CompletedTask;
    }

    public async Task RefreshAsync()
    {
        await LoadRequestsAsync();
        StateHasChanged();
    }

    private async Task LoadRequestsAsync()
    {
        var employeeId = GetEmployeeId();
        var result = await LeaveService.GetLeaveRequestsByEmployeeAsync(employeeId);

        allRequests = result?.IsSuccess == true && result.Data != null
            ? result.Data
            : new();

        await OnCountChanged.InvokeAsync(allRequests.Count);
    }

    private async Task CancelRequest(LeaveRequestViewModel req)
    {
        var confirm = await JsRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to cancel this leave request?");
        if (!confirm) return;

        var employeeId = GetEmployeeId();
        if (employeeId <= 0)
        {
            await NotificationService.Error("Unable to retrieve your employee ID. Please log in again.");
            return;
        }

        var result = await LeaveService.CancelLeaveRequestAsync(req.Id, employeeId);
        if (result?.IsSuccess != true)
        {
            await NotificationService.Error(result?.Message ?? "Failed to cancel leave.");
            return;
        }
        await RefreshAsync();
        await OnRequestChanged.InvokeAsync();
        await NotificationService.Success("Leave request cancelled successfully.");
    }

    private void ClearFilters()
    {
        statusFilter = null;
    }
}