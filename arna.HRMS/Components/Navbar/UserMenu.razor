@using Microsoft.AspNetCore.Components.Authorization
@using arna.HRMS.Services.Auth

@inject IAuthService AuthService
@inherits AuthenticatedLayoutBase

<AuthorizeView>
    <Authorized>
        <div class="dropdown">

            <!-- ══════════ TRIGGER BUTTON ══════════ -->
            <button class="btn usermenu-btn rounded-pill d-flex align-items-center gap-2"
                    data-bs-toggle="dropdown"
                    aria-expanded="false"
                    aria-label="User menu">

                <!-- Avatar + Online Indicator -->
                <div class="position-relative d-inline-flex flex-shrink-0">
                    <span class="usermenu-avatar rounded-circle text-white fw-bold d-flex align-items-center justify-content-center flex-shrink-0">
                        @GetInitials()
                    </span>
                    <span class="position-absolute usermenu-online-dot bg-success rounded-circle border border-2 border-white"></span>
                </div>

                <!-- Name + Role (md+) -->
                <div class="d-none d-md-flex flex-column lh-1 text-start me-1">
                    <span class="fw-semibold small text-truncate usermenu-name-width">
                        @GetDisplayName()
                    </span>
                    <span class="text-muted usermenu-role-text">
                        @GetRoleName()
                    </span>
                </div>

                <i class="bi bi-chevron-down d-none d-md-inline usermenu-chevron"></i>
            </button>

            <!-- ══════════ DROPDOWN MENU ══════════ -->
            <div class="dropdown-menu dropdown-menu-end usermenu-dropdown shadow-lg border-0 p-0 overflow-hidden">

                <!-- Profile Header -->
                <div class="usermenu-profile-header p-3">
                    <div class="d-flex align-items-center gap-3">

                        <!-- Large Avatar -->
                        <div class="position-relative flex-shrink-0">
                            <span class="usermenu-avatar-lg rounded-circle text-white fw-bold d-flex align-items-center justify-content-center shadow-sm">
                                @GetInitials()
                            </span>
                            <span class="position-absolute usermenu-online-dot-lg bg-success rounded-circle border border-2 border-white"></span>
                        </div>

                        <div class="overflow-hidden flex-grow-1">
                            <h6 class="fw-bold mb-0 text-truncate usermenu-fullname text-dark">
                                @GetDisplayName()
                            </h6>
                            @if (!string.IsNullOrWhiteSpace(GetUserName()) && !string.Equals(GetUserName(), GetDisplayName(), StringComparison.OrdinalIgnoreCase))
                            {
                                <div class="text-muted small text-truncate usermenu-email" title="@GetUserName()">
                                    @GetUserName()
                                </div>
                            }
                            <div class="mt-1 d-flex align-items-center gap-1 flex-wrap">
                                <span class="badge usermenu-role-badge">
                                    <i class="bi bi-shield-check me-1"></i>@GetRoleName()
                                </span>
                                @if (GetEmployeeId() > 0)
                                {
                                    <span class="badge usermenu-empid-badge">
                                        EMP-@GetEmployeeId()
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Menu Items -->
                <div class="p-2">
                    <button class="dropdown-item usermenu-item d-flex align-items-center gap-3 py-2 px-3 rounded-3"
                            @onclick="@(() => Navigation.NavigateTo("/change-password"))">
                        <div class="usermenu-icon-box bg-warning-subtle text-warning d-flex align-items-center justify-content-center flex-shrink-0 rounded-3">
                            <i class="bi bi-shield-lock-fill"></i>
                        </div>
                        <div class="flex-grow-1 lh-sm">
                            <div class="fw-semibold usermenu-item-title text-dark">Change Password</div>
                            <div class="text-muted usermenu-item-sub">Update security credentials</div>
                        </div>
                        <i class="bi bi-chevron-right text-muted opacity-50 usermenu-arrow"></i>
                    </button>

                    <div class="my-1 border-top border-light-subtle"></div>

                    <!-- Logout -->
                    <button class="dropdown-item usermenu-item usermenu-item-danger d-flex align-items-center gap-3 py-2 px-3 rounded-3"
                            @onclick="HandleLogout"
                            disabled="@isLoggingOut">
                        <div class="usermenu-icon-box bg-danger-subtle text-danger d-flex align-items-center justify-content-center flex-shrink-0 rounded-3">
                            <i class="bi @(isLoggingOut ? "bi-hourglass-split" : "bi-box-arrow-right")"></i>
                        </div>
                        <div class="flex-grow-1 lh-sm">
                            <div class="fw-semibold usermenu-item-title text-danger">
                                @(isLoggingOut ? "Signing out..." : "Sign Out")
                            </div>
                            <div class="text-muted usermenu-item-sub">End your active session</div>
                        </div>
                        <i class="bi bi-chevron-right text-muted opacity-50 usermenu-arrow"></i>
                    </button>
                </div>
            </div>
        </div>
    </Authorized>

    <NotAuthorized>
        <button class="btn btn-primary btn-sm rounded-pill px-3 d-flex align-items-center gap-2 shadow-sm"
                @onclick="@(() => Navigation.NavigateTo("/login"))">
            <i class="bi bi-box-arrow-in-right me-1"></i>
            <span class="d-none d-sm-inline">Sign In</span>
        </button>
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool isLoggingOut = false;

    private async Task HandleLogout()
    {
        try
        {
            isLoggingOut = true;
            Logger.LogInformation("User initiated logout");
            
            // Call AuthService which gets userId internally
            int userId = GetUserId();
            await AuthService.LogoutAsync(userId);
            
            Logger.LogInformation("Logout completed, redirecting to login");
            Navigation.NavigateTo("/login", true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Logout error in UserMenu");
            Navigation.NavigateTo("/login", true);
        }
        finally
        {
            isLoggingOut = false;
        }
    }

    private string GetDisplayName()
    {
        var fullName = GetUserFullName();
        return !string.IsNullOrWhiteSpace(fullName) ? fullName : GetUserName();
    }

    private string GetInitials()
    {
        var name = GetDisplayName();
        if (string.IsNullOrWhiteSpace(name)) return "U";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{parts[0][0]}{parts[^1][0]}".ToUpper()
            : parts[0][0].ToString().ToUpper();
    }

    private string GetRoleName()
    {
        var role = GetUserRole();
        return string.IsNullOrWhiteSpace(role) ? "User" : role;
    }
}