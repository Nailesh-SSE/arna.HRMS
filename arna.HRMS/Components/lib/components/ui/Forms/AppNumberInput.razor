@typeparam TValue
@using System.Linq.Expressions
@using Microsoft.AspNetCore.Components.Forms
@using System.Globalization
@implements IDisposable

<div class="app-number-wrapper @WrapperClass">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label class="form-label">
            @Label
            @if (IsRequired)
            {
                <span class="text-danger">*</span>
            }
        </label>
    }

    <div class="input-group">
        @if (!string.IsNullOrWhiteSpace(Icon))
        {
            <span class="input-group-text @(IsInvalid ? "border-danger text-danger" : "")">
                <i class="bi @Icon"></i>
            </span>
        }
        <input type="number"
               class="form-control @(IsInvalid ? "is-invalid" : "")"
               value="@FormattedValue"
               placeholder="@Placeholder"
               step="@Step"
               min="@Min"
               max="@Max"
               readonly="@ReadOnly"
               disabled="@Disabled"
               @onchange="OnChange"
               @oninput="OnInput"
               @onblur="HandleBlur"
               @attributes="AdditionalAttributes" />
    </div>

    @if (!string.IsNullOrWhiteSpace(HelpText))
    {
        <small class="text-muted d-block mt-1">@HelpText</small>
    }

    @if (IsInvalid && !string.IsNullOrEmpty(FirstErrorMessage))
    {
        <div class="text-danger small mt-1">
            @FirstErrorMessage
        </div>
    }
</div>

@code {
    [CascadingParameter] private EditContext? EditContext { get; set; }

    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string Icon { get; set; } = string.Empty;
    [Parameter] public bool IsRequired { get; set; }
    [Parameter] public string Placeholder { get; set; } = string.Empty;
    [Parameter] public string Step { get; set; } = "any";
    [Parameter] public string? Min { get; set; }
    [Parameter] public string? Max { get; set; }
    [Parameter] public string WrapperClass { get; set; } = string.Empty;
    [Parameter] public string? HelpText { get; set; }

    [Parameter] public TValue? Value { get; set; }
    [Parameter] public EventCallback<TValue> ValueChanged { get; set; }
    [Parameter] public Expression<Func<TValue>>? ValidationExpression { get; set; }

    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<FocusEventArgs> OnBlur { get; set; }
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private FieldIdentifier _fieldIdentifier;
    private bool _isTouched;
    private EditContext? _previousEditContext;

    private bool HasError => EditContext != null && ValidationExpression != null && EditContext.GetValidationMessages(_fieldIdentifier).Any();

    private bool IsInvalid => HasError && (_isTouched || (EditContext != null && EditContext.IsModified(_fieldIdentifier)));

    private string? FirstErrorMessage => EditContext?.GetValidationMessages(_fieldIdentifier).FirstOrDefault();

    private string? FormattedValue => Value switch
    {
        null => null,
        decimal d => d.ToString("0.##", CultureInfo.InvariantCulture),
        double db => db.ToString("0.##", CultureInfo.InvariantCulture),
        float f => f.ToString("0.##", CultureInfo.InvariantCulture),
        _ => Value.ToString()
    };

    protected override void OnParametersSet()
    {
        if (EditContext != null && ValidationExpression != null)
        {
            _fieldIdentifier = FieldIdentifier.Create(ValidationExpression);
            if (EditContext != _previousEditContext)
            {
                if (_previousEditContext != null)
                {
                    _previousEditContext.OnValidationRequested -= HandleValidationRequested;
                }
                _previousEditContext = EditContext;
                _previousEditContext.OnValidationRequested += HandleValidationRequested;
            }
        }
    }

    private void HandleValidationRequested(object? sender, ValidationRequestedEventArgs e)
    {
        _isTouched = true;
        StateHasChanged();
    }

    private async Task OnInput(ChangeEventArgs e)
    {
        if (ReadOnly || Disabled) return;

        if (BindConverter.TryConvertTo<TValue>(e.Value, CultureInfo.InvariantCulture, out var result))
        {
            await ValueChanged.InvokeAsync(result);
            if (_isTouched || HasError)
            {
                NotifyFieldChanged();
            }
        }
    }

    private async Task OnChange(ChangeEventArgs e)
    {
        if (ReadOnly || Disabled) return;

        if (BindConverter.TryConvertTo<TValue>(e.Value, CultureInfo.InvariantCulture, out var result))
        {
            await ValueChanged.InvokeAsync(result);
            NotifyFieldChanged();
        }
    }

    private async Task HandleBlur(FocusEventArgs e)
    {
        _isTouched = true;
        NotifyFieldChanged();
        if (OnBlur.HasDelegate)
            await OnBlur.InvokeAsync(e);
    }

    private void NotifyFieldChanged()
    {
        if (ValidationExpression != null && EditContext != null)
            EditContext.NotifyFieldChanged(_fieldIdentifier);
    }

    public void Dispose()
    {
        if (_previousEditContext != null)
        {
            _previousEditContext.OnValidationRequested -= HandleValidationRequested;
        }
    }
}
