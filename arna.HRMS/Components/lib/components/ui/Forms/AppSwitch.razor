<div class="erp-switch-card-wrapper @WrapperClass">
    <div class="d-flex align-items-center gap-3">
        <div class="form-check form-switch erp-form-switch mb-0">
            <input class="form-check-input"
                   type="checkbox"
                   role="switch"
                   id="@ResolvedId"
                   checked="@Value"
                   disabled="@Disabled"
                   @onchange="OnChange" />
        </div>
        <div>
            @if (!string.IsNullOrWhiteSpace(Label))
            {
                <label class="form-check-label fw-bold text-dark mb-0 d-block"
                       for="@ResolvedId"
                       style="cursor: pointer; font-size: 0.875rem;">
                    @Label
                </label>
            }
            @if (!string.IsNullOrWhiteSpace(HelpText))
            {
                <span class="text-muted" style="font-size: 0.75rem;">@HelpText</span>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? HelpText { get; set; }
    [Parameter] public bool Value { get; set; } = true;
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string WrapperClass { get; set; } = string.Empty;
    [Parameter] public string? Id { get; set; }

    private string ResolvedId => string.IsNullOrWhiteSpace(Id) ? _generatedId : Id;
    private readonly string _generatedId = $"switch_{Guid.NewGuid():N}";

    private async Task OnChange(ChangeEventArgs e)
    {
        if (e.Value is bool checkedValue)
        {
            Value = checkedValue;
            await ValueChanged.InvokeAsync(checkedValue);
        }
    }
}
