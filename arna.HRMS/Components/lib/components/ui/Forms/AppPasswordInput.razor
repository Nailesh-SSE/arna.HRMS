@using Microsoft.AspNetCore.Components.Forms
@using System.Linq.Expressions

<div class="app-password-wrapper @WrapperClass">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label class="form-label">
            @Label
            @if (IsRequired)
            {
                <span class="text-danger">*</span>
            }
        </label>
    }

    <div class="input-group">
        @if (!string.IsNullOrWhiteSpace(Icon))
        {
            <span class="input-group-text">
                <i class="bi @Icon"></i>
            </span>
        }
        <input class="form-control @(IsInvalid ? "is-invalid" : "")"
               type="@InputType"
               value="@Value"
               placeholder="@Placeholder"
               @oninput="OnInput"
               autocomplete="@Autocomplete" />

        @if (ShowVisibilityToggle)
        {
            <button type="button"
                    class="btn btn-password-toggle"
                    @onclick="ToggleVisibility"
                    tabindex="-1">
                <i class="bi @(ShowPassword ? "bi-eye-slash" : "bi-eye")"></i>
            </button>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(HelpText))
    {
        <small class="text-muted d-block mt-1">@HelpText</small>
    }

    @if (ValidationExpression != null)
    {
        <div class="text-danger small mt-1">
            <ValidationMessage For="ValidationExpression" />
        </div>
    }
</div>

@code {
    [CascadingParameter] private EditContext? EditContext { get; set; }

    [Parameter] public string? Label { get; set; }
    [Parameter] public string Icon { get; set; } = "bi-key";
    [Parameter] public bool IsRequired { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Enter password...";
    [Parameter] public string Autocomplete { get; set; } = "new-password";
    [Parameter] public bool ShowVisibilityToggle { get; set; } = true;
    [Parameter] public string WrapperClass { get; set; } = string.Empty;
    [Parameter] public string? HelpText { get; set; }

    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public Expression<Func<object>>? ValidationExpression { get; set; }

    private bool ShowPassword;
    private FieldIdentifier _fieldIdentifier;

    private string InputType => ShowPassword ? "text" : "password";

    private bool IsInvalid =>
        EditContext != null &&
        ValidationExpression != null &&
        EditContext.IsModified(_fieldIdentifier) &&
        EditContext.GetValidationMessages(_fieldIdentifier).Any();

    protected override void OnParametersSet()
    {
        if (EditContext != null && ValidationExpression != null)
        {
            _fieldIdentifier = FieldIdentifier.Create(ValidationExpression);
        }
    }

    private async Task OnInput(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        await ValueChanged.InvokeAsync(val);

        if (EditContext != null && ValidationExpression != null)
        {
            EditContext.NotifyFieldChanged(_fieldIdentifier);
        }
    }

    private void ToggleVisibility()
    {
        ShowPassword = !ShowPassword;
    }
}
