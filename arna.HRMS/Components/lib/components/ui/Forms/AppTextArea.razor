@using System.Linq.Expressions
@using Microsoft.AspNetCore.Components.Forms

<div class="app-textarea-wrapper @WrapperClass">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label class="form-label">
            @Label
            @if (IsRequired)
            {
                <span class="text-danger">*</span>
            }
        </label>
    }

    @if (!string.IsNullOrWhiteSpace(Icon))
    {
        <div class="input-group">
            <span class="input-group-text align-items-start pt-2">
                <i class="bi @Icon"></i>
            </span>
            <textarea class="form-control @(IsInvalid ? "is-invalid" : "")"
                      rows="@Rows"
                      value="@Value"
                      placeholder="@Placeholder"
                      readonly="@ReadOnly"
                      disabled="@Disabled"
                      @onchange="OnChange"
                      @oninput="OnInput"
                      @attributes="AdditionalAttributes">
            </textarea>
        </div>
    }
    else
    {
        <textarea class="form-control @(IsInvalid ? "is-invalid" : "")"
                  rows="@Rows"
                  value="@Value"
                  placeholder="@Placeholder"
                  readonly="@ReadOnly"
                  disabled="@Disabled"
                  @onchange="OnChange"
                  @oninput="OnInput"
                  @attributes="AdditionalAttributes">
        </textarea>
    }

    @if (!string.IsNullOrWhiteSpace(HelpText))
    {
        <small class="text-muted d-block mt-1">@HelpText</small>
    }

    @if (ValidationExpression != null)
    {
        <div class="text-danger small mt-1">
            <ValidationMessage For="ValidationExpression" />
        </div>
    }
</div>

@code {
    [CascadingParameter] private EditContext? EditContext { get; set; }

    [Parameter] public string? Label { get; set; }
    [Parameter] public string Icon { get; set; } = string.Empty;
    [Parameter] public bool IsRequired { get; set; }
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = string.Empty;
    [Parameter] public int Rows { get; set; } = 3;
    [Parameter] public string WrapperClass { get; set; } = string.Empty;
    [Parameter] public string? HelpText { get; set; }

    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public Expression<Func<object>>? ValidationExpression { get; set; }
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private FieldIdentifier _fieldIdentifier;

    private bool IsInvalid =>
        EditContext != null &&
        ValidationExpression != null &&
        EditContext.IsModified(_fieldIdentifier) &&
        EditContext.GetValidationMessages(_fieldIdentifier).Any();

    protected override void OnParametersSet()
    {
        if (EditContext != null && ValidationExpression != null)
        {
            _fieldIdentifier = FieldIdentifier.Create(ValidationExpression);
        }
    }

    private async Task OnChange(ChangeEventArgs e)
    {
        if (ReadOnly || Disabled) return;

        await ValueChanged.InvokeAsync(e.Value?.ToString());

        if (ValidationExpression != null)
            EditContext?.NotifyFieldChanged(_fieldIdentifier);
    }

    private async Task OnInput(ChangeEventArgs e)
    {
        if (ReadOnly || Disabled) return;

        await ValueChanged.InvokeAsync(e.Value?.ToString());
    }
}
