@using System.Linq.Expressions
@using Microsoft.AspNetCore.Components.Forms

@if (ShowWrapper)
{
    <div class="app-input-wrapper @WrapperClass">
        @if (!string.IsNullOrWhiteSpace(Label))
        {
            <label class="form-label @LabelClass">
                @Label
                @if (IsRequired)
                {
                    <span class="text-danger">*</span>
                }
            </label>
        }

        @if (!string.IsNullOrWhiteSpace(Icon))
        {
            <div class="input-group">
                <span class="input-group-text">
                    <i class="bi @Icon"></i>
                </span>
                <input type="@Type"
                       class="@InputCssClass"
                       value="@Value"
                       placeholder="@Placeholder"
                       readonly="@ReadOnly"
                       disabled="@Disabled"
                       @onchange="OnChange"
                       @oninput="OnInput"
                       @onfocus="OnFocus"
                       @onblur="OnBlur"
                       @attributes="AdditionalAttributes" />
            </div>
        }
        else
        {
            <input type="@Type"
                   class="@InputCssClass"
                   value="@Value"
                   placeholder="@Placeholder"
                   readonly="@ReadOnly"
                   disabled="@Disabled"
                   @onchange="OnChange"
                   @oninput="OnInput"
                   @onfocus="OnFocus"
                   @onblur="OnBlur"
                   @attributes="AdditionalAttributes" />
        }

        @if (!string.IsNullOrWhiteSpace(HelpText))
        {
            <small class="text-muted d-block mt-1">@HelpText</small>
        }

        @if (ValidationExpression != null && ShowValidation)
        {
            <div class="text-danger small mt-1">
                <ValidationMessage For="ValidationExpression" />
            </div>
        }

        @ChildContent
    </div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(Icon))
    {
        <div class="input-group">
            <span class="input-group-text">
                <i class="bi @Icon"></i>
            </span>
            <input type="@Type"
                   class="@InputCssClass"
                   value="@Value"
                   placeholder="@Placeholder"
                   readonly="@ReadOnly"
                   disabled="@Disabled"
                   @onchange="OnChange"
                   @oninput="OnInput"
                   @onfocus="OnFocus"
                   @onblur="OnBlur"
                   @attributes="AdditionalAttributes" />
        </div>
    }
    else
    {
        <input type="@Type"
               class="@InputCssClass"
               value="@Value"
               placeholder="@Placeholder"
               readonly="@ReadOnly"
               disabled="@Disabled"
               @onchange="OnChange"
               @oninput="OnInput"
               @onfocus="OnFocus"
               @onblur="OnBlur"
               @attributes="AdditionalAttributes" />
    }
}

@code {
    [CascadingParameter] private EditContext? EditContext { get; set; }

    // ── Label & Icon ──
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string LabelClass { get; set; } = string.Empty;
    [Parameter] public string Icon { get; set; } = string.Empty;
    [Parameter] public bool IsRequired { get; set; }

    // ── Input ──
    [Parameter] public string Type { get; set; } = "text";
    [Parameter] public string Placeholder { get; set; } = string.Empty;
    [Parameter] public string CssClass { get; set; } = string.Empty;
    [Parameter] public string Size { get; set; } = string.Empty;

    // ── Value Binding ──
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    // ── Validation ──
    [Parameter] public Expression<Func<object>>? ValidationExpression { get; set; }
    [Parameter] public bool ShowValidation { get; set; } = true;

    // ── Wrapper ──
    [Parameter] public bool ShowWrapper { get; set; } = true;
    [Parameter] public string WrapperClass { get; set; } = string.Empty;
    [Parameter] public string? HelpText { get; set; }

    // ── States ──
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool Disabled { get; set; }

    // ── Content & Events ──
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnFocus { get; set; }
    [Parameter] public EventCallback OnBlur { get; set; }

    // ── Unmatched ──
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private FieldIdentifier _fieldIdentifier;

    private string InputCssClass
    {
        get
        {
            var baseClass = "form-control";

            if (!string.IsNullOrWhiteSpace(Size))
                baseClass += $" form-control-{Size}";

            if (!string.IsNullOrWhiteSpace(CssClass))
                baseClass += $" {CssClass}";

            if (EditContext != null && ValidationExpression != null)
            {
                var isValid = !EditContext.GetValidationMessages(_fieldIdentifier).Any();
                var isModified = EditContext.IsModified(_fieldIdentifier);

                if (isModified && !isValid)
                    baseClass += " is-invalid";
            }

            return baseClass;
        }
    }

    protected override void OnParametersSet()
    {
        if (EditContext != null && ValidationExpression != null)
        {
            _fieldIdentifier = FieldIdentifier.Create(ValidationExpression);
        }
    }

    private async Task OnChange(ChangeEventArgs e)
    {
        if (ReadOnly || Disabled) return;

        await ValueChanged.InvokeAsync(e.Value?.ToString());
        NotifyFieldChanged();
    }

    private async Task OnInput(ChangeEventArgs e)
    {
        if (ReadOnly || Disabled) return;

        await ValueChanged.InvokeAsync(e.Value?.ToString());
    }

    private void NotifyFieldChanged()
    {
        if (ValidationExpression != null)
            EditContext?.NotifyFieldChanged(_fieldIdentifier);
    }
}