@using System.Linq.Expressions
@using Microsoft.AspNetCore.Components.Forms
@implements IDisposable

@if (ShowWrapper)
{
    <div class="app-input-wrapper @WrapperClass">
        @if (!string.IsNullOrWhiteSpace(Label))
        {
            <label class="form-label @LabelClass">
                @Label
                @if (IsRequired)
                {
                    <span class="text-danger">*</span>
                }
            </label>
        }

        @if (!string.IsNullOrWhiteSpace(Icon))
        {
            <div class="input-group">
                <span class="input-group-text @(IsInvalid ? "border-danger text-danger" : "")">
                    <i class="bi @Icon"></i>
                </span>
                <input type="@Type"
                       class="@InputCssClass"
                       value="@Value"
                       placeholder="@Placeholder"
                       readonly="@ReadOnly"
                       disabled="@Disabled"
                       @onchange="OnChange"
                       @oninput="OnInput"
                       @onfocus="OnFocus"
                       @onblur="HandleBlur"
                       @attributes="AdditionalAttributes" />
            </div>
        }
        else
        {
            <input type="@Type"
                   class="@InputCssClass"
                   value="@Value"
                   placeholder="@Placeholder"
                   readonly="@ReadOnly"
                   disabled="@Disabled"
                   @onchange="OnChange"
                   @oninput="OnInput"
                   @onfocus="OnFocus"
                   @onblur="HandleBlur"
                   @attributes="AdditionalAttributes" />
        }

        @if (!string.IsNullOrWhiteSpace(HelpText))
        {
            <small class="text-muted d-block mt-1">@HelpText</small>
        }

        @if (ShowValidation && IsInvalid && !string.IsNullOrEmpty(FirstErrorMessage))
        {
            <div class="text-danger small mt-1">
                @FirstErrorMessage
            </div>
        }

        @ChildContent
    </div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(Icon))
    {
        <div class="input-group">
            <span class="input-group-text @(IsInvalid ? "border-danger text-danger" : "")">
                <i class="bi @Icon"></i>
            </span>
            <input type="@Type"
                   class="@InputCssClass"
                   value="@Value"
                   placeholder="@Placeholder"
                   readonly="@ReadOnly"
                   disabled="@Disabled"
                   @onchange="OnChange"
                   @oninput="OnInput"
                   @onfocus="OnFocus"
                   @onblur="HandleBlur"
                   @attributes="AdditionalAttributes" />
        </div>
    }
    else
    {
        <input type="@Type"
               class="@InputCssClass"
               value="@Value"
               placeholder="@Placeholder"
               readonly="@ReadOnly"
               disabled="@Disabled"
               @onchange="OnChange"
               @oninput="OnInput"
               @onfocus="OnFocus"
               @onblur="HandleBlur"
               @attributes="AdditionalAttributes" />
    }
}

@code {
    [CascadingParameter] private EditContext? EditContext { get; set; }

    // ── Label & Icon ──
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string LabelClass { get; set; } = string.Empty;
    [Parameter] public string Icon { get; set; } = string.Empty;
    [Parameter] public bool IsRequired { get; set; }

    // ── Input ──
    [Parameter] public string Type { get; set; } = "text";
    [Parameter] public string Placeholder { get; set; } = string.Empty;
    [Parameter] public string CssClass { get; set; } = string.Empty;
    [Parameter] public string Size { get; set; } = string.Empty;

    // ── Value Binding ──
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public Expression<Func<string?>>? ValueExpression { get; set; }

    // ── Validation ──
    [Parameter] public Expression<Func<object>>? ValidationExpression { get; set; }
    [Parameter] public bool ShowValidation { get; set; } = true;

    // ── Wrapper ──
    [Parameter] public bool ShowWrapper { get; set; } = true;
    [Parameter] public string WrapperClass { get; set; } = string.Empty;
    [Parameter] public string? HelpText { get; set; }

    // ── States ──
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool Disabled { get; set; }

    // ── Content & Events ──
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnFocus { get; set; }
    [Parameter] public EventCallback<FocusEventArgs> OnBlur { get; set; }

    // ── Unmatched ──
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private FieldIdentifier _fieldIdentifier;
    private bool _isTouched;
    private EditContext? _previousEditContext;

    private bool HasFieldBinding => ValidationExpression != null || ValueExpression != null;

    private bool HasError => EditContext != null && HasFieldBinding && EditContext.GetValidationMessages(_fieldIdentifier).Any();

    private bool IsInvalid => HasError && (_isTouched || (EditContext != null && EditContext.IsModified(_fieldIdentifier)));

    private string? FirstErrorMessage => EditContext?.GetValidationMessages(_fieldIdentifier).FirstOrDefault();

    private string InputCssClass
    {
        get
        {
            var baseClass = "form-control";

            if (!string.IsNullOrWhiteSpace(Size))
                baseClass += $" form-control-{Size}";

            if (!string.IsNullOrWhiteSpace(CssClass))
                baseClass += $" {CssClass}";

            if (IsInvalid)
                baseClass += " is-invalid";

            return baseClass;
        }
    }

    protected override void OnParametersSet()
    {
        if (EditContext != null)
        {
            if (ValidationExpression != null)
            {
                _fieldIdentifier = FieldIdentifier.Create(ValidationExpression);
            }
            else if (ValueExpression != null)
            {
                _fieldIdentifier = FieldIdentifier.Create(ValueExpression);
            }

            if (HasFieldBinding && EditContext != _previousEditContext)
            {
                if (_previousEditContext != null)
                {
                    _previousEditContext.OnValidationRequested -= HandleValidationRequested;
                    _previousEditContext.OnValidationStateChanged -= HandleValidationStateChanged;
                }
                _previousEditContext = EditContext;
                _previousEditContext.OnValidationRequested += HandleValidationRequested;
                _previousEditContext.OnValidationStateChanged += HandleValidationStateChanged;
            }
        }
    }

    private void HandleValidationRequested(object? sender, ValidationRequestedEventArgs e)
    {
        _isTouched = true;
        StateHasChanged();
    }

    private void HandleValidationStateChanged(object? sender, ValidationStateChangedEventArgs e)
    {
        StateHasChanged();
    }

    private async Task OnChange(ChangeEventArgs e)
    {
        if (ReadOnly || Disabled) return;

        await ValueChanged.InvokeAsync(e.Value?.ToString());
        NotifyFieldChanged();
    }

    private async Task OnInput(ChangeEventArgs e)
    {
        if (ReadOnly || Disabled) return;

        var newVal = e.Value?.ToString();
        await ValueChanged.InvokeAsync(newVal);

        if (_isTouched || HasError)
        {
            NotifyFieldChanged();
        }
    }

    private async Task HandleBlur(FocusEventArgs e)
    {
        _isTouched = true;
        NotifyFieldChanged();
        if (OnBlur.HasDelegate)
            await OnBlur.InvokeAsync(e);
    }

    private void NotifyFieldChanged()
    {
        if (HasFieldBinding && EditContext != null)
            EditContext.NotifyFieldChanged(_fieldIdentifier);
    }

    public void Dispose()
    {
        if (_previousEditContext != null)
        {
            _previousEditContext.OnValidationRequested -= HandleValidationRequested;
            _previousEditContext.OnValidationStateChanged -= HandleValidationStateChanged;
        }
    }
}
